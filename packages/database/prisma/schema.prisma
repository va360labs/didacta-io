model ModCoursesModule {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  title       String
  description String?
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  course  ModCoursesCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons ModCoursesLesson[]

  @@unique([courseId, position])
  @@index([tenantId, courseId])
  @@map("mod_courses_module")
}

model ModCoursesLesson {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  moduleId        String     @map("module_id") @db.Uuid
  type            LessonType
  title           String
  position        Int
  /// Contenido por tipo: { videoUrl, html, pdfUrl, text, quizId } según LessonType
  content         Json       @default("{}")
  durationMinutes Int?       @map("duration_minutes")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  module ModCoursesModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position])
  @@index([tenantId, moduleId])
  @@map("mod_courses_lesson")
}

// ============================================================================
// mod.learning — Matriculación, progreso, finalización
// ============================================================================

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentSource {
  ADMIN
  CODE
  INVITATION_LINK
  PURCHASE
  IMPORT
}

model ModLearningEnrollment {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  /// ID lógico del curso (sin FK cross-module)
  courseId            String           @map("course_id") @db.Uuid
  status              EnrollmentStatus @default(ACTIVE)
  source              EnrollmentSource @default(ADMIN)
  completionThreshold Int              @default(75) @map("completion_threshold")
  /// Porcentaje de finalización (0-100)
  progressPercent     Int              @default(0) @map("progress_percent")
  enrolledAt          DateTime         @default(now()) @map("enrolled_at")
  startedAt           DateTime?        @map("started_at")
  completedAt         DateTime?        @map("completed_at")
  cancelledAt         DateTime?        @map("cancelled_at")

  progress ModLearningProgress[]

  @@unique([tenantId, userId, courseId])
  @@index([tenantId, courseId, status])
  @@index([userId, status])
  @@map("mod_learning_enrollment")
}

model ModLearningProgress {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  enrollmentId      String    @map("enrollment_id") @db.Uuid
  /// ID lógico de la lección (sin FK cross-module)
  lessonId          String    @map("lesson_id") @db.Uuid
  /// Tiempo total visto/leído en segundos
  watchedSeconds    Int       @default(0) @map("watched_seconds")
  /// Posición exacta para reanudación (segundo dentro del vídeo, scroll en HTML, etc.)
  resumePositionSec Int       @default(0) @map("resume_position_sec")
  completed         Boolean   @default(false)
  firstAccessedAt   DateTime  @default(now()) @map("first_accessed_at")
  lastAccessedAt    DateTime  @updatedAt @map("last_accessed_at")
  completedAt       DateTime? @map("completed_at")

  enrollment ModLearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([tenantId, lessonId])
  @@map("mod_learning_progress")
}

model ModLearningInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  /// Código corto para canje manual ("ABCD-1234")
  code        String
  /// Token de URL para enlace único compartible
  token       String    @unique
  /// Cantidad máxima de matriculaciones que puede crear esta invitación (null = ilimitado)
  maxUses     Int?      @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  expiresAt   DateTime? @map("expires_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  @@unique([tenantId, code])
  @@index([tenantId, courseId])
  @@map("mod_learning_invitation")
}

/// HU-FOR-002 — Paquete SCORM importado para una lección de tipo SCORM.
/// Sin FK cross-module: lessonId es UUID lógico de mod_courses_lesson.
/// El paquete se descomprime al subir y los assets se guardan en storage
/// bajo `scorm/{tenantId}/{packageId}/`. `entryPath` es la ruta relativa
/// dentro del paquete que sirve como entry del iframe (típicamente
/// "index.html" o lo que indique el imsmanifest.xml).
model ModLearningScormPackage {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  lessonId      String   @unique @map("lesson_id") @db.Uuid
  /// "1.2" | "2004" — derivado del schemaversion del manifest.
  version       String
  /// Path relativo al asset que se carga primero en el player.
  entryPath     String   @map("entry_path")
  /// Prefijo del storage donde están los assets (ej. "scorm/{tenantId}/{packageId}/").
  storagePrefix String   @map("storage_prefix")
  /// Manifest parseado (organizations, resources, items) para diagnóstico.
  manifest      Json     @default("{}")
  /// Tamaño total descomprimido en bytes.
  size          Int
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  uploadedById  String?  @map("uploaded_by_id") @db.Uuid

  @@index([tenantId])
  @@map("mod_learning_scorm_package")
}

/// Persistencia del state SCORM (cmi.*) por (tenant, user, lesson).
/// 1:1 con la combinación user+lesson — al iniciar una sesión SCORM se hace
/// upsert para reanudar el state previo. Sin FK cross-module: userId y
/// lessonId son UUID lógicos.
model ModLearningScormAttempt {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  packageId        String    @map("package_id") @db.Uuid
  /// Diccionario completo cmi.* (location, suspend_data, score, completion_status, etc.).
  cmiData          Json      @default("{}") @map("cmi_data")
  /// Atajo para indexar/filtrar sin parsear el blob: derivado de cmi.completion_status.
  completionStatus String?   @map("completion_status")
  /// Atajo: cmi.score.scaled (0..1) o cmi.core.score.raw escalado.
  scoreScaled      Float?    @map("score_scaled")
  startedAt        DateTime  @default(now()) @map("started_at")
  lastAccessedAt   DateTime  @default(now()) @map("last_accessed_at")
  completedAt      DateTime? @map("completed_at")

  @@unique([userId, lessonId])
  @@index([tenantId, userId])
  @@index([tenantId, lessonId])
  @@map("mod_learning_scorm_attempt")
}

// ============================================================================
// mod.certificates — Plantillas y emisión de certificados PDF
// ============================================================================

model ModCertificatesTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Nombre legible: "Default", "VA360 oficial", etc.
  name         String
  /// Si true, esta plantilla se usa cuando no hay otra explícita asociada
  isDefault    Boolean  @default(false) @map("is_default")
  /// Texto del cuerpo. Soporta {{alumno}}, {{curso}}, {{fecha}}, {{numero}}
  body         String
  /// Color principal en hex (#RRGGBB) usado en bordes y títulos
  primaryColor String   @default("#0f172a") @map("primary_color")
  /// URL absoluta del logo del tenant (opcional)
  logoUrl      String?  @map("logo_url")
  /// Nombre del firmante (queda en el PDF)
  signerName   String?  @map("signer_name")
  signerTitle  String?  @map("signer_title")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
  @@map("mod_certificates_template")
}

model ModCertificatesIssued {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// IDs lógicos sin FK cross-module
  courseId     String    @map("course_id") @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  templateId   String?   @map("template_id") @db.Uuid
  /// Número correlativo único por tenant
  number       String
  /// Hash SHA-256 del PDF generado (para verificación)
  hash         String
  /// Datos congelados al momento de emisión (alumno, curso, fecha, etc.)
  snapshot     Json      @default("{}")
  /// Path en el storage del PDF generado
  storageKey   String    @map("storage_key")
  /// Tamaño del PDF en bytes
  size         Int
  issuedAt     DateTime  @default(now()) @map("issued_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")

  @@unique([tenantId, number])
  @@unique([tenantId, enrollmentId])
  @@index([userId])
  @@index([courseId])
  @@map("mod_certificates_issued")
}

// ============================================================================
// mod.assessments — Quizzes con auto-corrección de tipos objetivos
// ============================================================================

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_BLANK
  SHORT_ANSWER
  LONG_ANSWER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  /// El alumno envió las respuestas pero el quiz tiene preguntas abiertas
  /// (SHORT_ANSWER / LONG_ANSWER) que requieren corrección manual del formador
  /// antes de poder declarar pasa/no pasa.
  PENDING_REVIEW
  /// Estado final tras corrección manual: scoreEarned/scorePercent/passed
  /// reflejan los puntos asignados por el formador.
  GRADED
  EXPIRED
  ABANDONED
}

model ModAssessmentsQuiz {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  /// ID lógico de la lección a la que pertenece el quiz (sin FK cross-module).
  /// Null mientras se redacta y aún no se ha asociado a ninguna lección.
  lessonId         String?    @map("lesson_id") @db.Uuid
  title            String
  description      String?
  status           QuizStatus @default(DRAFT)
  /// Umbral de aprobación en porcentaje (0-100). Default 60 %.
  passThreshold    Int        @default(60) @map("pass_threshold")
  /// Máximo de intentos por alumno (null = ilimitado).
  maxAttempts      Int?       @map("max_attempts")
  /// Límite de tiempo en minutos (null = sin límite).
  timeLimitMinutes Int?       @map("time_limit_minutes")
  /// Si true, el orden de preguntas y opciones se barajará al iniciar el intento.
  shuffleQuestions Boolean    @default(false) @map("shuffle_questions")
  /// Si true, al terminar el alumno ve la corrección por pregunta.
  showFeedback     Boolean    @default(true) @map("show_feedback")
  createdById      String?    @map("created_by_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  publishedAt      DateTime?  @map("published_at")
  deletedAt        DateTime?  @map("deleted_at")

  questions ModAssessmentsQuestion[]
  attempts  ModAssessmentsAttempt[]

  @@index([tenantId, status])
  @@index([tenantId, lessonId])
  @@map("mod_assessments_quiz")
}

model ModAssessmentsQuestion {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  quizId          String       @map("quiz_id") @db.Uuid
  type            QuestionType
  prompt          String
  /// Texto de feedback opcional que se muestra tras corregir.
  feedback        String?
  position        Int
  /// Puntos que vale la pregunta (default 1).
  points          Int          @default(1)
  /// Lista de respuestas aceptadas para FILL_IN_BLANK. Se compara
  /// case-insensitive y trimmed contra la respuesta del alumno. Vacío
  /// para todos los demás tipos.
  acceptedAnswers String[]     @default([]) @map("accepted_answers")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  quiz    ModAssessmentsQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options ModAssessmentsOption[]

  @@unique([quizId, position])
  @@index([tenantId, quizId])
  @@map("mod_assessments_question")
}

model ModAssessmentsOption {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  label      String
  /// True si esta opción cuenta como respuesta correcta.
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question ModAssessmentsQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@index([tenantId, questionId])
  @@map("mod_assessments_option")
}

model ModAssessmentsAttempt {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  quizId       String        @map("quiz_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  /// IDs lógicos del contexto (sin FK cross-module): la matriculación y la lección
  /// desde las que el alumno está realizando el intento.
  enrollmentId String?       @map("enrollment_id") @db.Uuid
  lessonId     String?       @map("lesson_id") @db.Uuid
  status       AttemptStatus @default(IN_PROGRESS)
  /// Snapshot inmutable del intento al enviarlo: puntos obtenidos, máximos, % y pasa/no pasa.
  scoreEarned  Int?          @map("score_earned")
  scoreMax     Int?          @map("score_max")
  scorePercent Int?          @map("score_percent")
  passed       Boolean?
  startedAt    DateTime      @default(now()) @map("started_at")
  /// Vencimiento del intento si el quiz tenía time limit (start + timeLimit).
  expiresAt    DateTime?     @map("expires_at")
  submittedAt  DateTime?     @map("submitted_at")
  /// Quién (formador / tenant_admin) corrigió las respuestas abiertas y cuándo.
  /// Null mientras el attempt está en PENDING_REVIEW.
  gradedAt     DateTime?     @map("graded_at")
  gradedById   String?       @map("graded_by_id") @db.Uuid

  quiz    ModAssessmentsQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers ModAssessmentsAnswer[]

  @@index([tenantId, quizId, userId])
  @@index([userId, status])
  @@map("mod_assessments_attempt")
}

model ModAssessmentsAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  /// IDs de las opciones marcadas por el alumno (vacío si no respondió).
  /// Solo aplica a SINGLE_CHOICE / MULTIPLE_CHOICE / TRUE_FALSE.
  selectedOptionIds String[] @default([]) @map("selected_option_ids") @db.Uuid
  /// Texto que escribió el alumno. Aplica a FILL_IN_BLANK / SHORT_ANSWER /
  /// LONG_ANSWER.
  textAnswer        String?  @map("text_answer")
  /// Resultado del scoring (rellenado al submit). Para SHORT/LONG_ANSWER
  /// queda en false hasta la corrección manual.
  isCorrect         Boolean  @default(false) @map("is_correct")
  scoreEarned       Int      @default(0) @map("score_earned")
  /// Comentario opcional del formador al corregir (visible al alumno tras
  /// el GRADED).
  gradedFeedback    String?  @map("graded_feedback")
  createdAt         DateTime @default(now()) @map("created_at")

  attempt ModAssessmentsAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([tenantId, attemptId])
  @@map("mod_assessments_answer")
}

// ============================================================================
// MOD.THEMING — branding y personalización visual per-tenant.
// Un único registro por tenant. Override de tokens de design (hue/saturation),
// logo, favicon, fuentes y custom CSS sanitizado. Consumido en SSR por el
// layout root para inyectar variables CSS y propagar a todos los componentes.
// Ver docs/diseño/PANTALLAS-DOGFOODING.md §10 (mod.theming).
// ============================================================================
model ModThemingTenantTheme {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// URL pública del logo principal del tenant. Usado en header y emails.
  /// Si `logoStorageKey` está set, esto apunta al endpoint público de
  /// branding del backend; si no, puede ser una URL externa pegada por el admin.
  logoUrl        String? @map("logo_url")
  /// Key del blob en el StorageService (S3 o disco) cuando el logo se subió
  /// vía el uploader del panel de branding. NULL si el admin pegó una URL
  /// externa directamente.
  logoStorageKey String? @map("logo_storage_key")
  /// MIME type del logo subido (image/png, image/svg+xml, etc.). Necesario
  /// para servir el blob con el Content-Type correcto desde el endpoint público.
  logoMimeType   String? @map("logo_mime_type")
  /// URL del favicon (suele ser cuadrado, 32x32 o 512x512 para PWA).
  faviconUrl     String? @map("favicon_url")

  /// Hue HSL del color primario (0-360). Default 213 (azul confianza Didacta).
  brandHue        Int @default(213) @map("brand_hue")
  /// Saturation del color primario (0-100). Default 70.
  brandSaturation Int @default(70) @map("brand_saturation")

  /// Familia tipográfica display (titulares). Whitelist ['Sora','Inter','Manrope','Space Grotesk','DM Sans','Plus Jakarta Sans'].
  displayFontFamily String @default("Sora") @map("display_font_family")
  /// Familia tipográfica body. Whitelist ['Inter','Manrope','DM Sans','IBM Plex Sans','Source Sans 3','Plus Jakarta Sans'].
  bodyFontFamily    String @default("Inter") @map("body_font_family")

  /// CSS adicional sanitizado (solo CSS variables y selectores seguros).
  /// Limitado a 16 KB. Se inyecta tras los tokens base.
  customCss String? @map("custom_css")

  /// HTML del footer custom (sanitizado). Solo etiquetas básicas: a, p, span, br.
  footerHtml String? @map("footer_html")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mod_theming_tenant_theme")
}

// ============================================================================
// MOD.ZOOM-LIVE — sesiones síncronas Zoom asociadas opcionalmente a un curso.
// El stub de Zoom API guarda meetingId y URLs reales (placeholder en dev).
// startUrl solo se devuelve al host/admin; alumnos ven solo joinUrl.
// ============================================================================
model ModZoomSession {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  courseId                 String?  @map("course_id") @db.Uuid
  /// UUID de la lección concreta del curso a la que está vinculada esta
  /// sesión. NULL = sesión libre del curso. Permite mostrar el botón
  /// "Unirse" en el detalle de la lección.
  lessonId                 String?  @map("lesson_id") @db.Uuid
  topic                    String
  description              String?
  status                   String   @default("SCHEDULED") /// SCHEDULED | STARTED | ENDED | CANCELLED
  startTime                DateTime @map("start_time")
  durationMinutes          Int      @map("duration_minutes")
  timezone                 String
  hostEmail                String   @map("host_email")
  zoomMeetingId            String?  @map("zoom_meeting_id")
  joinUrl                  String?  @map("join_url")
  startUrl                 String?  @map("start_url")
  /// `share_url` de la grabación de Zoom (se rellena al recibir el
  /// webhook `recording.completed`). NULL mientras no haya grabación.
  recordingUrl             String?  @map("recording_url")
  /// Duración total del meeting reportada por Zoom en `recording.completed`
  /// (minutos enteros). NULL si todavía no hay grabación.
  recordingDurationMinutes Int?     @map("recording_duration_minutes")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([tenantId, startTime(sort: Desc)], map: "mod_zoom_session_tenant_idx")
  @@index([courseId], map: "mod_zoom_session_course_idx")
  @@index([lessonId], map: "mod_zoom_session_lesson_idx")
  @@map("mod_zoom_session")
}

/// Registro de eventos webhook recibidos de Zoom para idempotencia.
/// Zoom reintenta cada evento hasta 3 veces si no recibe 2xx en 3s, así
/// que necesitamos detectar duplicados por `event_id` antes de aplicar
/// el efecto. `result` indica cómo se procesó (OK, IGNORED si no
/// matcheaba ninguna sesión, ERROR si falló al actualizar).
model ModZoomWebhookEvent {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @unique @map("event_id")
  eventType    String   @map("event_type")
  meetingId    String?  @map("meeting_id")
  sessionId    String?  @map("session_id") @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  receivedAt   DateTime @default(now()) @map("received_at")
  result       String   @default("OK") /// OK | IGNORED | ERROR
  errorMessage String?  @map("error_message")

  @@index([meetingId], map: "mod_zoom_webhook_event_meeting_idx")
  @@index([sessionId], map: "mod_zoom_webhook_event_session_idx")
  @@map("mod_zoom_webhook_event")
}

// ============================================================================
// MOD.FUNDAE.BLOCK — módulos formativos (bloques) que componen una acción.
// Cada acción puede desglosarse en N bloques con horas, contenidos y modalidad
// propia. Útil para acciones mixtas (presencial + teleformación) donde Fundae
// pide reportar cada bloque por separado en el XML.
// ============================================================================
model ModFundaeBlock {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actionId   String   @map("action_id") @db.Uuid
  /// Orden secuencial dentro de la acción (1..N). Unique por action_id.
  ordinal    Int
  title      String   @db.VarChar(200)
  /// Horas del bloque (acepta decimales: 0.5, 1.5...).
  hours      Float
  /// Modalidad propia del bloque. Puede diferir de la acción.
  modalidad  String /// PRESENCIAL | TELEFORMACION | MIXTA
  /// Contenidos del bloque (texto libre).
  contenidos String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([actionId, ordinal], map: "mod_fundae_block_action_ordinal_key")
  @@index([tenantId, actionId], map: "mod_fundae_block_tenant_action_idx")
  @@map("mod_fundae_block")
}

// ============================================================================
// MOD.FUNDAE — acciones formativas para subvenciones Fundae España.
// `codigo_accion` único por tenant. Fechas como TEXT YYYY-MM-DD para
// preservar el formato del input sin convertir a UTC. El XML de export
// se genera on-demand desde estas filas.
// ============================================================================
model ModFundaeAction {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  courseId       String?  @map("course_id") @db.Uuid
  codigoAccion   String   @map("codigo_accion")
  nombre         String
  modalidad      String /// PRESENCIAL | TELEFORMACION | MIXTA
  horasFormacion Float    @map("horas_formacion")
  fechaInicio    String   @map("fecha_inicio") /// YYYY-MM-DD
  fechaFin       String   @map("fecha_fin") /// YYYY-MM-DD
  lugar          String?
  cifCentro      String?  @map("cif_centro")
  notas          String?
  status         String   @default("DRAFT") /// DRAFT | ACTIVE | CLOSED | ARCHIVED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, codigoAccion], map: "mod_fundae_action_codigo_per_tenant_idx")
  @@index([tenantId, fechaInicio(sort: Desc)], map: "mod_fundae_action_tenant_inicio_idx")
  @@index([courseId], map: "mod_fundae_action_course_idx")
  @@map("mod_fundae_action")
}

// ============================================================================
// MOD.FUNDAE.COMPANY — empresa bonificada que financia la formación con
// crédito Fundae. Cada grupo formativo bonificable se ata a una de estas
// (LMS-79). El NIF es la clave funcional dentro del tenant; soporte de
// validación checksum vive en `validateSpanishTaxId` (modules/fundae).
//
// `creditoTotalCents` y `creditoUsadoCents` se almacenan en céntimos para
// evitar errores de redondeo al cuadrar costes con Fundae. `cccPrincipal`
// es el Código Cuenta Cotización (formato 11 dígitos sin guiones; aquí
// guardamos como string para conservar ceros líderes).
// ============================================================================
model ModFundaeCompany {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  /// NIF español (DNI / NIE / CIF). Normalizado en mayúsculas sin
  /// separadores. Único por tenant para evitar duplicar empresa cuando
  /// dos admins la dan de alta a la vez.
  nif               String    @db.VarChar(20)
  razonSocial       String    @map("razon_social") @db.VarChar(200)
  /// Código Cuenta Cotización principal — 11 dígitos como string para
  /// preservar ceros a la izquierda. Opcional: empresa puede tener varios
  /// CCCs y registrarlos al inicio de un grupo concreto.
  cccPrincipal      String?   @map("ccc_principal") @db.VarChar(15)
  /// Nº de empleados de plantilla a fecha del alta. Necesario para
  /// validar % de bonificación máxima permitido por Fundae.
  plantilla         Int?
  /// Crédito Fundae anual disponible en céntimos.
  creditoTotalCents Int?      @map("credito_total_cents")
  /// Crédito ya consumido en grupos cerrados (céntimos). El servicio lo
  /// suma al cerrar grupos; nunca se decrementa.
  creditoUsadoCents Int       @default(0) @map("credito_usado_cents")
  /// Datos de contacto + dirección — JSON libre para permitir evolución
  /// sin migración cada vez (calle, ciudad, CP, persona contacto, email,
  /// teléfono). Validado por Zod en el service.
  datosContacto     Json      @default("{}") @map("datos_contacto")
  /// Notas internas del admin (no se exponen a empresa_manager).
  notas             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  /// Soft-delete. Conservamos la fila para integridad histórica de
  /// grupos cerrados aunque el admin "borre" la empresa.
  deletedAt         DateTime? @map("deleted_at")

  @@unique([tenantId, nif], map: "mod_fundae_company_tenant_nif_key")
  @@index([tenantId, deletedAt], map: "mod_fundae_company_tenant_deleted_idx")
  @@index([tenantId, razonSocial], map: "mod_fundae_company_tenant_razon_idx")
  @@map("mod_fundae_company")
}

// ============================================================================
// MOD.FUNDAE.RLPT — notificaciones a la Representación Legal de Personas
// Trabajadoras (LMS-80). Para que un grupo bonificable pueda iniciarse,
// la empresa tiene que haber notificado a la RLPT con la antelación
// mínima exigida por el RD 694/2017 (15 días naturales). El acuse de la
// RLPT y eventuales actas de discrepancia se guardan como subtipos del
// mismo modelo, todos vinculados a la empresa por `companyId` (FK
// lógica — no FK física por la regla del proyecto de no-cross-module-FK).
//
// El blob (PDF firmado, escaneo del acuse) se persiste en
// `evidence_vault_entry` con hash SHA-256; aquí guardamos sólo la
// referencia + metadata. El hook `fundae.group.before-start` consulta
// que exista al menos una NOTIFICACION_INICIAL con `plazoVencimientoAt`
// pasada antes de permitir iniciar un grupo.
// ============================================================================
model ModFundaeRlptNotice {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  /// FK lógica a `mod_fundae_company.id`. Sin FK física por la regla
  /// de aislamiento de módulos.
  companyId           String    @map("company_id") @db.Uuid
  /// Tipo de notificación.
  ///   - NOTIFICACION_INICIAL: notificación previa al inicio del grupo.
  ///   - ACUSE_RECIBO: respuesta de la RLPT confirmando recepción.
  ///   - ACTA_DISCREPANCIA: cuando la RLPT formaliza desacuerdo; permite
  ///     avanzar el grupo igualmente con la traza documentada.
  tipo                String /// NOTIFICACION_INICIAL | ACUSE_RECIBO | ACTA_DISCREPANCIA
  /// Fecha en que se notificó / recibió. ISO 8601 string para preservar
  /// la zona horaria del usuario (Madrid en la mayoría de casos).
  fechaNotificacionAt DateTime  @map("fecha_notificacion_at")
  /// Plazo en el que vence la antelación legal mínima. Para
  /// NOTIFICACION_INICIAL se calcula como `fechaNotificacionAt + 15 días`.
  /// El hook compara `now() >= plazoVencimientoAt` para autorizar el
  /// inicio del grupo. Para los otros tipos suele coincidir con la
  /// fecha de notificación.
  plazoVencimientoAt  DateTime  @map("plazo_vencimiento_at")
  /// Referencia al artefacto subido. Apunta a evidence_vault_entry.id —
  /// FK física porque es el mismo módulo core (Evidence Vault) y la
  /// integridad referencial protege contra eliminaciones accidentales
  /// del blob.
  evidenceEntryId     String    @map("evidence_entry_id") @db.Uuid
  /// Notas internas (no van a Fundae).
  observaciones       String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  evidence EvidenceVaultEntry @relation(fields: [evidenceEntryId], references: [id])

  @@index([tenantId, companyId, tipo], map: "mod_fundae_rlpt_tenant_company_tipo_idx")
  @@index([tenantId, companyId, fechaNotificacionAt(sort: Desc)], map: "mod_fundae_rlpt_tenant_company_fecha_idx")
  @@index([evidenceEntryId], map: "mod_fundae_rlpt_evidence_idx")
  @@map("mod_fundae_rlpt_notice")
}

// ============================================================================
// MOD.FUNDAE.GROUP — grupo formativo bonificable (LMS-81). Vincula una
// acción formativa Fundae (mod_fundae_action) con la empresa que financia
// la bonificación (mod_fundae_company), y materializa el ciclo de vida
// del grupo: DRAFT → ACTIVE → CLOSED. La transición DRAFT → ACTIVE pasa
// por `FundaeRlptService.assertGroupCanStart`, que rechaza si la empresa
// no notificó a la RLPT con la antelación legal.
//
// `creditoEstimadoCents` se cobra del crédito Fundae de la empresa al
// pasar a ACTIVE; al cerrar, el service ajusta `credito_usado_cents`
// con `creditoConsumidoCents` definitivo (suma de todos los costes
// directos/indirectos/organización).
// ============================================================================
model ModFundaeGroup {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  /// FK lógica a `mod_fundae_action.id` (sin FK física por la regla de
  /// aislamiento de módulos — son submódulos del mismo `mod.fundae`,
  /// pero conviene mantener el patrón homogéneo).
  actionId              String    @map("action_id") @db.Uuid
  /// FK lógica a `mod_fundae_company.id`.
  companyId             String    @map("company_id") @db.Uuid
  /// Identificador interno del grupo dentro de la acción. Único por
  /// acción; suele coincidir con el `numeroGrupo` que pide Fundae al
  /// presentar el grupo (1..N).
  numeroGrupo           Int       @map("numero_grupo")
  modalidad             String /// PRESENCIAL | TELEFORMACION | MIXTA
  fechaInicioPrevista   DateTime  @map("fecha_inicio_prevista")
  fechaFinPrevista      DateTime  @map("fecha_fin_prevista")
  /// Fecha real en que se inició el grupo (null hasta el start).
  fechaInicioReal       DateTime? @map("fecha_inicio_real")
  /// Fecha real de cierre del grupo (null hasta el close).
  fechaFinReal          DateTime? @map("fecha_fin_real")
  /// Estado del ciclo de vida.
  status                String    @default("DRAFT") /// DRAFT | ACTIVE | CLOSED | CANCELLED
  /// Crédito estimado a consumir cuando se planificó. En céntimos.
  creditoEstimadoCents  Int?      @map("credito_estimado_cents")
  /// Umbral de finalización Fundae (default 75%). Se aplica al cálculo
  /// de resultado APTO/NO_APTO por participante (LMS-84).
  umbralFinalizacionPct Int       @default(75) @map("umbral_finalizacion_pct")
  notas                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  costs        ModFundaeCost[]
  participants ModFundaeGroupParticipant[]

  @@unique([tenantId, actionId, numeroGrupo], map: "mod_fundae_group_action_numero_key")
  @@index([tenantId, companyId, status], map: "mod_fundae_group_tenant_company_status_idx")
  @@index([tenantId, actionId, status], map: "mod_fundae_group_tenant_action_status_idx")
  @@index([tenantId, status, fechaInicioPrevista(sort: Desc)], map: "mod_fundae_group_tenant_status_fecha_idx")
  @@map("mod_fundae_group")
}

// ============================================================================
// MOD.FUNDAE.COST — desglose de costes del grupo (LMS-81). Fundae exige
// el desglose por categoría para validar la bonificación: directos
// (formación, materiales, alquiler de aulas, formadores), indirectos
// (administración, gestión) y organización (limitados al 10%).
//
// Importes en céntimos (Int) para evitar drift de coma flotante al
// sumar. Los costes son inmutables una vez cerrado el grupo: el service
// rechaza creates/updates si el grupo está en CLOSED.
// ============================================================================
model ModFundaeCost {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  tipo        String /// DIRECTO | INDIRECTO | ORGANIZACION
  /// Concepto facturable (ej: "Formador externo Juan Pérez", "Alquiler
  /// aula Madrid", "Material didáctico").
  concepto    String   @db.VarChar(200)
  amountCents Int      @map("amount_cents")
  /// Notas opcionales (referencia a factura externa, proveedor).
  notas       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  group ModFundaeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([tenantId, groupId, tipo], map: "mod_fundae_cost_tenant_group_tipo_idx")
  @@index([groupId], map: "mod_fundae_cost_group_idx")
  @@map("mod_fundae_cost")
}

// ============================================================================
// MOD.FUNDAE.GROUP_PARTICIPANT — matriculación nominal de alumnos en un
// grupo bonificable Fundae (LMS-82). Aunque el alumno también está
// matriculado en el curso del catálogo (vía `course_enrollment`), el grupo
// Fundae necesita un registro propio porque:
//
//   1. La comunicación de inicio Fundae exige listado nominal por grupo
//      (no por curso).
//   2. La empresa bonificada se vincula a través del grupo, no del curso.
//   3. Un alumno puede pertenecer a varios grupos del mismo curso (ediciones
//      sucesivas de la formación).
//
// Borrado lógico vía `status = REMOVED` para mantener trazabilidad de
// matriculaciones canceladas (Fundae las exige en el expediente).
// ============================================================================
model ModFundaeGroupParticipant {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  groupId         String    @map("group_id") @db.Uuid
  /// FK lógica a `app_user.id`.
  userId          String    @map("user_id") @db.Uuid
  /// Empresa bonificada del grupo, denormalizada para acelerar reportes
  /// agregados por empresa sin tener que hacer join al grupo.
  companyId       String    @map("company_id") @db.Uuid
  /// Snapshot del NIF del alumno en el momento de matriculación (el campo
  /// `app_user.documentId` puede cambiar; Fundae exige fijar el NIF que
  /// se comunicó en su día).
  nifAlumno       String?   @map("nif_alumno")
  enrolledAt      DateTime  @default(now()) @map("enrolled_at")
  removedAt       DateTime? @map("removed_at")
  status          String    @default("ENROLLED") /// ENROLLED | REMOVED
  /// Horas reales de asistencia (LMS-84). Se calcula como
  /// `action.horasFormacion * progressPercent / 100`. Decimal para
  /// medias horas Fundae (0.5).
  horasAsistidas  Decimal?  @map("horas_asistidas") @db.Decimal(8, 2)
  /// Progreso del enrollment del curso (0-100) capturado en el momento
  /// del cálculo de finalización.
  progressPercent Int?      @map("progress_percent")
  /// Resultado final Fundae: APTO si supera el umbral (default 75%),
  /// NO_APTO si fue eliminado o no llegó al umbral, EN_CURSO antes
  /// de la finalización.
  resultado       String? /// APTO | NO_APTO | EN_CURSO
  /// Fecha del cálculo de finalización (cuando se snapshoteó el
  /// resultado). Distinto de `removedAt` que indica baja administrativa.
  completedAt     DateTime? @map("completed_at")
  notas           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  group ModFundaeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([tenantId, groupId, userId], map: "mod_fundae_group_participant_group_user_key")
  @@index([tenantId, groupId, status], map: "mod_fundae_group_participant_group_status_idx")
  @@index([tenantId, companyId, status], map: "mod_fundae_group_participant_company_status_idx")
  @@index([tenantId, userId], map: "mod_fundae_group_participant_tenant_user_idx")
  @@map("mod_fundae_group_participant")
}

// ============================================================================
// PASSWORD RESET TOKENS — flujo de "olvidé mi contraseña" para self-service.
// El token raw viaja solo en email; la DB guarda SHA-256 (no se puede recuperar
// el original aunque se filtre el dump). TTL 1h. Single-use (usedAt).
// ============================================================================
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  /// SHA-256 hex del token raw. El token raw solo se conoce en el momento de
  /// crearlo y se entrega por email — nunca se persiste en claro.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  /// Vencimiento absoluto (default +1h). Más allá se rechaza con un error
  /// específico para que la UI pida regenerar.
  expiresAt DateTime  @map("expires_at")
  /// Marca de uso (single-use). Al consumirse se invalida.
  usedAt    DateTime? @map("used_at")
  /// IP + UA al solicitar para audit log (si llega rate-limit / ataque).
  requestIp String?   @map("request_ip")
  requestUa String?   @map("request_ua")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

// ============================================================================
// AI GATEWAY — configuración multi-provider por tenant (LMS-90.B).
//
// Cada fila vincula un (tenant, purpose) con un provider concreto + sus
// credenciales. La `apiKey` se cifra antes de persistir (AES-256-GCM con
// clave maestra del cluster en `AI_CONFIG_ENCRYPTION_KEY`); en runtime se
// descifra solo cuando el gateway necesita hacer una llamada.
//
// Si un tenant no tiene fila para un purpose, el gateway usa el default
// global de env (`DEFAULT_AI_<PURPOSE>_PROVIDER` + `DEFAULT_AI_<PURPOSE>_API_KEY`).
//
// `purpose` separa chat y embed para que el tenant pueda mezclar (p.ej.
// Anthropic para chat + Voyage para embeddings, que es una combinación común).
// ============================================================================
model TenantAiProviderConfig {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// 'chat' | 'embed'. Único por tenant+purpose.
  purpose      String
  /// Identificador del provider (openai, anthropic, gemini, openrouter,
  /// mistral, groq, ollama, voyage).
  provider     String
  /// Modelo concreto. Vacío = usa default del adapter.
  model        String   @default("")
  /// Clave API cifrada con AES-256-GCM. NUNCA en plaintext.
  apiKeyCipher String   @map("api_key_cipher")
  /// IV usado para cifrar (96 bits hex). Único por fila.
  apiKeyIv     String   @map("api_key_iv")
  /// Auth tag GCM (128 bits hex).
  apiKeyTag    String   @map("api_key_tag")
  /// Override de URL base (autoalojado, proxy corporativo, etc.).
  baseUrl      String?  @map("base_url")
  /// Headers extra como JSON (algunos providers exigen referer, etc.).
  extraHeaders Json     @default("{}") @map("extra_headers")
  /// Si false, el gateway omite esta config y va al fallback default global.
  enabled      Boolean  @default(true)
  /// Notas internas del admin (motivo del provider elegido, fecha contrato).
  notas        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, purpose], map: "tenant_ai_provider_config_tenant_purpose_key")
  @@index([tenantId], map: "tenant_ai_provider_config_tenant_idx")
  @@map("tenant_ai_provider_config")
}

// ============================================================================
// MOD.AI-TUTOR — Tutor IA por curso con RAG (LMS-90, Fase 1.C).
//
// `mod_ai_tutor_chunk` almacena fragmentos de contenido de las lecciones
// indexados con embeddings (pgvector 1536 dim). El query de búsqueda es
// cosine similarity vía SQL raw (Prisma todavía no soporta el operador `<=>`
// nativamente; usamos $queryRaw en el service).
//
// `mod_ai_tutor_conversation` y `mod_ai_tutor_message` mantienen el histórico
// de chat por (alumno, curso). El context window incluye las últimas N
// mensajes para que el alumno pueda hacer follow-ups.
//
// `mod_ai_tutor_token_usage` agrega tokens consumidos por (tenant, user, día)
// para enforce de cuota.
// ============================================================================

model ModAiTutorChunk {
  id          String                      @id @default(uuid()) @db.Uuid
  tenantId    String                      @map("tenant_id") @db.Uuid
  /// FK lógica a mod_courses_course.id.
  courseId    String                      @map("course_id") @db.Uuid
  /// FK lógica a mod_courses_lesson.id. Null si es chunk de metadata del curso
  /// (descripción general, objetivos) sin lección concreta.
  lessonId    String?                     @map("lesson_id") @db.Uuid
  /// Posición del chunk dentro de su origen (lesson o curso).
  ordinal     Int
  /// Texto del chunk (UTF-8). Lo usamos al construir el prompt.
  content     String
  /// Embedding vectorial. Dimensión depende del provider (1536 para
  /// OpenAI text-embedding-3-small / ada-002; otros providers requieren
  /// migración del schema).
  embedding   Unsupported("vector(1536)")
  /// Aproximación de tokens del content (para presupuesto del prompt).
  tokensCount Int                         @map("tokens_count")
  createdAt   DateTime                    @default(now()) @map("created_at")

  @@index([tenantId, courseId, ordinal], map: "mod_ai_tutor_chunk_tenant_course_ordinal_idx")
  @@index([tenantId, courseId, lessonId], map: "mod_ai_tutor_chunk_tenant_course_lesson_idx")
  @@map("mod_ai_tutor_chunk")
}

model ModAiTutorConversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  /// Resumen corto generado por el modelo cada N mensajes para no perder
  /// contexto al desbordar el context window. Null en conversaciones nuevas.
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ModAiTutorMessage[]

  @@index([tenantId, userId, courseId], map: "mod_ai_tutor_conversation_tenant_user_course_idx")
  @@map("mod_ai_tutor_conversation")
}

model ModAiTutorMessage {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  /// 'user' | 'assistant'
  role           String
  content        String
  /// Citas que el assistant generó: array de { lessonId, chunkOrdinal }.
  citations      Json     @default("[]")
  /// Tokens consumidos (solo para mensajes del assistant, calculados al recibir).
  tokensInput    Int      @default(0) @map("tokens_input")
  tokensOutput   Int      @default(0) @map("tokens_output")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ModAiTutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "mod_ai_tutor_message_conv_created_idx")
  @@map("mod_ai_tutor_message")
}

model ModAiTutorTokenUsage {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Null para agregados a nivel tenant (sin desglose por user).
  userId       String?  @map("user_id") @db.Uuid
  /// Día calendario UTC (YYYY-MM-DD). Para queries por rango.
  day          DateTime @db.Date
  tokensInput  Int      @default(0) @map("tokens_input")
  tokensOutput Int      @default(0) @map("tokens_output")
  /// Coste estimado en céntimos de USD según pricing del provider al momento.
  costCents    Int      @default(0) @map("cost_cents")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId, day], map: "mod_ai_tutor_token_usage_tenant_user_day_key")
  @@index([tenantId, day], map: "mod_ai_tutor_token_usage_tenant_day_idx")
  @@map("mod_ai_tutor_token_usage")
}
