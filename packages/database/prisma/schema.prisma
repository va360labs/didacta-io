  eventId      String   @map("event_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  registeredAt DateTime @default(now()) @map("registered_at")

  event ModEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], name: "mod_event_registration_unique", map: "mod_event_registration_unique")
  @@index([tenantId, userId])
  @@map("mod_event_registration")
}

// ─── Rutas de aprendizaje ────────────────────────────────────────────────────

enum LearningPathStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LearningPathSequenceType {
  LINEAR
  FLEXIBLE
}

enum LearningPathEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Ruta de aprendizaje: agrupa N cursos en un orden definido.
/// Sin FK cross-module: courseId en ModLearningPathCourse es UUID lógico.
model ModLearningPath {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  /// Slug URL-friendly único por tenant (generado del título).
  slug             String
  title            String                   @db.VarChar(120)
  description      String?                  @db.VarChar(500)
  sequenceType     LearningPathSequenceType @default(LINEAR) @map("sequence_type")
  status           LearningPathStatus       @default(DRAFT)
  estimatedMinutes Int?                     @map("estimated_minutes")
  createdById      String?                  @map("created_by_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  deletedAt        DateTime?                @map("deleted_at")

  courses     ModLearningPathCourse[]
  enrollments ModLearningPathEnrollment[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("mod_learning_path")
}

/// Relación N:M entre ruta y curso (courseId es FK lógica, sin constraint cross-module).
model ModLearningPathCourse {
  id       String @id @default(uuid()) @db.Uuid
  pathId   String @map("path_id") @db.Uuid
  /// ID lógico del curso (sin FK cross-module — ADR-015).
  courseId String @map("course_id") @db.Uuid
  position Int

  path ModLearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@index([pathId, position])
  @@map("mod_learning_path_course")
}

/// Matriculación de un usuario en una ruta de aprendizaje.
model ModLearningPathEnrollment {
  id              String                       @id @default(uuid()) @db.Uuid
  tenantId        String                       @map("tenant_id") @db.Uuid
  pathId          String                       @map("path_id") @db.Uuid
  /// ID lógico del usuario (sin FK cross-module — ADR-015).
  userId          String                       @map("user_id") @db.Uuid
  status          LearningPathEnrollmentStatus @default(ACTIVE)
  /// Porcentaje completado (0-100): (cursos completados / total cursos) * 100.
  progressPercent Int                          @default(0) @map("progress_percent")
  enrolledAt      DateTime                     @default(now()) @map("enrolled_at")
  completedAt     DateTime?                    @map("completed_at")

  path ModLearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pathId, userId])
  @@index([tenantId, userId, status])
  @@index([pathId])
  @@map("mod_learning_path_enrollment")
}

// ============================================================================
// COMPETENCIAS (derivadas de cursos) — Fase 2 de "Mi perfil".
// El catálogo lo gestiona admin/formador; el mapeo curso↔competencia define de
// qué cursos sale cada competencia. Las puntuaciones por usuario NO se
// almacenan: se derivan en tiempo de lectura del progreso de sus matrículas
// (ver getMyCompetencies). Sin datos de cartón.
// ============================================================================

/// Catálogo de competencias del tenant (ej. "Comunicación", "Liderazgo").
model ModLearningCompetency {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(280)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses ModLearningCourseCompetency[]

  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
  @@map("mod_learning_competency")
}

/// Mapeo curso ↔ competencia con peso. El score de una competencia para un
/// usuario es la media de `progressPercent` de sus matrículas en los cursos
/// asociados, ponderada por `weight`.
model ModLearningCourseCompetency {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// ID lógico del curso (sin FK cross-module — ADR-015).
  courseId     String   @map("course_id") @db.Uuid
  competencyId String   @map("competency_id") @db.Uuid
  weight       Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  competency ModLearningCompetency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, courseId, competencyId])
  @@index([tenantId, courseId])
  @@index([competencyId])
  @@map("mod_learning_course_competency")
}
