// ============================================================================
// Didacta — Schema Prisma v1 (Core)
// ----------------------------------------------------------------------------
// Reglas clave:
// - Toda tabla con datos de negocio incluye `tenantId` + política RLS (ver rls.sql)
// - Sin FKs cross-module (los módulos usan IDs lógicos)
// - Append-only en AuditLog (triggers en rls.sql)
// - Soft delete preferido (deletedAt)
// Referencia: docs/PRD.md §9.1, docs/ARQUITECTURA-MODULAR.md §4.1
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  // `linux-musl-openssl-3.0.x` cubre la imagen alpine de runtime;
  // `debian-openssl-3.0.x` queda como fallback para entornos no-musl.
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector se añade en Fase 1.C cuando se active mod.ai-tutor (embeddings + RAG).
  // Para activarlo en Postgres de Easypanel, cambiar la imagen del servicio
  // a pgvector/pgvector:pg16 y volver a añadir `vector` aquí.
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto]
}

// ============================================================================
// TENANTS & MODULE REGISTRY
// ============================================================================

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  config    Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  users           User[]
  sessions        Session[]
  apiKeys         ApiKey[]
  tenantModules   TenantModule[]
  auditLogs       AuditLog[]
  evidenceEntries EvidenceVaultEntry[]
  outboxEvents    OutboxEvent[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeadLetters WebhookDeadLetter[]
  notifTemplates  NotificationTemplate[]
  tenantSettings  TenantSetting[]
  domains         TenantDomain[]

  @@index([slug])
  @@index([status])
  @@map("tenant")
}

// ============================================================================
// TENANT DOMAINS — mapeo Host → tenant para login transparente.
// Cada tenant puede tener múltiples dominios (subdominio default + custom).
// El middleware de tenancy lee el Host header del request, busca aquí, y
// resuelve el tenant correspondiente. Esto permite que el alumno NO escriba
// el slug en signin/signup — la URL le dice todo.
// Ver HU-SA-001 + LMS-110 (Notion).
// ============================================================================
model TenantDomain {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Host completo en lowercase, sin puerto ni path.
  /// Ejemplos: "aprende.va360labs.com", "didacta.local", "localhost".
  hostname   String   @unique @db.VarChar(253)
  /// El primary identifica el dominio canónico para emails y enlaces.
  /// Solo uno por tenant tiene `isPrimary=true`.
  isPrimary  Boolean  @default(false) @map("is_primary")
  /// Para custom domains de clientes: requiere validación DNS antes de activar.
  /// `localhost` y dominios default del seed nacen verified=true.
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domain")
}

// ============================================================================
// TENANT SETTINGS — config persistente per-tenant con encryption at-rest.
// Reemplaza el stub in-memory anterior. Los valores marcados con is_secret se
// cifran con AES-256-GCM usando TENANT_SETTINGS_ENC_KEY del env. Los no
// secretos viajan en value_json plano. Cada admin de tenant configura desde
// /admin/configuracion sus credenciales SMTP, Zoom, etc.
// ============================================================================

model TenantSetting {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Namespace lógico: "notifications", "zoom", "ai-tutor", "storage", etc.
  moduleName  String   @map("module_name") @db.VarChar(100)
  /// Clave dentro del namespace (ej. "smtp", "default-locale").
  key         String   @db.VarChar(200)
  /// Si true, el valor es sensible y se cifra (passwords, API keys).
  isSecret    Boolean  @default(false) @map("is_secret")
  /// Valor en claro cuando isSecret=false (cualquier JSON).
  valueJson   Json?    @map("value_json")
  /// AES-256-GCM ciphertext + IV (12B) + auth tag (16B) cuando isSecret=true.
  valueCipher Bytes?   @map("value_cipher")
  valueIv     Bytes?   @map("value_iv")
  valueTag    Bytes?   @map("value_tag")
  /// Quién hizo el último cambio (sin FK cross-module a IAM).
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleName, key])
  @@index([tenantId, moduleName])
  @@map("tenant_setting")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Module {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  version          String
  displayName      String   @map("display_name")
  description      String?
  enabledByDefault Boolean  @default(false) @map("enabled_by_default")
  manifest         Json
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenantModules TenantModule[]

  @@map("module")
}

model TenantModule {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  enabledAt DateTime @default(now()) @map("enabled_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@id([tenantId, moduleId])
  @@index([tenantId, enabled])
  @@map("tenant_module")
}

// ============================================================================
// IAM
// ============================================================================

model User {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  email            String
  emailVerified    Boolean    @default(false) @map("email_verified")
  name             String?
  /// Biografía corta del usuario, opcional. Se captura en el onboarding y se
  /// edita en /cuenta. Máx 280 caracteres.
  bio              String?    @db.VarChar(280)
  /// Cargo / puesto del usuario (ej. "Director de Formación"). Opcional,
  /// editable por el propio usuario en /cuenta. Máx 120.
  jobTitle         String?    @map("job_title") @db.VarChar(120)
  /// Departamento / área (ej. "Talento y Cultura"). Opcional. Máx 120.
  department       String?    @db.VarChar(120)
  /// Ubicación libre (ej. "Madrid, España"). Opcional. Máx 120.
  location         String?    @db.VarChar(120)
  passwordHash     String?    @map("password_hash")
  mfaSecret        String?    @map("mfa_secret")
  mfaEnabled       Boolean    @default(false) @map("mfa_enabled")
  mfaRecoveryCodes String[]   @default([]) @map("mfa_recovery_codes")
  status           UserStatus @default(ACTIVE)
  /// True cuando la contraseña actual es temporal (ej. user creado por
  /// `POST /api/v1/inscribe` tras una compra externa). Mientras sea true,
  /// el usuario es forzado a establecer una contraseña nueva tras el login.
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  locale           String     @default("es-ES")
  /// IANA timezone, ej. "America/Argentina/Buenos_Aires" o "Europe/Madrid".
  /// Usado para mostrar timestamps localmente. Default UTC.
  timezone         String     @default("UTC") @map("timezone")
  /// URL pública (S3/CDN) del avatar del usuario. Null = usar iniciales.
  avatarUrl        String?    @map("avatar_url")
  /// Documento de identidad (DNI o NIE español) en mayúsculas y sin
  /// separadores. Requerido para Fundae cuando el usuario participa
  /// en una acción formativa bonificada. Único por tenant si está set.
  documentId       String?    @map("document_id") @db.VarChar(20)
  /// Origen de los datos cuando el user fue importado por un módulo
  /// third-party (ej. "learndash"). Combinado con `externalId`, forma la
  /// clave de idempotencia que usa `ctx.didacta.users.upsertByExternalRef`.
  /// Null para users creados directamente en Didacta. Ver ADR-014.
  externalSource   String?    @map("external_source") @db.VarChar(40)
  /// ID del user en el sistema origen (ej. WordPress user_id). Free-form.
  /// Solo significativo en combinación con `externalSource`. Ver ADR-014.
  externalId       String?    @map("external_id") @db.VarChar(200)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")
  lastLoginAt      DateTime?  @map("last_login_at")
  /// Timestamp en que el usuario completó el onboarding de primera vez.
  /// Null = aún no lo completó → el shell lo fuerza a /onboarding antes de
  /// dejarlo entrar. Backfill de usuarios previos = created_at (no se les
  /// interrumpe). Solo `null` → fecha; nunca vuelve a null.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  /// ID numérico de Telegram capturado en la inscripción de miembros (gate
  /// Telegram). Null para usuarios no creados por ese flujo. Único por tenant
  /// cuando está set: el índice único parcial vive en rls.sql porque Prisma no
  /// expresa índices parciales (WHERE telegram_id IS NOT NULL). Ver PRD Notion.
  telegramId       String?    @map("telegram_id") @db.VarChar(32)
  /// Pertenencia al grupo de Telegram en el momento del registro (tri-estado):
  /// true = en el grupo, false = fuera, null = no verificable (error Bot API).
  /// Solo significativo cuando `telegramId` está set.
  telegramInGroup  Boolean?   @map("telegram_in_group")
  /// Sello de la decisión del aprobador (aprobar/rechazar) sobre una inscripción
  /// PENDING. Una vez con valor, los enlaces firmados quedan inutilizados.
  approvalDecidedAt DateTime? @map("approval_decided_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  sessions Session[]
  apiKeys  ApiKey[]
  roles    UserRole[]

  @@unique([tenantId, email])
  @@unique([tenantId, documentId], map: "user_tenant_document_id_key")
  @@index([tenantId, status])
  @@index([tenantId, externalSource, externalId], map: "user_external_ref_idx")
  @@index([tenantId, telegramId], map: "user_tenant_telegram_idx")
  @@map("user")
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  moduleName  String?  @map("module_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([moduleName])
  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  scopes     String[]
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("api_key")
}

// ============================================================================
// NOTIFICATION PREFERENCES (core) — matriz canal × categoría por usuario.
// Una fila por combinación (categoría, canal). Si no hay fila, el default es
// "activado" (lo resuelve la API). El usuario las configura en el onboarding y
// en /cuenta. El módulo community conserva su propio `digestOptOut`; el
// frontend reconcilia la celda COMMUNITY×EMAIL con esa preferencia, sin
// acoplamiento cross-módulo en backend. Reutiliza el enum core
// NotificationChannel (solo EMAIL/IN_APP son configurables; WEBHOOK es a nivel
// tenant). Tabla con tenant_id → hereda la política RLS genérica de rls.sql.
// ============================================================================
model UserNotificationPreference {
  id        String                         @id @default(uuid()) @db.Uuid
  tenantId  String                         @map("tenant_id") @db.Uuid
  userId    String                         @map("user_id") @db.Uuid
  category  NotificationPreferenceCategory
  channel   NotificationChannel
  enabled   Boolean                        @default(true)
  createdAt DateTime                       @default(now()) @map("created_at")
  updatedAt DateTime                       @updatedAt @map("updated_at")

  @@unique([tenantId, userId, category, channel], map: "user_notification_preference_unique")
  @@index([tenantId, userId])
  @@map("user_notification_preference")
}

enum NotificationPreferenceCategory {
  COMMUNITY
  LEARNING
  ASSESSMENTS
  SYSTEM
}

// ============================================================================
// AUDIT LOG (append-only, triggers en rls.sql)
// ============================================================================

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  metadata     Json     @default("{}")
  ip           String?
  userAgent    String?  @map("user_agent")
  timestamp    DateTime @default(now())
  prevHash     String?  @map("prev_hash")
  hash         String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, timestamp])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

// ============================================================================
// EVIDENCE VAULT
// ============================================================================

model EvidenceVaultEntry {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  storageKey   String   @map("storage_key")
  hash         String
  size         BigInt
  contentType  String?  @map("content_type")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  rlptNotices ModFundaeRlptNotice[]

  @@index([tenantId, resourceType, resourceId])
  @@index([hash])
  @@map("evidence_vault_entry")
}

// ============================================================================
// EVENT BUS (outbox pattern) + WEBHOOKS
// ============================================================================

model OutboxEvent {
  id                 BigInt    @id @default(autoincrement())
  tenantId           String    @map("tenant_id") @db.Uuid
  eventName          String    @map("event_name")
  payloadVersion     Int       @default(1) @map("payload_version")
  payload            Json
  metadata           Json      @default("{}")
  idempotencyKey     String    @map("idempotency_key")
  createdAt          DateTime  @default(now()) @map("created_at")
  processedAt        DateTime? @map("processed_at")
  processingAttempts Int       @default(0) @map("processing_attempts")
  lastError          String?   @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([processedAt])
  @@index([tenantId, eventName])
  @@map("outbox_event")
}

// ============================================================================
// WEBHOOKS SALIENTES — 10º piloto License SDK (`feat:api.webhooks.high_throughput`)
// ----------------------------------------------------------------------------
// Endpoints de webhook que el tenant configura para recibir notificaciones
// outbound de eventos de la plataforma (enrollment.created, course.completed,
// etc.). Tier community = envío naive síncrono con 1 reintento. Tier
// enterprise = cola BullMQ + reintentos exponenciales + HMAC + dead-letter.
// El bus de eventos publica al outbox (tabla `outbox_event`); un bridge
// suscribe handlers que reenvían a estos endpoints según los eventos a los
// que cada uno está suscrito (campo `eventTypes`).
// ============================================================================

model WebhookEndpoint {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  url        String
  /// Secret en plano para HMAC-SHA256 (path EE) y para reentregarlo al
  /// admin en la respuesta de POST/PUT (one-shot, ver controller). NO se
  /// usa en hash — es el secret real. RLS aísla por tenant_id.
  secret     String
  /// Lista de eventos a los que este endpoint está suscrito. Si está vacío
  /// o contiene `'*'`, recibe todos. La validación de límites de cantidad
  /// la hace el service (community = 3 max, EE = ilimitado).
  eventTypes String[] @map("event_types")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, url])
  @@index([tenantId, active])
  @@map("webhook_endpoint")
}

model WebhookDeadLetter {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// FK lógica a `webhook_endpoint.id`. NO declaramos FK física para evitar
  /// CASCADE on delete — preferimos preservar el dead-letter histórico aunque
  /// el endpoint se borre (auditoría / análisis postmortem).
  endpointId String   @map("endpoint_id") @db.Uuid
  eventType  String   @map("event_type")
  payload    Json
  lastError  String   @map("last_error")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([endpointId])
  @@map("webhook_dead_letter")
}

// ============================================================================
// NOTIFICATION TEMPLATES
// ============================================================================

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  key       String
  channel   NotificationChannel
  locale    String              @default("es-ES")
  subject   String?
  body      String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key, channel, locale])
  @@map("notification_template")
}

enum NotificationChannel {
  EMAIL
  IN_APP
  WEBHOOK
}

/// Cada notificación que el NotificationHub envía o intenta enviar.
/// El channel IN_APP siempre se persiste y es leído por el alumno desde
/// /notificaciones. Los demás canales también persisten para auditoría:
/// el campo `sentAt`/`failedAt` registra el resultado del adapter.
// ============================================================================
// mod.community — Posts, comentarios y reacciones
// ============================================================================

model ModCommunityPost {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  /// ID lógico del autor (sin FK cross-module a IAM).
  authorId          String    @map("author_id") @db.Uuid
  /// ID lógico del curso al que está vinculado el post (null = post global).
  courseId          String?   @map("course_id") @db.Uuid
  title             String
  body              String
  /// Tags libres (#general, #ayuda, #anuncios, etc.). Vacío = sin tags.
  tags              String[]  @default([])
  /// Snapshot del nombre del autor al crear el post (denormalizado para
  /// listados rápidos sin necesidad de join cross-module a IAM).
  authorDisplayName String?   @map("author_display_name")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  /// Moderación: timestamp + actor + razón. Si `hiddenAt != null`, el post
  /// queda invisible para alumnos pero la fila se preserva (vs `deletedAt`,
  /// que es soft-delete por el autor). El admin puede revertir clearando
  /// las tres columnas.
  hiddenAt     DateTime? @map("hidden_at")
  hiddenById   String?   @map("hidden_by_id") @db.Uuid
  hiddenReason String?   @map("hidden_reason")

  /// Pin/fijado por admin. Si `pinnedAt != null`, el post va al tope del
  /// feed independientemente del orden elegido. `pinnedById` registra
  /// quién lo fijó para auditoría sin FK cross-module a IAM.
  pinnedAt   DateTime? @map("pinned_at")
  pinnedById String?   @map("pinned_by_id") @db.Uuid

  comments  ModCommunityComment[]
  reactions ModCommunityReaction[]

  @@index([tenantId, courseId, createdAt])
  @@index([tenantId, authorId])
  @@index([tenantId, pinnedAt])
  /// Índice GIN para el filtro de feed por tag (`tags has`), que sin él hace
  /// seq scan sobre el array.
  @@index([tags], type: Gin)
  @@map("mod_community_post")
}

/// Menciones en posts y comments. Una mención apunta a UN usuario y a UN
/// recurso (post o comment). Se persisten al crear el contenido vía parser
/// del body. Sirve para listar "mis menciones" rápido y para notificar.
model ModCommunityMention {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  postId          String?  @map("post_id") @db.Uuid
  commentId       String?  @map("comment_id") @db.Uuid
  mentionedUserId String   @map("mentioned_user_id") @db.Uuid
  /// Handle textual usado al mencionar (ej. "juan" si email = juan@example.com).
  /// Snapshot para que cambios futuros del email no rompan la mención histórica.
  mentionedHandle String   @map("mentioned_handle")
  authorId        String   @map("author_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, mentionedUserId, createdAt])
  @@index([postId])
  @@index([commentId])
  @@map("mod_community_mention")
}

/// Categorías curadas de cursos para el catálogo. Reemplazan al string
/// libre `mod_courses_course.category` (que se mantiene como referencia
/// por nombre para no romper datos existentes). El admin las gestiona
/// desde /admin/cursos/categorias y el builder ofrece un select.
///
/// Multi-categoría con pivote queda como follow-up: el modelo actual
/// soporta una sola categoría por curso (campo `category: string` que
/// matches contra `name`), igual que el patrón de community tags donde
/// `tags` es un array libre y la metadata curada es opcional.
model ModCoursesCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Nombre canónico (ej. "Tecnología", "Liderazgo"). Único por tenant
  /// case-insensitive — la app normaliza al insertar.
  name      String
  /// Color hex 6 dígitos con `#`.
  color     String
  /// Icono opcional del set interno (mismos valores que community tags).
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name], map: "mod_courses_category_tenant_name_key")
  @@index([tenantId])
  @@map("mod_courses_category")
}

/// Comentarios/anotaciones que dejan los alumnos en lecciones. Llegan
/// en estado PENDING y el profesor del curso (o un admin) los aprueba
/// o rechaza. Sólo los APPROVED son visibles al resto de alumnos. El
/// autor siempre ve los suyos (incluyendo PENDING) para que sepa que
/// están esperando moderación.
model ModLearningLessonComment {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  /// ID lógico de la lección. Sin FK cross-module a courses.
  lessonId          String              @map("lesson_id") @db.Uuid
  /// Denormalizado: lo persiste el handler al crear el comentario para
  /// que la cola de pendientes del profesor pueda filtrar por curso sin
  /// lookup adicional a courses.
  courseId          String              @map("course_id") @db.Uuid
  authorId          String              @map("author_id") @db.Uuid
  authorDisplayName String?             @map("author_display_name")
  body              String
  status            LessonCommentStatus @default(PENDING)
  reviewedById      String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?           @map("reviewed_at")
  /// Si el profesor rechaza, opcionalmente un motivo visible al autor.
  rejectionReason   String?             @map("rejection_reason")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")

  @@index([tenantId, lessonId, status])
  @@index([tenantId, courseId, status])
  @@index([tenantId, authorId, status])
  @@map("mod_learning_lesson_comment")
}

enum LessonCommentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Tags curados por el admin del tenant. Cada fila representa un tag
/// "oficial" con metadatos visuales (color, icono) que la UI usa para
/// pintar chips consistentes en el feed y la sidebar.
///
/// La columna `tags` de `ModCommunityPost` sigue siendo un `String[]`
/// libre — los autores pueden seguir tipeando lo que quieran. Los tags
/// curados son simplemente metadata opcional: si un post usa un tag que
/// existe acá, la UI lo pinta con su color/icono; si no, cae al estilo
/// genérico. Esta independencia evita FKs cross-record y permite a los
/// admins añadir/quitar tags sin afectar el contenido histórico.
model ModCommunityTag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Nombre canónico del tag (ej. "ayuda", "anuncios"). Único por tenant
  /// case-insensitive — la app normaliza a minúsculas antes de persistir
  /// para evitar duplicados tipo "Ayuda" / "ayuda".
  name      String
  /// Color hex 6 dígitos con `#` (ej. "#1E5AA8"). La UI lo aplica en el
  /// chip del feed y en el cuadrito de la sidebar. Validado a nivel DTO.
  color     String
  /// Nombre del icono del set interno (ej. "message", "lightbulb"). NULL
  /// = no muestra icono. La UI tolera nombres desconocidos cayendo a un
  /// fallback genérico.
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name], map: "mod_community_tag_tenant_name_key")
  @@index([tenantId])
  @@map("mod_community_tag")
}

/// Preferencias de notificación por usuario de community.
/// v0.1: solo `digestOptOut`. Estructura abierta para sumar prefs sin
/// nuevas migraciones (la fila se upsert siempre).
model ModCommunityUserPref {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  digestOptOut Boolean  @default(false) @map("digest_opt_out")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId], map: "mod_community_user_pref_tenant_user_key")
  @@map("mod_community_user_pref")
}

/// Espacios de comunidad administrables por el admin.
/// Reemplazan el SPACE_META hardcodeado en el frontend.
/// Los 4 espacios de sistema (isSystem=true) son editables pero no eliminables.
model ModCommunitySpace {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  slug        String   @db.VarChar(80)
  title       String
  description String?
  icon        String   @default("#")
  color       String   @default("var(--didacta-trust)")
  sortOrder   Int      @default(0) @map("sort_order")
  isSystem    Boolean  @default(false) @map("is_system")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId, sortOrder])
  @@map("mod_community_space")
}

model ModCommunityComment {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  postId            String    @map("post_id") @db.Uuid
  authorId          String    @map("author_id") @db.Uuid
  body              String
  authorDisplayName String?   @map("author_display_name")
  /// Comentario padre para nested replies (1 nivel de profundidad por
  /// design — los hilos profundos confunden y se moderan peor). NULL para
  /// comentarios root del post.
  parentCommentId   String?   @map("parent_comment_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  /// Moderación, mismo patrón que `ModCommunityPost`.
  hiddenAt     DateTime? @map("hidden_at")
  hiddenById   String?   @map("hidden_by_id") @db.Uuid
  hiddenReason String?   @map("hidden_reason")

  post      ModCommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    ModCommunityComment?   @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies   ModCommunityComment[]  @relation("CommentReplies")
  reactions ModCommunityReaction[]

  @@index([tenantId, postId, createdAt])
  @@index([parentCommentId])
  @@map("mod_community_comment")
}

model ModCommunityReaction {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Solo uno de postId o commentId está poblado.
  postId    String?  @map("post_id") @db.Uuid
  commentId String?  @map("comment_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  /// Emoji corto: "👍", "❤️", "🎉", etc. Limitado a 8 caracteres.
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  post    ModCommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment ModCommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([authorId, postId, emoji])
  @@unique([authorId, commentId, emoji])
  @@index([tenantId, postId])
  @@index([tenantId, commentId])
  @@map("mod_community_reaction")
}

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  channel       NotificationChannel
  templateKey   String              @map("template_key")
  subject       String?
  body          String
  metadata      Json                @default("{}")
  /// Timestamp de lectura por el destinatario (solo aplica a IN_APP).
  readAt        DateTime?           @map("read_at")
  /// Timestamp de despacho del adapter (SMTP enviado, webhook OK, etc.).
  /// Para IN_APP se rellena al persistir, ya que entregar = persistir.
  sentAt        DateTime?           @map("sent_at")
  /// Si el adapter falló (SMTP rebote, webhook 5xx), la razón queda aquí.
  failedAt      DateTime?           @map("failed_at")
  failureReason String?             @map("failure_reason")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([tenantId, userId, readAt])
  @@index([tenantId, channel, sentAt])
  @@map("notification")
}

// ============================================================================
// mod.courses — Catálogo de cursos, módulos y lecciones
// ============================================================================

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  HTML
  PDF
  TEXT
  QUIZ
  SCORM
}

model ModCoursesCourse {
  id                    String       @id @default(uuid()) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  slug                  String
  title                 String
  description           String?
  thumbnailUrl          String?      @map("thumbnail_url")
  /// Imagen y vídeo destacados del hero del curso (mostrados al alumno no
  /// inscrito). El vídeo es una URL de proveedor de streaming (Bunny Stream,
  /// YouTube) o un fichero directo; la imagen se sube al storage del tenant.
  featuredVideoUrl      String?      @map("featured_video_url")
  language              String       @default("es-ES")
  estimatedMinutes      Int?         @map("estimated_minutes")
  status                CourseStatus @default(DRAFT)
  category              String?
  /// URL de una página de ventas externa donde se compra el curso (ej.
  /// "https://va360.academy/curso1"). Si está set, la ficha del curso muestra
  /// el CTA "Comprar" que redirige a esta URL. La inscripción posterior se
  /// realiza vía `POST /api/v1/inscribe` con API key. Null = sin venta externa.
  externalPurchaseUrl   String?      @map("external_purchase_url") @db.VarChar(2048)
  createdById           String?      @map("created_by_id") @db.Uuid
  /// Template de certificado preferido para este curso. Si null, se usa el
  /// default del tenant (mod_certificates_template.is_default = true).
  /// Sin @relation cross-module: es UUID lógico.
  certificateTemplateId String?      @map("certificate_template_id") @db.Uuid
  /// Origen del curso cuando fue importado por un módulo third-party
  /// (ej. "learndash"). Idempotencia con `externalId`. Ver ADR-014.
  externalSource        String?      @map("external_source") @db.VarChar(40)
  externalId            String?      @map("external_id") @db.VarChar(200)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  publishedAt           DateTime?    @map("published_at")
  deletedAt             DateTime?    @map("deleted_at")

  modules ModCoursesModule[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([certificateTemplateId])
  @@index([tenantId, externalSource, externalId], map: "mod_courses_course_external_ref_idx")
  @@map("mod_courses_course")
}

model ModCoursesModule {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  courseId       String    @map("course_id") @db.Uuid
  title          String
  description    String?
  position       Int
  /// Origen de la sección cuando fue importada (ej. "learndash"). Ver ADR-014.
  externalSource String?   @map("external_source") @db.VarChar(40)
  externalId     String?   @map("external_id") @db.VarChar(200)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  course  ModCoursesCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons ModCoursesLesson[]

  @@unique([courseId, position])
  @@index([tenantId, courseId])
  @@index([tenantId, externalSource, externalId], map: "mod_courses_module_external_ref_idx")
  @@map("mod_courses_module")
}

model ModCoursesLesson {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  moduleId        String     @map("module_id") @db.Uuid
  type            LessonType
  title           String
  position        Int
  /// Contenido por tipo: { videoUrl, html, pdfUrl, text, quizId } según LessonType
  content         Json       @default("{}")
  durationMinutes Int?       @map("duration_minutes")
  /// Origen de la lección cuando fue importada (ej. "learndash"). Ver ADR-014.
  externalSource  String?    @map("external_source") @db.VarChar(40)
  externalId      String?    @map("external_id") @db.VarChar(200)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  module ModCoursesModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position])
  @@index([tenantId, moduleId])
  @@index([tenantId, externalSource, externalId], map: "mod_courses_lesson_external_ref_idx")
  @@map("mod_courses_lesson")
}

// ============================================================================
// mod.learning — Matriculación, progreso, finalización
// ============================================================================

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  /// Suspendido temporalmente (típicamente por suscripción impaga). El alumno
  /// no puede acceder a las lecciones hasta que vuelva a ACTIVE. NO se borra
  /// el progreso — si reanuda la suscripción, vuelve donde se quedó.
  PAUSED
}

enum EnrollmentSource {
  ADMIN
  CODE
  INVITATION_LINK
  PURCHASE
  IMPORT
  /// Enrollment activo mientras la suscripción esté ACTIVE. Pausado durante
  /// PAST_DUE→UNPAID y desenrolado al CANCELED inmediato.
  SUBSCRIPTION
  /// Inscripción creada por un sistema externo vía `POST /api/v1/inscribe`
  /// autenticado con API key (compra en una página de ventas de terceros).
  API
}

model ModLearningEnrollment {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  /// ID lógico del curso (sin FK cross-module)
  courseId            String           @map("course_id") @db.Uuid
  status              EnrollmentStatus @default(ACTIVE)
  source              EnrollmentSource @default(ADMIN)
  completionThreshold Int              @default(75) @map("completion_threshold")
  /// Porcentaje de finalización (0-100)
  progressPercent     Int              @default(0) @map("progress_percent")
  enrolledAt          DateTime         @default(now()) @map("enrolled_at")
  startedAt           DateTime?        @map("started_at")
  completedAt         DateTime?        @map("completed_at")
  cancelledAt         DateTime?        @map("cancelled_at")
  /// Origen del enrollment cuando fue importado (ej. "learndash"). Ver ADR-014.
  externalSource      String?          @map("external_source") @db.VarChar(40)
  externalId          String?          @map("external_id") @db.VarChar(200)

  progress ModLearningProgress[]

  @@unique([tenantId, userId, courseId])
  @@index([tenantId, courseId, status])
  @@index([userId, status])
  @@index([tenantId, externalSource, externalId], map: "mod_learning_enrollment_external_ref_idx")
  @@map("mod_learning_enrollment")
}

model ModLearningProgress {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  enrollmentId      String    @map("enrollment_id") @db.Uuid
  /// ID lógico de la lección (sin FK cross-module)
  lessonId          String    @map("lesson_id") @db.Uuid
  /// Tiempo total visto/leído en segundos
  watchedSeconds    Int       @default(0) @map("watched_seconds")
  /// Posición exacta para reanudación (segundo dentro del vídeo, scroll en HTML, etc.)
  resumePositionSec Int       @default(0) @map("resume_position_sec")
  completed         Boolean   @default(false)
  firstAccessedAt   DateTime  @default(now()) @map("first_accessed_at")
  lastAccessedAt    DateTime  @updatedAt @map("last_accessed_at")
  completedAt       DateTime? @map("completed_at")

  enrollment ModLearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([tenantId, lessonId])
  /// Listado de progreso por inscripción (carga del player): filtra por
  /// (tenantId, enrollmentId), antes solo cubierto parcialmente por el unique.
  @@index([tenantId, enrollmentId])
  @@map("mod_learning_progress")
}

model ModLearningInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  /// Código corto para canje manual ("ABCD-1234")
  code        String
  /// Token de URL para enlace único compartible
  token       String    @unique
  /// Cantidad máxima de matriculaciones que puede crear esta invitación (null = ilimitado)
  maxUses     Int?      @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  expiresAt   DateTime? @map("expires_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  @@unique([tenantId, code])
  @@index([tenantId, courseId])
  @@map("mod_learning_invitation")
}

/// HU-FOR-002 — Paquete SCORM importado para una lección de tipo SCORM.
/// Sin FK cross-module: lessonId es UUID lógico de mod_courses_lesson.
/// El paquete se descomprime al subir y los assets se guardan en storage
/// bajo `scorm/{tenantId}/{packageId}/`. `entryPath` es la ruta relativa
/// dentro del paquete que sirve como entry del iframe (típicamente
/// "index.html" o lo que indique el imsmanifest.xml).
model ModLearningScormPackage {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  lessonId      String   @unique @map("lesson_id") @db.Uuid
  /// "1.2" | "2004" — derivado del schemaversion del manifest.
  version       String
  /// Path relativo al asset que se carga primero en el player.
  entryPath     String   @map("entry_path")
  /// Prefijo del storage donde están los assets (ej. "scorm/{tenantId}/{packageId}/").
  storagePrefix String   @map("storage_prefix")
  /// Manifest parseado (organizations, resources, items) para diagnóstico.
  manifest      Json     @default("{}")
  /// Tamaño total descomprimido en bytes.
  size          Int
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  uploadedById  String?  @map("uploaded_by_id") @db.Uuid

  @@index([tenantId])
  @@map("mod_learning_scorm_package")
}

/// Persistencia del state SCORM (cmi.*) por (tenant, user, lesson).
/// 1:1 con la combinación user+lesson — al iniciar una sesión SCORM se hace
/// upsert para reanudar el state previo. Sin FK cross-module: userId y
/// lessonId son UUID lógicos.
model ModLearningScormAttempt {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  packageId        String    @map("package_id") @db.Uuid
  /// Diccionario completo cmi.* (location, suspend_data, score, completion_status, etc.).
  cmiData          Json      @default("{}") @map("cmi_data")
  /// Atajo para indexar/filtrar sin parsear el blob: derivado de cmi.completion_status.
  completionStatus String?   @map("completion_status")
  /// Atajo: cmi.score.scaled (0..1) o cmi.core.score.raw escalado.
  scoreScaled      Float?    @map("score_scaled")
  startedAt        DateTime  @default(now()) @map("started_at")
  lastAccessedAt   DateTime  @default(now()) @map("last_accessed_at")
  completedAt      DateTime? @map("completed_at")

  @@unique([userId, lessonId])
  @@index([tenantId, userId])
  @@index([tenantId, lessonId])
  @@map("mod_learning_scorm_attempt")
}

// ============================================================================
// mod.certificates — Plantillas y emisión de certificados PDF
// ============================================================================

model ModCertificatesTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Nombre legible: "Default", "VA360 oficial", etc.
  name         String
  /// Si true, esta plantilla se usa cuando no hay otra explícita asociada
  isDefault    Boolean  @default(false) @map("is_default")
  /// Texto del cuerpo. Soporta {{alumno}}, {{curso}}, {{fecha}}, {{numero}}
  body         String
  /// Color principal en hex (#RRGGBB) usado en bordes y títulos
  primaryColor String   @default("#0f172a") @map("primary_color")
  /// URL absoluta del logo del tenant (opcional)
  logoUrl      String?  @map("logo_url")
  /// Nombre del firmante (queda en el PDF)
  signerName   String?  @map("signer_name")
  signerTitle  String?  @map("signer_title")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
  @@map("mod_certificates_template")
}

model ModCertificatesIssued {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// IDs lógicos sin FK cross-module
  courseId     String    @map("course_id") @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  templateId   String?   @map("template_id") @db.Uuid
  /// Número correlativo único por tenant
  number       String
  /// Hash SHA-256 del PDF generado (para verificación)
  hash         String
  /// Datos congelados al momento de emisión (alumno, curso, fecha, etc.)
  snapshot     Json      @default("{}")
  /// Path en el storage del PDF generado
  storageKey   String    @map("storage_key")
  /// Tamaño del PDF en bytes
  size         Int
  issuedAt     DateTime  @default(now()) @map("issued_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")

  @@unique([tenantId, number])
  @@unique([tenantId, enrollmentId])
  @@index([userId])
  @@index([courseId])
  @@map("mod_certificates_issued")
}

// ============================================================================
// mod.assessments — Quizzes con auto-corrección de tipos objetivos
// ============================================================================

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_BLANK
  SHORT_ANSWER
  LONG_ANSWER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  /// El alumno envió las respuestas pero el quiz tiene preguntas abiertas
  /// (SHORT_ANSWER / LONG_ANSWER) que requieren corrección manual del formador
  /// antes de poder declarar pasa/no pasa.
  PENDING_REVIEW
  /// Estado final tras corrección manual: scoreEarned/scorePercent/passed
  /// reflejan los puntos asignados por el formador.
  GRADED
  EXPIRED
  ABANDONED
}

model ModAssessmentsQuiz {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  /// ID lógico de la lección a la que pertenece el quiz (sin FK cross-module).
  /// Null mientras se redacta y aún no se ha asociado a ninguna lección.
  lessonId         String?    @map("lesson_id") @db.Uuid
  title            String
  description      String?
  status           QuizStatus @default(DRAFT)
  /// Umbral de aprobación en porcentaje (0-100). Default 60 %.
  passThreshold    Int        @default(60) @map("pass_threshold")
  /// Máximo de intentos por alumno (null = ilimitado).
  maxAttempts      Int?       @map("max_attempts")
  /// Límite de tiempo en minutos (null = sin límite).
  timeLimitMinutes Int?       @map("time_limit_minutes")
  /// Si true, el orden de preguntas y opciones se barajará al iniciar el intento.
  shuffleQuestions Boolean    @default(false) @map("shuffle_questions")
  /// Si true, al terminar el alumno ve la corrección por pregunta.
  showFeedback     Boolean    @default(true) @map("show_feedback")
  createdById      String?    @map("created_by_id") @db.Uuid
  /// Origen del quiz cuando fue importado (ej. "learndash"). Ver ADR-014.
  externalSource   String?    @map("external_source") @db.VarChar(40)
  externalId       String?    @map("external_id") @db.VarChar(200)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  publishedAt      DateTime?  @map("published_at")
  deletedAt        DateTime?  @map("deleted_at")

  questions ModAssessmentsQuestion[]
  attempts  ModAssessmentsAttempt[]

  @@index([tenantId, status])
  @@index([tenantId, lessonId])
  @@index([tenantId, externalSource, externalId], map: "mod_assessments_quiz_external_ref_idx")
  @@map("mod_assessments_quiz")
}

model ModAssessmentsQuestion {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  quizId          String       @map("quiz_id") @db.Uuid
  type            QuestionType
  prompt          String
  /// Texto de feedback opcional que se muestra tras corregir.
  feedback        String?
  position        Int
  /// Puntos que vale la pregunta (default 1).
  points          Int          @default(1)
  /// Lista de respuestas aceptadas para FILL_IN_BLANK. Se compara
  /// case-insensitive y trimmed contra la respuesta del alumno. Vacío
  /// para todos los demás tipos.
  acceptedAnswers String[]     @default([]) @map("accepted_answers")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  quiz    ModAssessmentsQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options ModAssessmentsOption[]

  @@unique([quizId, position])
  @@index([tenantId, quizId])
  @@map("mod_assessments_question")
}

model ModAssessmentsOption {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  label      String
  /// True si esta opción cuenta como respuesta correcta.
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question ModAssessmentsQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@index([tenantId, questionId])
  @@map("mod_assessments_option")
}

model ModAssessmentsAttempt {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  quizId       String        @map("quiz_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  /// IDs lógicos del contexto (sin FK cross-module): la matriculación y la lección
  /// desde las que el alumno está realizando el intento.
  enrollmentId String?       @map("enrollment_id") @db.Uuid
  lessonId     String?       @map("lesson_id") @db.Uuid
  status       AttemptStatus @default(IN_PROGRESS)
  /// Snapshot inmutable del intento al enviarlo: puntos obtenidos, máximos, % y pasa/no pasa.
  scoreEarned  Int?          @map("score_earned")
  scoreMax     Int?          @map("score_max")
  scorePercent Int?          @map("score_percent")
  passed       Boolean?
  startedAt    DateTime      @default(now()) @map("started_at")
  /// Vencimiento del intento si el quiz tenía time limit (start + timeLimit).
  expiresAt    DateTime?     @map("expires_at")
  submittedAt  DateTime?     @map("submitted_at")
  /// Quién (formador / tenant_admin) corrigió las respuestas abiertas y cuándo.
  /// Null mientras el attempt está en PENDING_REVIEW.
  gradedAt     DateTime?     @map("graded_at")
  gradedById   String?       @map("graded_by_id") @db.Uuid

  quiz    ModAssessmentsQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers ModAssessmentsAnswer[]

  @@index([tenantId, quizId, userId])
  @@index([userId, status])
  @@map("mod_assessments_attempt")
}

model ModAssessmentsAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  /// IDs de las opciones marcadas por el alumno (vacío si no respondió).
  /// Solo aplica a SINGLE_CHOICE / MULTIPLE_CHOICE / TRUE_FALSE.
  selectedOptionIds String[] @default([]) @map("selected_option_ids") @db.Uuid
  /// Texto que escribió el alumno. Aplica a FILL_IN_BLANK / SHORT_ANSWER /
  /// LONG_ANSWER.
  textAnswer        String?  @map("text_answer")
  /// Resultado del scoring (rellenado al submit). Para SHORT/LONG_ANSWER
  /// queda en false hasta la corrección manual.
  isCorrect         Boolean  @default(false) @map("is_correct")
  scoreEarned       Int      @default(0) @map("score_earned")
  /// Comentario opcional del formador al corregir (visible al alumno tras
  /// el GRADED).
  gradedFeedback    String?  @map("graded_feedback")
  createdAt         DateTime @default(now()) @map("created_at")

  attempt ModAssessmentsAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([tenantId, attemptId])
  @@map("mod_assessments_answer")
}

// ============================================================================
// MOD.THEMING — branding y personalización visual per-tenant.
// Un único registro por tenant. Override de tokens de design (hue/saturation),
// logo, favicon, fuentes y custom CSS sanitizado. Consumido en SSR por el
// layout root para inyectar variables CSS y propagar a todos los componentes.
// Ver docs/diseño/PANTALLAS-DOGFOODING.md §10 (mod.theming).
// ============================================================================
model ModThemingTenantTheme {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// URL pública del logo principal del tenant. Usado en header y emails.
  /// Si `logoStorageKey` está set, esto apunta al endpoint público de
  /// branding del backend; si no, puede ser una URL externa pegada por el admin.
  logoUrl        String? @map("logo_url")
  /// Key del blob en el StorageService (S3 o disco) cuando el logo se subió
  /// vía el uploader del panel de branding. NULL si el admin pegó una URL
  /// externa directamente.
  logoStorageKey String? @map("logo_storage_key")
  /// MIME type del logo subido (image/png, image/svg+xml, etc.). Necesario
  /// para servir el blob con el Content-Type correcto desde el endpoint público.
  logoMimeType   String? @map("logo_mime_type")
  /// URL del favicon (suele ser cuadrado, 32x32 o 512x512 para PWA).
  faviconUrl     String? @map("favicon_url")

  /// Hue HSL del color primario (0-360). Default 213 (azul confianza Didacta).
  brandHue        Int @default(213) @map("brand_hue")
  /// Saturation del color primario (0-100). Default 70.
  brandSaturation Int @default(70) @map("brand_saturation")

  /// Familia tipográfica display (titulares). Whitelist ['Sora','Inter','Manrope','Space Grotesk','DM Sans','Plus Jakarta Sans'].
  displayFontFamily String @default("Sora") @map("display_font_family")
  /// Familia tipográfica body. Whitelist ['Inter','Manrope','DM Sans','IBM Plex Sans','Source Sans 3','Plus Jakarta Sans'].
  bodyFontFamily    String @default("Inter") @map("body_font_family")

  /// CSS adicional sanitizado (solo CSS variables y selectores seguros).
  /// Limitado a 16 KB. Se inyecta tras los tokens base.
  customCss String? @map("custom_css")

  /// HTML del footer custom (sanitizado). Solo etiquetas básicas: a, p, span, br.
  footerHtml String? @map("footer_html")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mod_theming_tenant_theme")
}

// ============================================================================
// MOD.ZOOM-LIVE — sesiones síncronas Zoom asociadas opcionalmente a un curso.
// El stub de Zoom API guarda meetingId y URLs reales (placeholder en dev).
// startUrl solo se devuelve al host/admin; alumnos ven solo joinUrl.
// ============================================================================
model ModZoomSession {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  courseId                 String?  @map("course_id") @db.Uuid
  /// UUID de la lección concreta del curso a la que está vinculada esta
  /// sesión. NULL = sesión libre del curso. Permite mostrar el botón
  /// "Unirse" en el detalle de la lección.
  lessonId                 String?  @map("lesson_id") @db.Uuid
  topic                    String
  description              String?
  status                   String   @default("SCHEDULED") /// SCHEDULED | STARTED | ENDED | CANCELLED
  startTime                DateTime @map("start_time")
  durationMinutes          Int      @map("duration_minutes")
  timezone                 String
  hostEmail                String   @map("host_email")
  zoomMeetingId            String?  @map("zoom_meeting_id")
  joinUrl                  String?  @map("join_url")
  startUrl                 String?  @map("start_url")
  /// `share_url` de la grabación de Zoom (se rellena al recibir el
  /// webhook `recording.completed`). NULL mientras no haya grabación.
  recordingUrl             String?  @map("recording_url")
  /// Duración total del meeting reportada por Zoom en `recording.completed`
  /// (minutos enteros). NULL si todavía no hay grabación.
  recordingDurationMinutes Int?     @map("recording_duration_minutes")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([tenantId, startTime(sort: Desc)], map: "mod_zoom_session_tenant_idx")
  @@index([courseId], map: "mod_zoom_session_course_idx")
  @@index([lessonId], map: "mod_zoom_session_lesson_idx")
  @@map("mod_zoom_session")
}

/// Registro de eventos webhook recibidos de Zoom para idempotencia.
/// Zoom reintenta cada evento hasta 3 veces si no recibe 2xx en 3s, así
/// que necesitamos detectar duplicados por `event_id` antes de aplicar
/// el efecto. `result` indica cómo se procesó (OK, IGNORED si no
/// matcheaba ninguna sesión, ERROR si falló al actualizar).
model ModZoomWebhookEvent {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @unique @map("event_id")
  eventType    String   @map("event_type")
  meetingId    String?  @map("meeting_id")
  sessionId    String?  @map("session_id") @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  receivedAt   DateTime @default(now()) @map("received_at")
  result       String   @default("OK") /// OK | IGNORED | ERROR
  errorMessage String?  @map("error_message")

  @@index([meetingId], map: "mod_zoom_webhook_event_meeting_idx")
  @@index([sessionId], map: "mod_zoom_webhook_event_session_idx")
  @@map("mod_zoom_webhook_event")
}

// ============================================================================
// MOD.FUNDAE.BLOCK — módulos formativos (bloques) que componen una acción.
// Cada acción puede desglosarse en N bloques con horas, contenidos y modalidad
// propia. Útil para acciones mixtas (presencial + teleformación) donde Fundae
// pide reportar cada bloque por separado en el XML.
// ============================================================================
model ModFundaeBlock {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actionId   String   @map("action_id") @db.Uuid
  /// Orden secuencial dentro de la acción (1..N). Unique por action_id.
  ordinal    Int
  title      String   @db.VarChar(200)
  /// Horas del bloque (acepta decimales: 0.5, 1.5...).
  hours      Float
  /// Modalidad propia del bloque. Puede diferir de la acción.
  modalidad  String /// PRESENCIAL | TELEFORMACION | MIXTA
  /// Contenidos del bloque (texto libre).
  contenidos String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([actionId, ordinal], map: "mod_fundae_block_action_ordinal_key")
  @@index([tenantId, actionId], map: "mod_fundae_block_tenant_action_idx")
  @@map("mod_fundae_block")
}

// ============================================================================
// MOD.FUNDAE — acciones formativas para subvenciones Fundae España.
// `codigo_accion` único por tenant. Fechas como TEXT YYYY-MM-DD para
// preservar el formato del input sin convertir a UTC. El XML de export
// se genera on-demand desde estas filas.
// ============================================================================
model ModFundaeAction {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  courseId       String?  @map("course_id") @db.Uuid
  codigoAccion   String   @map("codigo_accion")
  nombre         String
  modalidad      String /// PRESENCIAL | TELEFORMACION | MIXTA
  horasFormacion Float    @map("horas_formacion")
  fechaInicio    String   @map("fecha_inicio") /// YYYY-MM-DD
  fechaFin       String   @map("fecha_fin") /// YYYY-MM-DD
  lugar          String?
  cifCentro      String?  @map("cif_centro")
  notas          String?
  status         String   @default("DRAFT") /// DRAFT | ACTIVE | CLOSED | ARCHIVED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, codigoAccion], map: "mod_fundae_action_codigo_per_tenant_idx")
  @@index([tenantId, fechaInicio(sort: Desc)], map: "mod_fundae_action_tenant_inicio_idx")
  @@index([courseId], map: "mod_fundae_action_course_idx")
  @@map("mod_fundae_action")
}

// ============================================================================
// MOD.FUNDAE.COMPANY — empresa bonificada que financia la formación con
// crédito Fundae. Cada grupo formativo bonificable se ata a una de estas
// (LMS-79). El NIF es la clave funcional dentro del tenant; soporte de
// validación checksum vive en `validateSpanishTaxId` (modules/fundae).
//
// `creditoTotalCents` y `creditoUsadoCents` se almacenan en céntimos para
// evitar errores de redondeo al cuadrar costes con Fundae. `cccPrincipal`
// es el Código Cuenta Cotización (formato 11 dígitos sin guiones; aquí
// guardamos como string para conservar ceros líderes).
// ============================================================================
model ModFundaeCompany {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  /// NIF español (DNI / NIE / CIF). Normalizado en mayúsculas sin
  /// separadores. Único por tenant para evitar duplicar empresa cuando
  /// dos admins la dan de alta a la vez.
  nif               String    @db.VarChar(20)
  razonSocial       String    @map("razon_social") @db.VarChar(200)
  /// Código Cuenta Cotización principal — 11 dígitos como string para
  /// preservar ceros a la izquierda. Opcional: empresa puede tener varios
  /// CCCs y registrarlos al inicio de un grupo concreto.
  cccPrincipal      String?   @map("ccc_principal") @db.VarChar(15)
  /// Nº de empleados de plantilla a fecha del alta. Necesario para
  /// validar % de bonificación máxima permitido por Fundae.
  plantilla         Int?
  /// Crédito Fundae anual disponible en céntimos.
  creditoTotalCents Int?      @map("credito_total_cents")
  /// Crédito ya consumido en grupos cerrados (céntimos). El servicio lo
  /// suma al cerrar grupos; nunca se decrementa.
  creditoUsadoCents Int       @default(0) @map("credito_usado_cents")
  /// Datos de contacto + dirección — JSON libre para permitir evolución
  /// sin migración cada vez (calle, ciudad, CP, persona contacto, email,
  /// teléfono). Validado por Zod en el service.
  datosContacto     Json      @default("{}") @map("datos_contacto")
  /// Notas internas del admin (no se exponen a empresa_manager).
  notas             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  /// Soft-delete. Conservamos la fila para integridad histórica de
  /// grupos cerrados aunque el admin "borre" la empresa.
  deletedAt         DateTime? @map("deleted_at")

  @@unique([tenantId, nif], map: "mod_fundae_company_tenant_nif_key")
  @@index([tenantId, deletedAt], map: "mod_fundae_company_tenant_deleted_idx")
  @@index([tenantId, razonSocial], map: "mod_fundae_company_tenant_razon_idx")
  @@map("mod_fundae_company")
}

// ============================================================================
// MOD.FUNDAE.RLPT — notificaciones a la Representación Legal de Personas
// Trabajadoras (LMS-80). Para que un grupo bonificable pueda iniciarse,
// la empresa tiene que haber notificado a la RLPT con la antelación
// mínima exigida por el RD 694/2017 (15 días naturales). El acuse de la
// RLPT y eventuales actas de discrepancia se guardan como subtipos del
// mismo modelo, todos vinculados a la empresa por `companyId` (FK
// lógica — no FK física por la regla del proyecto de no-cross-module-FK).
//
// El blob (PDF firmado, escaneo del acuse) se persiste en
// `evidence_vault_entry` con hash SHA-256; aquí guardamos sólo la
// referencia + metadata. El hook `fundae.group.before-start` consulta
// que exista al menos una NOTIFICACION_INICIAL con `plazoVencimientoAt`
// pasada antes de permitir iniciar un grupo.
// ============================================================================
model ModFundaeRlptNotice {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  /// FK lógica a `mod_fundae_company.id`. Sin FK física por la regla
  /// de aislamiento de módulos.
  companyId           String    @map("company_id") @db.Uuid
  /// Tipo de notificación.
  ///   - NOTIFICACION_INICIAL: notificación previa al inicio del grupo.
  ///   - ACUSE_RECIBO: respuesta de la RLPT confirmando recepción.
  ///   - ACTA_DISCREPANCIA: cuando la RLPT formaliza desacuerdo; permite
  ///     avanzar el grupo igualmente con la traza documentada.
  tipo                String /// NOTIFICACION_INICIAL | ACUSE_RECIBO | ACTA_DISCREPANCIA
  /// Fecha en que se notificó / recibió. ISO 8601 string para preservar
  /// la zona horaria del usuario (Madrid en la mayoría de casos).
  fechaNotificacionAt DateTime  @map("fecha_notificacion_at")
  /// Plazo en el que vence la antelación legal mínima. Para
  /// NOTIFICACION_INICIAL se calcula como `fechaNotificacionAt + 15 días`.
  /// El hook compara `now() >= plazoVencimientoAt` para autorizar el
  /// inicio del grupo. Para los otros tipos suele coincidir con la
  /// fecha de notificación.
  plazoVencimientoAt  DateTime  @map("plazo_vencimiento_at")
  /// Referencia al artefacto subido. Apunta a evidence_vault_entry.id —
  /// FK física porque es el mismo módulo core (Evidence Vault) y la
  /// integridad referencial protege contra eliminaciones accidentales
  /// del blob.
  evidenceEntryId     String    @map("evidence_entry_id") @db.Uuid
  /// Notas internas (no van a Fundae).
  observaciones       String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  evidence EvidenceVaultEntry @relation(fields: [evidenceEntryId], references: [id])

  @@index([tenantId, companyId, tipo], map: "mod_fundae_rlpt_tenant_company_tipo_idx")
  @@index([tenantId, companyId, fechaNotificacionAt(sort: Desc)], map: "mod_fundae_rlpt_tenant_company_fecha_idx")
  @@index([evidenceEntryId], map: "mod_fundae_rlpt_evidence_idx")
  @@map("mod_fundae_rlpt_notice")
}

// ============================================================================
// MOD.FUNDAE.GROUP — grupo formativo bonificable (LMS-81). Vincula una
// acción formativa Fundae (mod_fundae_action) con la empresa que financia
// la bonificación (mod_fundae_company), y materializa el ciclo de vida
// del grupo: DRAFT → ACTIVE → CLOSED. La transición DRAFT → ACTIVE pasa
// por `FundaeRlptService.assertGroupCanStart`, que rechaza si la empresa
// no notificó a la RLPT con la antelación legal.
//
// `creditoEstimadoCents` se cobra del crédito Fundae de la empresa al
// pasar a ACTIVE; al cerrar, el service ajusta `credito_usado_cents`
// con `creditoConsumidoCents` definitivo (suma de todos los costes
// directos/indirectos/organización).
// ============================================================================
model ModFundaeGroup {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  /// FK lógica a `mod_fundae_action.id` (sin FK física por la regla de
  /// aislamiento de módulos — son submódulos del mismo `mod.fundae`,
  /// pero conviene mantener el patrón homogéneo).
  actionId              String    @map("action_id") @db.Uuid
  /// FK lógica a `mod_fundae_company.id`.
  companyId             String    @map("company_id") @db.Uuid
  /// Identificador interno del grupo dentro de la acción. Único por
  /// acción; suele coincidir con el `numeroGrupo` que pide Fundae al
  /// presentar el grupo (1..N).
  numeroGrupo           Int       @map("numero_grupo")
  modalidad             String /// PRESENCIAL | TELEFORMACION | MIXTA
  fechaInicioPrevista   DateTime  @map("fecha_inicio_prevista")
  fechaFinPrevista      DateTime  @map("fecha_fin_prevista")
  /// Fecha real en que se inició el grupo (null hasta el start).
  fechaInicioReal       DateTime? @map("fecha_inicio_real")
  /// Fecha real de cierre del grupo (null hasta el close).
  fechaFinReal          DateTime? @map("fecha_fin_real")
  /// Estado del ciclo de vida.
  status                String    @default("DRAFT") /// DRAFT | ACTIVE | CLOSED | CANCELLED
  /// Crédito estimado a consumir cuando se planificó. En céntimos.
  creditoEstimadoCents  Int?      @map("credito_estimado_cents")
  /// Umbral de finalización Fundae (default 75%). Se aplica al cálculo
  /// de resultado APTO/NO_APTO por participante (LMS-84).
  umbralFinalizacionPct Int       @default(75) @map("umbral_finalizacion_pct")
  notas                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  costs        ModFundaeCost[]
  participants ModFundaeGroupParticipant[]

  @@unique([tenantId, actionId, numeroGrupo], map: "mod_fundae_group_action_numero_key")
  @@index([tenantId, companyId, status], map: "mod_fundae_group_tenant_company_status_idx")
  @@index([tenantId, actionId, status], map: "mod_fundae_group_tenant_action_status_idx")
  @@index([tenantId, status, fechaInicioPrevista(sort: Desc)], map: "mod_fundae_group_tenant_status_fecha_idx")
  @@map("mod_fundae_group")
}

// ============================================================================
// MOD.FUNDAE.COST — desglose de costes del grupo (LMS-81). Fundae exige
// el desglose por categoría para validar la bonificación: directos
// (formación, materiales, alquiler de aulas, formadores), indirectos
// (administración, gestión) y organización (limitados al 10%).
//
// Importes en céntimos (Int) para evitar drift de coma flotante al
// sumar. Los costes son inmutables una vez cerrado el grupo: el service
// rechaza creates/updates si el grupo está en CLOSED.
// ============================================================================
model ModFundaeCost {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  tipo        String /// DIRECTO | INDIRECTO | ORGANIZACION
  /// Concepto facturable (ej: "Formador externo Juan Pérez", "Alquiler
  /// aula Madrid", "Material didáctico").
  concepto    String   @db.VarChar(200)
  amountCents Int      @map("amount_cents")
  /// Notas opcionales (referencia a factura externa, proveedor).
  notas       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  group ModFundaeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([tenantId, groupId, tipo], map: "mod_fundae_cost_tenant_group_tipo_idx")
  @@index([groupId], map: "mod_fundae_cost_group_idx")
  @@map("mod_fundae_cost")
}

// ============================================================================
// MOD.FUNDAE.GROUP_PARTICIPANT — matriculación nominal de alumnos en un
// grupo bonificable Fundae (LMS-82). Aunque el alumno también está
// matriculado en el curso del catálogo (vía `course_enrollment`), el grupo
// Fundae necesita un registro propio porque:
//
//   1. La comunicación de inicio Fundae exige listado nominal por grupo
//      (no por curso).
//   2. La empresa bonificada se vincula a través del grupo, no del curso.
//   3. Un alumno puede pertenecer a varios grupos del mismo curso (ediciones
//      sucesivas de la formación).
//
// Borrado lógico vía `status = REMOVED` para mantener trazabilidad de
// matriculaciones canceladas (Fundae las exige en el expediente).
// ============================================================================
model ModFundaeGroupParticipant {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  groupId         String    @map("group_id") @db.Uuid
  /// FK lógica a `app_user.id`.
  userId          String    @map("user_id") @db.Uuid
  /// Empresa bonificada del grupo, denormalizada para acelerar reportes
  /// agregados por empresa sin tener que hacer join al grupo.
  companyId       String    @map("company_id") @db.Uuid
  /// Snapshot del NIF del alumno en el momento de matriculación (el campo
  /// `app_user.documentId` puede cambiar; Fundae exige fijar el NIF que
  /// se comunicó en su día).
  nifAlumno       String?   @map("nif_alumno")
  enrolledAt      DateTime  @default(now()) @map("enrolled_at")
  removedAt       DateTime? @map("removed_at")
  status          String    @default("ENROLLED") /// ENROLLED | REMOVED
  /// Horas reales de asistencia (LMS-84). Se calcula como
  /// `action.horasFormacion * progressPercent / 100`. Decimal para
  /// medias horas Fundae (0.5).
  horasAsistidas  Decimal?  @map("horas_asistidas") @db.Decimal(8, 2)
  /// Progreso del enrollment del curso (0-100) capturado en el momento
  /// del cálculo de finalización.
  progressPercent Int?      @map("progress_percent")
  /// Resultado final Fundae: APTO si supera el umbral (default 75%),
  /// NO_APTO si fue eliminado o no llegó al umbral, EN_CURSO antes
  /// de la finalización.
  resultado       String? /// APTO | NO_APTO | EN_CURSO
  /// Fecha del cálculo de finalización (cuando se snapshoteó el
  /// resultado). Distinto de `removedAt` que indica baja administrativa.
  completedAt     DateTime? @map("completed_at")
  notas           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  group ModFundaeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([tenantId, groupId, userId], map: "mod_fundae_group_participant_group_user_key")
  @@index([tenantId, groupId, status], map: "mod_fundae_group_participant_group_status_idx")
  @@index([tenantId, companyId, status], map: "mod_fundae_group_participant_company_status_idx")
  @@index([tenantId, userId], map: "mod_fundae_group_participant_tenant_user_idx")
  @@map("mod_fundae_group_participant")
}

// ============================================================================
// PASSWORD RESET TOKENS — flujo de "olvidé mi contraseña" para self-service.
// El token raw viaja solo en email; la DB guarda SHA-256 (no se puede recuperar
// el original aunque se filtre el dump). TTL 1h. Single-use (usedAt).
// ============================================================================
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  /// SHA-256 hex del token raw. El token raw solo se conoce en el momento de
  /// crearlo y se entrega por email — nunca se persiste en claro.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  /// Vencimiento absoluto (default +1h). Más allá se rechaza con un error
  /// específico para que la UI pida regenerar.
  expiresAt DateTime  @map("expires_at")
  /// Marca de uso (single-use). Al consumirse se invalida.
  usedAt    DateTime? @map("used_at")
  /// IP + UA al solicitar para audit log (si llega rate-limit / ataque).
  requestIp String?   @map("request_ip")
  requestUa String?   @map("request_ua")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

// ============================================================================
// INSCRIPCIÓN DE MIEMBROS — gate Telegram + OTP email + validación manual.
// Migración de la comunidad de Telegram de VA360 a Didacta "con control".
// Patrón de tokens clonado de PasswordResetToken (SHA-256, single-use, TTL).
// Fuente de verdad documental: PRD en Notion (LMS Ship).
// ============================================================================

/// Código OTP de verificación de email (6 dígitos) del paso 1.5 de inscripción,
/// ANTES de crear el User PENDING. Indexado por (tenant, email) porque aún no
/// existe User. Se guarda SHA-256 del código (nunca en claro), TTL corto,
/// single-use y con contador de intentos. El código viaja solo por email.
model EmailVerificationCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  email     String
  /// SHA-256 hex del código de 6 dígitos.
  codeHash  String    @map("code_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)
  requestIp String?   @map("request_ip")
  requestUa String?   @map("request_ua")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId, email])
  @@index([expiresAt])
  @@map("email_verification_code")
}

enum MemberDecisionAction {
  APPROVE
  REJECT
}

/// Tokens firmados de un solo uso para que el aprobador decida una inscripción
/// PENDING desde el email (1 click). Se generan DOS por inscripción (APPROVE +
/// REJECT); al consumir cualquiera se sella `decidedAt` de AMBOS en la misma
/// transacción que el cambio de status del User. TTL ~7 días. El raw del token
/// viaja solo por email; en BD solo el SHA-256.
model MemberRegistrationDecisionToken {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  action    MemberDecisionAction
  tokenHash String               @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime             @map("expires_at")
  decidedAt DateTime?            @map("decided_at")
  requestIp String?              @map("request_ip")
  requestUa String?              @map("request_ua")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("member_registration_decision_token")
}

/// Lista de referencia de estado de pago de miembros, gestionada por el admin
/// (panel /admin/impagos: alta manual + import CSV). El join con la inscripción
/// es lógico por `telegram_id` dentro del mismo tenant (sin FK). Permite mostrar
/// "consta como impago" en la ficha/email de aprobación. Dato real del admin,
/// nunca hardcodeado (regla #3).
model MemberPaymentFlag {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  telegramId   String   @map("telegram_id") @db.VarChar(32)
  name         String?
  isDelinquent Boolean  @default(true) @map("is_delinquent")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, telegramId], map: "member_payment_flag_tenant_tg_key")
  @@index([tenantId, isDelinquent])
  @@map("member_payment_flag")
}

// ============================================================================
// AI GATEWAY — configuración multi-provider por tenant (LMS-90.B).
//
// Cada fila vincula un (tenant, purpose) con un provider concreto + sus
// credenciales. La `apiKey` se cifra antes de persistir (AES-256-GCM con
// clave maestra del cluster en `AI_CONFIG_ENCRYPTION_KEY`); en runtime se
// descifra solo cuando el gateway necesita hacer una llamada.
//
// Si un tenant no tiene fila para un purpose, el gateway usa el default
// global de env (`DEFAULT_AI_<PURPOSE>_PROVIDER` + `DEFAULT_AI_<PURPOSE>_API_KEY`).
//
// `purpose` separa chat y embed para que el tenant pueda mezclar (p.ej.
// Anthropic para chat + Voyage para embeddings, que es una combinación común).
// ============================================================================
model TenantAiProviderConfig {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// 'chat' | 'embed'. Único por tenant+purpose.
  purpose      String
  /// Identificador del provider (openai, anthropic, gemini, openrouter,
  /// mistral, groq, ollama, voyage).
  provider     String
  /// Modelo concreto. Vacío = usa default del adapter.
  model        String   @default("")
  /// Clave API cifrada con AES-256-GCM. NUNCA en plaintext.
  apiKeyCipher String   @map("api_key_cipher")
  /// IV usado para cifrar (96 bits hex). Único por fila.
  apiKeyIv     String   @map("api_key_iv")
  /// Auth tag GCM (128 bits hex).
  apiKeyTag    String   @map("api_key_tag")
  /// Override de URL base (autoalojado, proxy corporativo, etc.).
  baseUrl      String?  @map("base_url")
  /// Headers extra como JSON (algunos providers exigen referer, etc.).
  extraHeaders Json     @default("{}") @map("extra_headers")
  /// Si false, el gateway omite esta config y va al fallback default global.
  enabled      Boolean  @default(true)
  /// Notas internas del admin (motivo del provider elegido, fecha contrato).
  notas        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, purpose], map: "tenant_ai_provider_config_tenant_purpose_key")
  @@index([tenantId], map: "tenant_ai_provider_config_tenant_idx")
  @@map("tenant_ai_provider_config")
}

// ============================================================================
// MOD.AI-TUTOR — Tutor IA por curso con RAG (LMS-90, Fase 1.C).
//
// `mod_ai_tutor_chunk` almacena fragmentos de contenido de las lecciones
// indexados con embeddings (pgvector 1536 dim). El query de búsqueda es
// cosine similarity vía SQL raw (Prisma todavía no soporta el operador `<=>`
// nativamente; usamos $queryRaw en el service).
//
// `mod_ai_tutor_conversation` y `mod_ai_tutor_message` mantienen el histórico
// de chat por (alumno, curso). El context window incluye las últimas N
// mensajes para que el alumno pueda hacer follow-ups.
//
// `mod_ai_tutor_token_usage` agrega tokens consumidos por (tenant, user, día)
// para enforce de cuota.
// ============================================================================

model ModAiTutorChunk {
  id          String                      @id @default(uuid()) @db.Uuid
  tenantId    String                      @map("tenant_id") @db.Uuid
  /// FK lógica a mod_courses_course.id.
  courseId    String                      @map("course_id") @db.Uuid
  /// FK lógica a mod_courses_lesson.id. Null si es chunk de metadata del curso
  /// (descripción general, objetivos) sin lección concreta.
  lessonId    String?                     @map("lesson_id") @db.Uuid
  /// Posición del chunk dentro de su origen (lesson o curso).
  ordinal     Int
  /// Texto del chunk (UTF-8). Lo usamos al construir el prompt.
  content     String
  /// Embedding vectorial. Dimensión depende del provider (1536 para
  /// OpenAI text-embedding-3-small / ada-002; otros providers requieren
  /// migración del schema).
  embedding   Unsupported("vector(1536)")
  /// Aproximación de tokens del content (para presupuesto del prompt).
  tokensCount Int                         @map("tokens_count")
  createdAt   DateTime                    @default(now()) @map("created_at")

  @@index([tenantId, courseId, ordinal], map: "mod_ai_tutor_chunk_tenant_course_ordinal_idx")
  @@index([tenantId, courseId, lessonId], map: "mod_ai_tutor_chunk_tenant_course_lesson_idx")
  @@map("mod_ai_tutor_chunk")
}

model ModAiTutorConversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  /// Resumen corto generado por el modelo cada N mensajes para no perder
  /// contexto al desbordar el context window. Null en conversaciones nuevas.
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ModAiTutorMessage[]

  @@index([tenantId, userId, courseId], map: "mod_ai_tutor_conversation_tenant_user_course_idx")
  @@map("mod_ai_tutor_conversation")
}

model ModAiTutorMessage {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  /// 'user' | 'assistant'
  role           String
  content        String
  /// Citas que el assistant generó: array de { lessonId, chunkOrdinal }.
  citations      Json     @default("[]")
  /// Tokens consumidos (solo para mensajes del assistant, calculados al recibir).
  tokensInput    Int      @default(0) @map("tokens_input")
  tokensOutput   Int      @default(0) @map("tokens_output")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ModAiTutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "mod_ai_tutor_message_conv_created_idx")
  @@map("mod_ai_tutor_message")
}

model ModAiTutorTokenUsage {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Null para agregados a nivel tenant (sin desglose por user).
  userId       String?  @map("user_id") @db.Uuid
  /// Día calendario UTC (YYYY-MM-DD). Para queries por rango.
  day          DateTime @db.Date
  tokensInput  Int      @default(0) @map("tokens_input")
  tokensOutput Int      @default(0) @map("tokens_output")
  /// Coste estimado en céntimos de USD según pricing del provider al momento.
  costCents    Int      @default(0) @map("cost_cents")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId, day], map: "mod_ai_tutor_token_usage_tenant_user_day_key")
  @@index([tenantId, day], map: "mod_ai_tutor_token_usage_tenant_day_idx")
  @@map("mod_ai_tutor_token_usage")
}

// ─── mod.ai-grader · LMS-91 ──────────────────────────────────────────
//
// Rúbrica + sugerencias IA para corrección de respuestas abiertas.
// La rúbrica vive a nivel de pregunta (1:1 con ModAssessmentsQuestion para
// SHORT_ANSWER / LONG_ANSWER). Las suggestions se persisten para auditoría
// y para que el formador pueda volver a verlas sin re-llamar al modelo.

model ModAiGraderRubric {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Pregunta evaluada. Aplica solo a SHORT_ANSWER / LONG_ANSWER.
  questionId   String   @unique @map("question_id") @db.Uuid
  instructions String
  /// Array de criterios con nombre + descripción + peso. Validado a nivel
  /// service contra Σweights = question.points.
  criteria     Json
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId], map: "mod_ai_grader_rubric_tenant_idx")
  @@map("mod_ai_grader_rubric")
}

model ModAiGraderSuggestion {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  attemptId       String   @map("attempt_id") @db.Uuid
  answerId        String   @map("answer_id") @db.Uuid
  questionId      String   @map("question_id") @db.Uuid
  /// Score total propuesto (Σ scores de perCriterion). 0 ≤ x ≤ question.points.
  proposedScore   Int      @map("proposed_score")
  /// Desglose por criterio: [{ name, score, justification }]. Lectura UI.
  perCriterion    Json     @map("per_criterion")
  overallFeedback String   @map("overall_feedback")
  provider        String
  model           String
  /// True cuando el formador aplicó la sugerencia vía gradeAttempt.
  applied         Boolean  @default(false)
  /// User id del formador que aplicó (null mientras esté en draft).
  appliedById     String?  @map("applied_by_id") @db.Uuid
  appliedAt       DateTime? @map("applied_at")
  createdAt       DateTime @default(now()) @map("created_at")

  /// Una sugerencia por (attempt, answer): regenerar reemplaza la anterior.
  @@unique([attemptId, answerId], map: "mod_ai_grader_suggestion_attempt_answer_key")
  @@index([tenantId, attemptId], map: "mod_ai_grader_suggestion_tenant_attempt_idx")
  @@map("mod_ai_grader_suggestion")
}

// ============================================================================
// CORE — INSTALLATION REGISTRY (opt-in, MIG-027)
// ----------------------------------------------------------------------------
// Registro opt-in de la instalación Community contra Cloud god (didacta.io).
// Permite al admin activar comunicación directa con el equipo Didacta y enviar
// telemetría agregada (sin PII). Singleton lógico: solo una fila NO-opted-out
// a la vez.
// ============================================================================

model InstallationRegistry {
  id                String    @id @default(uuid()) @db.Uuid
  /// UUID generado en cliente al hacer opt-in. Identifica esta instancia
  /// frente a Cloud god a perpetuidad.
  installationId    String    @unique @map("installation_id")
  email             String
  organizationName  String    @map("organization_name")
  /// URL pública del despliegue, opcional. Solo informativa.
  deploymentUrl     String?   @map("deployment_url")
  /// Token opaco devuelto por Cloud god tras /registry/install.
  registryToken     String?   @map("registry_token")
  /// Aceptación de términos por el admin.
  termsAcceptedAt   DateTime  @map("terms_accepted_at")
  optInAt           DateTime  @default(now()) @map("opt_in_at")
  /// Fecha de opt-out (null mientras esté activo).
  optedOutAt        DateTime? @map("opted_out_at")
  /// Última vez que la instancia envió telemetría agregada.
  lastTelemetryAt   DateTime? @map("last_telemetry_at")
  /// Permite desactivar el envío de telemetría manteniendo registro.
  telemetryEnabled  Boolean   @default(true) @map("telemetry_enabled")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("core_installation_registry")
}

// ============================================================================
// mod.billing — Stripe checkout MVP (pago único)
// ============================================================================

enum BillingOrderStatus {
  /// Sesión de Checkout creada en Stripe, esperando que el alumno pague.
  PENDING
  /// Pago confirmado vía webhook checkout.session.completed.
  COMPLETED
  /// Sesión expirada o cancelada por el alumno antes de pagar.
  CANCELLED
  /// Pago rechazado o falló (ej. tarjeta declinada).
  FAILED
  /// Reembolsado tras COMPLETED. Mantenemos el order pero con este estado.
  REFUNDED
}

/// Vincula un curso a un Stripe Price. Un tenant puede tener varios productos
/// (uno por curso). MVP: un único stripePriceId por curso.
model ModBillingProduct {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  /// ID lógico del curso. Sin FK cross-module (regla del contrato modular).
  courseId        String   @map("course_id") @db.Uuid
  /// Stripe Product ID (prod_...). Se crea desde el admin panel o se importa.
  stripeProductId String   @map("stripe_product_id")
  /// Stripe Price ID (price_...). MVP: único por producto.
  stripePriceId   String   @map("stripe_price_id")
  /// Importe declarado en la moneda más pequeña (céntimos en EUR/USD).
  /// Coincide con price.unit_amount de Stripe; cacheado aquí para listados.
  unitAmount      Int      @map("unit_amount")
  /// ISO 4217 lowercase (eur, usd, gbp...).
  currency        String   @default("eur")
  /// Si false, el botón Comprar no aparece en el curso.
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, courseId])
  @@unique([tenantId, stripePriceId])
  @@index([tenantId, active])
  @@map("mod_billing_product")
}

/// Una orden de compra de un alumno por un producto. Se crea al iniciar la
/// Checkout Session y se actualiza vía webhook.
model ModBillingOrder {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  productId       String             @map("product_id") @db.Uuid
  courseId        String             @map("course_id") @db.Uuid
  /// Stripe Checkout Session ID (cs_...). Único globalmente.
  stripeSessionId String             @unique @map("stripe_session_id")
  status          BillingOrderStatus @default(PENDING)
  /// Importe pagado (en céntimos). Se rellena al recibir webhook completed.
  amountPaid      Int?               @map("amount_paid")
  currency        String             @default("eur")
  /// Email del comprador según Stripe (puede diferir del email del user).
  customerEmail   String?            @map("customer_email")
  completedAt     DateTime?          @map("completed_at")
  refundedAt      DateTime?          @map("refunded_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([courseId])
  @@map("mod_billing_order")
}

/// Persistencia de eventos webhook de Stripe para idempotencia. Antes de
/// procesar cualquier evento, verificamos que su id no esté ya en la tabla.
/// Stripe reintenta hasta 3 días; sin esta tabla, un alumno se enrollaría
/// múltiples veces si Stripe duplica.
model ModBillingWebhookEvent {
  /// Stripe event id (evt_...). PK natural — Stripe garantiza unicidad global.
  stripeEventId String    @id @map("stripe_event_id")
  tenantId      String?   @map("tenant_id") @db.Uuid
  type          String
  /// Si el procesamiento creó/actualizó alguna orden, la referenciamos.
  orderId       String?   @map("order_id") @db.Uuid
  /// Payload original (sin PII fuera de email).
  payload       Json      @default("{}")
  errorMessage  String?   @map("error_message")
  receivedAt    DateTime  @default(now()) @map("received_at")
  processedAt   DateTime? @map("processed_at")

  @@index([type])
  @@index([tenantId, receivedAt])
  @@map("mod_billing_webhook_event")
}

// ============================================================================
// mod.subscriptions — Suscripciones recurrentes con Stripe
// ----------------------------------------------------------------------------
// Extiende el modelo de mod.billing (pago único) con suscripciones recurrentes:
// el alumno paga mensual/anual y mientras el subscription esté ACTIVE el
// SubscriptionsLearningBridge mantiene el enrollment vivo. Si el invoice falla,
// arranca un grace period configurable (default 3 días); si el grace expira sin
// pago, el bridge pausa el enrollment. Si el subscription se cancela, el
// bridge desenrolla.
//
// Sin FK cross-module: courseId es un ID lógico (igual que mod.billing). La
// integración con mod.learning vive 100% por eventos.
// ============================================================================

enum SubscriptionStatus {
  /// Sesión Checkout creada, esperando que Stripe nos confirme la suscripción.
  PENDING
  /// Suscripción activa — invoice del periodo actual pagado.
  ACTIVE
  /// Invoice del periodo actual falló. Estamos en grace period: el alumno
  /// sigue con acceso hasta `gracePeriodEndsAt`. Si Stripe cobra antes,
  /// volvemos a ACTIVE; si no, pasamos a UNPAID y el bridge pausa.
  PAST_DUE
  /// Grace period expirado sin pago. Sin acceso al curso hasta que el alumno
  /// actualice método de pago y Stripe cobre.
  UNPAID
  /// Cancelada definitivamente (por alumno o admin). El bridge desenrolla.
  CANCELED
}

enum SubscriptionInvoiceStatus {
  /// Generada por Stripe, sin cobrar todavía (auto-collection en curso).
  OPEN
  /// Cobrada con éxito.
  PAID
  /// Stripe agotó los reintentos (típicamente 4 attempts en 1 semana).
  UNCOLLECTIBLE
  /// Cancelada (alumno canceló sub antes de que se cobrara).
  VOID
}

/// Una suscripción recurrente de un alumno a un curso.
///
/// Cada (tenantId, userId, courseId) tiene como máximo UNA suscripción activa.
/// Si el alumno cancela y se vuelve a suscribir, se crea un nuevo row en lugar
/// de reactivar el anterior — así el historial queda completo para auditoría.
model ModSubscriptionsSubscription {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  /// ID lógico del curso. Sin FK cross-module.
  courseId             String             @map("course_id") @db.Uuid
  /// Stripe Subscription ID (sub_...). Único globalmente — vacío durante el
  /// breve hueco entre creación local en PENDING y respuesta de Stripe.
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  /// Stripe Customer ID (cus_...). Compartido con mod.billing — un alumno
  /// puede tener varios subscriptions y orders bajo el mismo customer.
  stripeCustomerId     String             @map("stripe_customer_id")
  /// Stripe Price ID (price_...). Recurring (interval=month|year).
  stripePriceId        String             @map("stripe_price_id")
  status               SubscriptionStatus @default(PENDING)
  /// Importe del periodo actual en céntimos. Se actualiza si cambia el price
  /// (rotación de plan).
  unitAmount           Int                @map("unit_amount")
  currency             String             @default("eur")
  /// Frecuencia: 'month' | 'year'. Igual que Stripe price.recurring.interval.
  interval             String
  /// Fecha de fin del periodo actual de facturación. Cuando llega, Stripe cobra
  /// automáticamente y nos manda invoice.paid (o invoice.payment_failed).
  currentPeriodEnd     DateTime?          @map("current_period_end")
  /// Si el alumno o admin pulsa "Cancelar al final del periodo", marcamos esto
  /// y Stripe NO renueva al llegar currentPeriodEnd. El bridge mantiene el
  /// enrollment hasta esa fecha y luego desenrolla.
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  /// Fin del grace period tras invoice.payment_failed. NULL si la sub está
  /// ACTIVE. Se setea a `now() + GRACE_PERIOD_DAYS` cuando el invoice falla.
  /// El cron `dunning-cleanup` revisa esta columna y emite el evento de pausa
  /// cuando expira sin que el alumno actualice el método de pago.
  gracePeriodEndsAt    DateTime?          @map("grace_period_ends_at")
  /// Fecha real de cancelación efectiva (post-currentPeriodEnd o inmediata).
  canceledAt           DateTime?          @map("canceled_at")
  /// Causa de cancelación para auditoría: 'user_request' | 'unpaid_grace_expired' | 'admin'.
  canceledReason       String?            @map("canceled_reason")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  invoices             ModSubscriptionsInvoice[]

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, courseId])
  @@index([gracePeriodEndsAt])
  @@map("mod_subscriptions_subscription")
}

/// Una factura emitida por Stripe asociada a una suscripción.
///
/// Cada periodo de la suscripción genera UNA invoice. La primera invoice se
/// crea junto con la subscription (al cierre del checkout); las siguientes
/// las genera Stripe automáticamente al cierre de cada periodo.
///
/// Guardamos las invoices localmente para mostrarle al alumno su historial
/// de pagos en /cuenta/suscripciones sin ir a Stripe en cada render.
model ModSubscriptionsInvoice {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @map("tenant_id") @db.Uuid
  /// ID lógico de la suscripción local (FK conceptual, no real para mantener
  /// la regla de no-FK pero al estar en el mismo módulo sí podemos usar FK).
  subscriptionId    String                    @map("subscription_id") @db.Uuid
  /// Stripe Invoice ID (in_...).
  stripeInvoiceId   String                    @unique @map("stripe_invoice_id")
  status            SubscriptionInvoiceStatus @default(OPEN)
  /// Importe de la factura en céntimos.
  amount            Int
  currency          String                    @default("eur")
  /// URL hosted de Stripe a la factura — el alumno la ve si quiere descargar PDF.
  hostedInvoiceUrl  String?                   @map("hosted_invoice_url")
  /// Cuándo Stripe la cobró exitosamente (NULL si OPEN/UNCOLLECTIBLE/VOID).
  paidAt            DateTime?                 @map("paid_at")
  /// Fecha del periodo de facturación que cubre esta invoice.
  periodStart       DateTime                  @map("period_start")
  periodEnd         DateTime                  @map("period_end")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  subscription      ModSubscriptionsSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: NoAction, map: "fk_mod_subs_invoice_subscription")

  @@index([tenantId, subscriptionId])
  @@index([tenantId, status])
  @@map("mod_subscriptions_invoice")
}

/// Persistencia de eventos webhook de Stripe específicos de suscripciones,
/// para idempotencia. Stripe puede mandar el mismo evento múltiples veces;
/// sin esta tabla, el bridge enrollaría / pausaría duplicado.
///
/// Tabla SEPARADA de mod_billing_webhook_event aunque conceptualmente parecida:
/// los módulos NO comparten tablas (regla del contrato). Cada uno tiene su
/// propio espacio de idempotencia.
model ModSubscriptionsWebhookEvent {
  /// Stripe event id (evt_...). PK natural.
  stripeEventId  String    @id @map("stripe_event_id")
  tenantId       String?   @map("tenant_id") @db.Uuid
  type           String
  subscriptionId String?   @map("subscription_id") @db.Uuid
  payload        Json      @default("{}")
  errorMessage   String?   @map("error_message")
  receivedAt     DateTime  @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")

  @@index([type])
  @@index([tenantId, receivedAt])
  @@map("mod_subscriptions_webhook_event")
}

// Backref desde Subscription → Invoice para el query "lista invoices de mi sub".
// Lo declaramos como atributo @relation aparte para no contaminar el primer model.

// ============================================================================
// mod.ai-content — Generador IA de borradores (resúmenes / flashcards / quizzes)
// ============================================================================

enum AiContentDraftType {
  SUMMARY
  FLASHCARDS
  QUIZ
}

enum AiContentDraftStatus {
  /// Recién generado por IA. El formador aún no lo ha revisado.
  DRAFT
  /// El formador aprobó el draft. Listeners pueden ingerirlo en otros
  /// módulos (ej. mod.assessments crea ModAssessmentsQuiz desde un QUIZ).
  PUBLISHED
  /// El formador descartó el draft. Mantenemos el row para auditoría +
  /// telemetría de calidad IA (si muchos drafts se rechazan, hay que
  /// ajustar prompt o provider).
  REJECTED
}

/// Borrador de contenido formativo generado por IA. Pertenece a una lección
/// y, opcionalmente, a un curso (cacheado para listings rápidos sin JOIN).
/// El contenido va en JSON con shape distinto por type:
///   - SUMMARY:    { text }
///   - FLASHCARDS: { cards: [{ front, back }] }
///   - QUIZ:       { questions: [{ prompt, options?, answer, explanation? }] }
model ModAiContentDraft {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  /// IDs lógicos sin FK cross-module.
  lessonId     String               @map("lesson_id") @db.Uuid
  courseId     String               @map("course_id") @db.Uuid
  /// Quién pidió generarlo (formador). Auditoría.
  requestedBy  String               @map("requested_by") @db.Uuid
  type         AiContentDraftType
  status       AiContentDraftStatus @default(DRAFT)
  content      Json                 @default("{}")
  /// Provider/model usado al generar — útil para reportes de calidad y
  /// reproducibilidad si en el futuro se permite "regenerar".
  provider     String?
  model        String?
  inputTokens  Int?                 @map("input_tokens")
  outputTokens Int?                 @map("output_tokens")
  reviewedBy   String?              @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?            @map("reviewed_at")
  rejectReason String?              @map("reject_reason")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([tenantId, lessonId])
  @@index([tenantId, status])
  @@index([courseId])
  @@map("mod_ai_content_draft")
}

// ============================================================================
// MARKETPLACE — registro de módulos instalados a nivel instancia (ADR-009)
// ============================================================================
//
// Esta tabla NO lleva tenantId: la instalación de un módulo es global a la
// instancia. La activación per-tenant sigue viviendo en `tenant_module`.
//
// Un row se crea cuando un super_admin sube un *.didactamod. Los pasos del
// flujo (verify firma → extract → migrate → boot VM) van actualizando
// `status`. El paquete original se persiste en object storage (clave en
// `package_storage_key`) para permitir reinstalación en otra réplica del
// mismo deploy o rollback.
//
// Vendor 'VA360' = paquete firmado por VA360 (clave pública confiada por la
// instancia). 'COMMUNITY' queda reservado para el marketplace de terceros
// (Fase 2+, ADR pendiente).

enum InstalledModuleVendor {
  /// Paquetes firmados por Didacta (KMS `alias/didacta-issuer-2026`,
  /// ES256). En MVP solo este vendor está confiado por el verifier.
  DIDACTA
  /// Reservado para Fase 2+: marketplace público con vendors de terceros
  /// que tendrán su propia clave de firma tras un proceso de revisión.
  COMMUNITY
}

/// Origen de instalación del módulo (DISC-002).
/// Determina el nivel de confianza y el badge mostrado en UI.
enum InstalledModuleSource {
  /// Descargado del marketplace oficial, firmado por Didacta, publisher=didacta.
  /// Badge: "✅ Oficial"
  MARKETPLACE_OFFICIAL
  /// Descargado del marketplace, firmado por Didacta tras review, publisher=third-party.
  /// Badge: "👥 Comunidad"
  MARKETPLACE_COMMUNITY
  /// Subido manualmente por el admin sin pasar por marketplace.
  /// Sin firma o firma inválida. Badge: "⚠️ No verificado"
  DIRECT_UPLOAD
}

enum InstalledModuleStatus {
  /// El paquete fue subido y validado pero la instalación aún no terminó.
  /// Estados intermedios del pipeline (extract → migrate → boot).
  INSTALLING
  /// Instalado y activo en la instancia. Aparece en `module` para que cada
  /// tenant decida si lo activa via `/admin/modules`.
  INSTALLED
  /// Instalación falló en alguna fase. `error_message` lleva el detalle.
  /// Row se mantiene para postmortem; un retry crea un row nuevo.
  FAILED
  /// Versión anterior tras un upgrade exitoso. Permite revert ≤ 24h.
  /// Después se purga del disco; el row queda como histórico.
  DEPRECATED
}

model InstalledModule {
  id           String                @id @default(uuid()) @db.Uuid
  /// Slug del módulo (ej. "mod.gamification"). Único por instancia, una sola
  /// versión activa a la vez. Para upgrade in-place se actualiza el row.
  name         String                @unique
  version      String
  /// Versión anterior si este row es resultado de un upgrade. Permite revert.
  prevVersion  String?               @map("prev_version")
  vendor       InstalledModuleVendor
  /// Origen de la instalación (DISC-002). Determina badge y nivel de confianza.
  source       InstalledModuleSource @default(DIRECT_UPLOAD)
  displayName  String                @map("display_name")
  description  String?
  /// Manifest del módulo serializado (ADR-008 + extensiones ADR-009).
  /// Se persiste como JSON ya verificado para queries rápidas y para diff
  /// entre versiones tras un upgrade.
  manifestJson Json                  @map("manifest_json")
  /// JWT compact tal cual viene en el ZIP (`manifest.jwt`). Es el
  /// artefacto autoritativo: lleva el manifest + firma ES256 firmada por
  /// AWS KMS `alias/didacta-issuer-2026`. Re-verificable en cualquier
  /// momento — útil para auditoría y para re-checkear tras rotación de
  /// claves públicas.
  /// NULL si el módulo fue subido directamente sin firma válida (DISC-002).
  manifestJwt  String?               @map("manifest_jwt")
  /// `signedAt` declarado por el publisher. Solo informativo, no se compara
  /// con el reloj del receiver — los relojes de los clientes self-host no
  /// son confiables.
  /// NULL si el módulo fue subido sin firma (source=DIRECT_UPLOAD).
  signedAt     DateTime?             @map("signed_at")
  /// Clave del *.didactamod en object storage de la instancia (S3/MinIO).
  /// Ejemplo: "modules/mod.gamification-1.2.0.didactamod".
  packageStorageKey String            @map("package_storage_key")
  /// Hash SHA-256 hex del paquete. Verificado al re-leerlo del storage.
  packageSha256     String            @map("package_sha256")
  /// Tamaño en bytes; útil para listados sin abrir el ZIP.
  packageSizeBytes  Int               @map("package_size_bytes")
  /// Restricciones runtime del manifest (cacheadas como columnas para query
  /// rápido). El contenido autoritativo sigue en `manifestJson`.
  coreVersionRequired String          @map("core_version_required")
  tablePrefix         String          @map("table_prefix")
  apiNamespace        String          @map("api_namespace")
  requiredCapabilities String[]       @default([]) @map("required_capabilities")
  requiredEnvVars      String[]       @default([]) @map("required_env_vars")
  /// Modelo de aislamiento solicitado: 'vm' (node:vm) o 'worker_thread'.
  /// MVP solo soporta 'vm'.
  isolation     String                @default("vm")
  status        InstalledModuleStatus @default(INSTALLING)
  errorMessage  String?               @map("error_message")
  /// Migraciones SQL del paquete (subdir `prisma/migrations/` del ZIP)
  /// aplicadas con éxito a la BD de la instancia, en orden alfabético.
  /// El array crece append-only por install/upgrade. NULL si el paquete
  /// no traía migrations o si aún no se intentó aplicarlas.
  migrationsApplied String[]           @default([]) @map("migrations_applied")
  migrationsAppliedAt DateTime?        @map("migrations_applied_at")
  /// Super_admin que inició la instalación. FK lógica (sin REFERENCES) para
  /// no acoplar marketplace al ciclo de vida del usuario; si el user se
  /// borra, el row queda con la traza histórica.
  installedById String                @map("installed_by_id") @db.Uuid
  installedAt   DateTime?             @map("installed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([status])
  @@index([vendor])
  @@map("installed_module")
}

/// Store de secretos cifrados para módulos third-party (alpha.56 / SE-002).
///
/// Cuando un módulo declara `requiresSecrets: true` en su manifest, el host
/// le inyecta `ctx.secrets` con get/set/delete/list scoped a `(tenant_id,
/// module_id)`. Esta tabla persiste los values cifrados con AES-256-GCM
/// usando `SecretCipherService`. La key de cifrado se resuelve via
/// `loadCipherKey()` (env → file → file-new → ephemeral) — la misma que
/// cifra `tenant_setting`, mismo dominio (secrets-at-rest tenant-level),
/// mismo blast radius si se rota.
///
/// `ciphertext` + `iv` + `tag` son los tres componentes de AES-GCM:
///  - ciphertext: el value plaintext cifrado (1 byte de overhead vs plaintext).
///  - iv: nonce aleatorio 96-bit, distinto por cada `set()` (incluso para el
///    mismo plaintext) — necesario para que GCM sea IND-CCA2.
///  - tag: 128-bit MAC que verifica integridad; si alguien altera ciphertext
///    o iv en BD, el decrypt() del cipher lanza al validar el tag.
///
/// `module_id` es el slug del módulo (`manifest.name`, ej. "mod.migrator-learndash").
/// NO usamos FK a `InstalledModule.name` porque un módulo puede ser
/// desinstalado y reinstalado — queremos que los secrets sobrevivan si el
/// admin reinstala la misma versión (caso típico de upgrade fallido).
///
/// `expires_at` opcional: secrets job-scoped (WP appPassword del migrator)
/// se setean con expiresAt = now + retentionDays. get()/list() filtran
/// expired; un GC periódico borra los rows físicos para que la quota no
/// crezca con basura caducada.
model ModSecret {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  moduleId  String    @map("module_id") @db.VarChar(60)
  secretKey String    @map("secret_key") @db.VarChar(128)
  /// Value cifrado (AES-256-GCM). `Bytes` se mapea a `bytea` en Postgres.
  ciphertext Bytes
  /// Nonce 96-bit del GCM. Distinto por cada `set()`.
  iv         Bytes
  /// Auth tag 128-bit. Verifica integridad al decrypt.
  tag        Bytes
  /// Tamaño aproximado del value plaintext (bytes). Cacheado para que
  /// `list()` pueda devolverlo sin descifrar (que requiere round-trip al
  /// cipher service por cada row).
  approxValueBytes Int      @map("approx_value_bytes")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, moduleId, secretKey], name: "mod_secret_unique")
  @@index([expiresAt])
  @@index([tenantId, moduleId])
  @@map("mod_secret")
}

// ============================================================================
// MOD.GROUPS — UC-011 (alpha.89)
// Grupos de comunidad básicos. Sin FK cross-módulo: userId es lógico.
