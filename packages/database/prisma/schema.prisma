// ============================================================================
// Didacta — Schema Prisma v1 (Core)
// ----------------------------------------------------------------------------
// Reglas clave:
// - Toda tabla con datos de negocio incluye `tenantId` + política RLS (ver rls.sql)
// - Sin FKs cross-module (los módulos usan IDs lógicos)
// - Append-only en AuditLog (triggers en rls.sql)
// - Soft delete preferido (deletedAt)
// Referencia: docs/PRD.md §9.1, docs/ARQUITECTURA-MODULAR.md §4.1
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector se añade en Fase 1.C cuando se active mod.ai-tutor (embeddings + RAG).
  // Para activarlo en Postgres de Easypanel, cambiar la imagen del servicio
  // a pgvector/pgvector:pg16 y volver a añadir `vector` aquí.
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto]
}

// ============================================================================
// TENANTS & MODULE REGISTRY
// ============================================================================

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  config    Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  users           User[]
  sessions        Session[]
  apiKeys         ApiKey[]
  tenantModules   TenantModule[]
  auditLogs       AuditLog[]
  evidenceEntries EvidenceVaultEntry[]
  outboxEvents    OutboxEvent[]
  webhooks        Webhook[]
  notifTemplates  NotificationTemplate[]
  tenantSettings  TenantSetting[]
  domains         TenantDomain[]

  @@index([slug])
  @@index([status])
  @@map("tenant")
}

// ============================================================================
// TENANT DOMAINS — mapeo Host → tenant para login transparente.
// Cada tenant puede tener múltiples dominios (subdominio default + custom).
// El middleware de tenancy lee el Host header del request, busca aquí, y
// resuelve el tenant correspondiente. Esto permite que el alumno NO escriba
// el slug en signin/signup — la URL le dice todo.
// Ver HU-SA-001 + LMS-110 (Notion).
// ============================================================================
model TenantDomain {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Host completo en lowercase, sin puerto ni path.
  /// Ejemplos: "aprende.va360labs.com", "didacta.local", "localhost".
  hostname   String   @unique @db.VarChar(253)
  /// El primary identifica el dominio canónico para emails y enlaces.
  /// Solo uno por tenant tiene `isPrimary=true`.
  isPrimary  Boolean  @default(false) @map("is_primary")
  /// Para custom domains de clientes: requiere validación DNS antes de activar.
  /// `localhost` y dominios default del seed nacen verified=true.
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domain")
}

// ============================================================================
// TENANT SETTINGS — config persistente per-tenant con encryption at-rest.
// Reemplaza el stub in-memory anterior. Los valores marcados con is_secret se
// cifran con AES-256-GCM usando TENANT_SETTINGS_ENC_KEY del env. Los no
// secretos viajan en value_json plano. Cada admin de tenant configura desde
// /admin/configuracion sus credenciales SMTP, Zoom, etc.
// ============================================================================

model TenantSetting {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Namespace lógico: "notifications", "zoom", "ai-tutor", "storage", etc.
  moduleName  String   @map("module_name") @db.VarChar(100)
  /// Clave dentro del namespace (ej. "smtp", "default-locale").
  key         String   @db.VarChar(200)
  /// Si true, el valor es sensible y se cifra (passwords, API keys).
  isSecret    Boolean  @default(false) @map("is_secret")
  /// Valor en claro cuando isSecret=false (cualquier JSON).
  valueJson   Json?    @map("value_json")
  /// AES-256-GCM ciphertext + IV (12B) + auth tag (16B) cuando isSecret=true.
  valueCipher Bytes?   @map("value_cipher")
  valueIv     Bytes?   @map("value_iv")
  valueTag    Bytes?   @map("value_tag")
  /// Quién hizo el último cambio (sin FK cross-module a IAM).
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleName, key])
  @@index([tenantId, moduleName])
  @@map("tenant_setting")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Module {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  version          String
  displayName      String   @map("display_name")
  description      String?
  enabledByDefault Boolean  @default(false) @map("enabled_by_default")
  manifest         Json
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenantModules TenantModule[]

  @@map("module")
}

model TenantModule {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  enabledAt DateTime @default(now()) @map("enabled_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@id([tenantId, moduleId])
  @@index([tenantId, enabled])
  @@map("tenant_module")
}

// ============================================================================
// IAM
// ============================================================================

model User {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  email            String
  emailVerified    Boolean    @default(false) @map("email_verified")
  name             String?
  passwordHash     String?    @map("password_hash")
  mfaSecret        String?    @map("mfa_secret")
  mfaEnabled       Boolean    @default(false) @map("mfa_enabled")
  mfaRecoveryCodes String[]   @default([]) @map("mfa_recovery_codes")
  status           UserStatus @default(ACTIVE)
  locale           String     @default("es-ES")
  /// IANA timezone, ej. "America/Argentina/Buenos_Aires" o "Europe/Madrid".
  /// Usado para mostrar timestamps localmente. Default UTC.
  timezone         String     @default("UTC") @map("timezone")
  /// URL pública (S3/CDN) del avatar del usuario. Null = usar iniciales.
  avatarUrl        String?    @map("avatar_url")
  /// Documento de identidad (DNI o NIE español) en mayúsculas y sin
  /// separadores. Requerido para Fundae cuando el usuario participa
  /// en una acción formativa bonificada. Único por tenant si está set.
  documentId       String?    @map("document_id") @db.VarChar(20)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")
  lastLoginAt      DateTime?  @map("last_login_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  sessions Session[]
  apiKeys  ApiKey[]
  roles    UserRole[]

  @@unique([tenantId, email])
  @@unique([tenantId, documentId], map: "user_tenant_document_id_key")
  @@index([tenantId, status])
  @@map("user")
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  moduleName  String?  @map("module_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([moduleName])
  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  scopes     String[]
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("api_key")
}

// ============================================================================
// AUDIT LOG (append-only, triggers en rls.sql)
// ============================================================================

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  metadata     Json     @default("{}")
  ip           String?
  userAgent    String?  @map("user_agent")
  timestamp    DateTime @default(now())
  prevHash     String?  @map("prev_hash")
  hash         String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, timestamp])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

// ============================================================================
// EVIDENCE VAULT
// ============================================================================

model EvidenceVaultEntry {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  storageKey   String   @map("storage_key")
  hash         String
  size         BigInt
  contentType  String?  @map("content_type")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  rlptNotices ModFundaeRlptNotice[]

  @@index([tenantId, resourceType, resourceId])
  @@index([hash])
  @@map("evidence_vault_entry")
}

// ============================================================================
// EVENT BUS (outbox pattern) + WEBHOOKS
// ============================================================================

model OutboxEvent {
  id                 BigInt    @id @default(autoincrement())
  tenantId           String    @map("tenant_id") @db.Uuid
  eventName          String    @map("event_name")
  payloadVersion     Int       @default(1) @map("payload_version")
  payload            Json
  metadata           Json      @default("{}")
  idempotencyKey     String    @map("idempotency_key")
  createdAt          DateTime  @default(now()) @map("created_at")
  processedAt        DateTime? @map("processed_at")
  processingAttempts Int       @default(0) @map("processing_attempts")
  lastError          String?   @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([processedAt])
  @@index([tenantId, eventName])
  @@map("outbox_event")
}

model Webhook {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  url            String
  events         String[]
  secretHash     String    @map("secret_hash")
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastDeliveryAt DateTime? @map("last_delivery_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, enabled])
  @@map("webhook")
}

// ============================================================================
// NOTIFICATION TEMPLATES
// ============================================================================

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  key       String
  channel   NotificationChannel
  locale    String              @default("es-ES")
  subject   String?
  body      String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key, channel, locale])
  @@map("notification_template")
}

enum NotificationChannel {
  EMAIL
  IN_APP
  WEBHOOK
}

/// Cada notificación que el NotificationHub envía o intenta enviar.
/// El channel IN_APP siempre se persiste y es leído por el alumno desde
/// /notificaciones. Los demás canales también persisten para auditoría:
/// el campo `sentAt`/`failedAt` registra el resultado del adapter.
// ============================================================================
// mod.community — Posts, comentarios y reacciones
// ============================================================================

model ModCommunityPost {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  /// ID lógico del autor (sin FK cross-module a IAM).
  authorId          String    @map("author_id") @db.Uuid
  /// ID lógico del curso al que está vinculado el post (null = post global).
  courseId          String?   @map("course_id") @db.Uuid
  title             String
  body              String
  /// Tags libres (#general, #ayuda, #anuncios, etc.). Vacío = sin tags.
  tags              String[]  @default([])
  /// Snapshot del nombre del autor al crear el post (denormalizado para
  /// listados rápidos sin necesidad de join cross-module a IAM).
  authorDisplayName String?   @map("author_display_name")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  /// Moderación: timestamp + actor + razón. Si `hiddenAt != null`, el post
  /// queda invisible para alumnos pero la fila se preserva (vs `deletedAt`,
  /// que es soft-delete por el autor). El admin puede revertir clearando
  /// las tres columnas.
  hiddenAt     DateTime? @map("hidden_at")
  hiddenById   String?   @map("hidden_by_id") @db.Uuid
  hiddenReason String?   @map("hidden_reason")

  /// Pin/fijado por admin. Si `pinnedAt != null`, el post va al tope del
  /// feed independientemente del orden elegido. `pinnedById` registra
  /// quién lo fijó para auditoría sin FK cross-module a IAM.
  pinnedAt   DateTime? @map("pinned_at")
  pinnedById String?   @map("pinned_by_id") @db.Uuid

  comments  ModCommunityComment[]
  reactions ModCommunityReaction[]

  @@index([tenantId, courseId, createdAt])
  @@index([tenantId, authorId])
  @@index([tenantId, pinnedAt])
  @@map("mod_community_post")
}

/// Menciones en posts y comments. Una mención apunta a UN usuario y a UN
/// recurso (post o comment). Se persisten al crear el contenido vía parser
/// del body. Sirve para listar "mis menciones" rápido y para notificar.
model ModCommunityMention {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  postId          String?  @map("post_id") @db.Uuid
  commentId       String?  @map("comment_id") @db.Uuid
  mentionedUserId String   @map("mentioned_user_id") @db.Uuid
  /// Handle textual usado al mencionar (ej. "juan" si email = juan@example.com).
  /// Snapshot para que cambios futuros del email no rompan la mención histórica.
  mentionedHandle String   @map("mentioned_handle")
  authorId        String   @map("author_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, mentionedUserId, createdAt])
  @@index([postId])
  @@index([commentId])
  @@map("mod_community_mention")
}

/// Categorías curadas de cursos para el catálogo. Reemplazan al string
/// libre `mod_courses_course.category` (que se mantiene como referencia
/// por nombre para no romper datos existentes). El admin las gestiona
/// desde /admin/cursos/categorias y el builder ofrece un select.
///
/// Multi-categoría con pivote queda como follow-up: el modelo actual
/// soporta una sola categoría por curso (campo `category: string` que
/// matches contra `name`), igual que el patrón de community tags donde
/// `tags` es un array libre y la metadata curada es opcional.
model ModCoursesCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Nombre canónico (ej. "Tecnología", "Liderazgo"). Único por tenant
  /// case-insensitive — la app normaliza al insertar.
  name      String
  /// Color hex 6 dígitos con `#`.
  color     String
  /// Icono opcional del set interno (mismos valores que community tags).
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name], map: "mod_courses_category_tenant_name_key")
  @@index([tenantId])
  @@map("mod_courses_category")
}

/// Comentarios/anotaciones que dejan los alumnos en lecciones. Llegan
/// en estado PENDING y el profesor del curso (o un admin) los aprueba
/// o rechaza. Sólo los APPROVED son visibles al resto de alumnos. El
/// autor siempre ve los suyos (incluyendo PENDING) para que sepa que
/// están esperando moderación.
model ModLearningLessonComment {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  /// ID lógico de la lección. Sin FK cross-module a courses.
  lessonId          String              @map("lesson_id") @db.Uuid
  /// Denormalizado: lo persiste el handler al crear el comentario para
  /// que la cola de pendientes del profesor pueda filtrar por curso sin
  /// lookup adicional a courses.
  courseId          String              @map("course_id") @db.Uuid
  authorId          String              @map("author_id") @db.Uuid
  authorDisplayName String?             @map("author_display_name")
  body              String
  status            LessonCommentStatus @default(PENDING)
  reviewedById      String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?           @map("reviewed_at")
  /// Si el profesor rechaza, opcionalmente un motivo visible al autor.
  rejectionReason   String?             @map("rejection_reason")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")

  @@index([tenantId, lessonId, status])
  @@index([tenantId, courseId, status])
  @@index([tenantId, authorId, status])
  @@map("mod_learning_lesson_comment")
}

enum LessonCommentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Tags curados por el admin del tenant. Cada fila representa un tag
/// "oficial" con metadatos visuales (color, icono) que la UI usa para
/// pintar chips consistentes en el feed y la sidebar.
///
/// La columna `tags` de `ModCommunityPost` sigue siendo un `String[]`
/// libre — los autores pueden seguir tipeando lo que quieran. Los tags
/// curados son simplemente metadata opcional: si un post usa un tag que
/// existe acá, la UI lo pinta con su color/icono; si no, cae al estilo
/// genérico. Esta independencia evita FKs cross-record y permite a los
/// admins añadir/quitar tags sin afectar el contenido histórico.
model ModCommunityTag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Nombre canónico del tag (ej. "ayuda", "anuncios"). Único por tenant
  /// case-insensitive — la app normaliza a minúsculas antes de persistir
  /// para evitar duplicados tipo "Ayuda" / "ayuda".
  name      String
  /// Color hex 6 dígitos con `#` (ej. "#1E5AA8"). La UI lo aplica en el
  /// chip del feed y en el cuadrito de la sidebar. Validado a nivel DTO.
  color     String
  /// Nombre del icono del set interno (ej. "message", "lightbulb"). NULL
  /// = no muestra icono. La UI tolera nombres desconocidos cayendo a un
  /// fallback genérico.
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name], map: "mod_community_tag_tenant_name_key")
  @@index([tenantId])
  @@map("mod_community_tag")
}

/// Preferencias de notificación por usuario de community.
/// v0.1: solo `digestOptOut`. Estructura abierta para sumar prefs sin
/// nuevas migraciones (la fila se upsert siempre).
model ModCommunityUserPref {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  digestOptOut Boolean  @default(false) @map("digest_opt_out")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId], map: "mod_community_user_pref_tenant_user_key")
  @@map("mod_community_user_pref")
}

model ModCommunityComment {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  postId            String    @map("post_id") @db.Uuid
  authorId          String    @map("author_id") @db.Uuid
  body              String
  authorDisplayName String?   @map("author_display_name")
  /// Comentario padre para nested replies (1 nivel de profundidad por
  /// design — los hilos profundos confunden y se moderan peor). NULL para
  /// comentarios root del post.
  parentCommentId   String?   @map("parent_comment_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  /// Moderación, mismo patrón que `ModCommunityPost`.
  hiddenAt     DateTime? @map("hidden_at")
  hiddenById   String?   @map("hidden_by_id") @db.Uuid
  hiddenReason String?   @map("hidden_reason")

  post      ModCommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    ModCommunityComment?   @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies   ModCommunityComment[]  @relation("CommentReplies")
  reactions ModCommunityReaction[]

  @@index([tenantId, postId, createdAt])
  @@index([parentCommentId])
  @@map("mod_community_comment")
}

model ModCommunityReaction {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Solo uno de postId o commentId está poblado.
  postId    String?  @map("post_id") @db.Uuid
  commentId String?  @map("comment_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  /// Emoji corto: "👍", "❤️", "🎉", etc. Limitado a 8 caracteres.
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  post    ModCommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment ModCommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([authorId, postId, emoji])
  @@unique([authorId, commentId, emoji])
  @@index([tenantId, postId])
  @@index([tenantId, commentId])
  @@map("mod_community_reaction")
}

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  channel       NotificationChannel
  templateKey   String              @map("template_key")
  subject       String?
  body          String
  metadata      Json                @default("{}")
  /// Timestamp de lectura por el destinatario (solo aplica a IN_APP).
  readAt        DateTime?           @map("read_at")
  /// Timestamp de despacho del adapter (SMTP enviado, webhook OK, etc.).
  /// Para IN_APP se rellena al persistir, ya que entregar = persistir.
  sentAt        DateTime?           @map("sent_at")
  /// Si el adapter falló (SMTP rebote, webhook 5xx), la razón queda aquí.
  failedAt      DateTime?           @map("failed_at")
  failureReason String?             @map("failure_reason")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([tenantId, userId, readAt])
  @@index([tenantId, channel, sentAt])
  @@map("notification")
}

// ============================================================================
// mod.courses — Catálogo de cursos, módulos y lecciones
// ============================================================================

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  HTML
  PDF
  TEXT
  QUIZ
  SCORM
}

model ModCoursesCourse {
  id                    String       @id @default(uuid()) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  slug                  String
  title                 String
  description           String?
  thumbnailUrl          String?      @map("thumbnail_url")
  language              String       @default("es-ES")
  estimatedMinutes      Int?         @map("estimated_minutes")
  status                CourseStatus @default(DRAFT)
  category              String?
  createdById           String?      @map("created_by_id") @db.Uuid
  /// Template de certificado preferido para este curso. Si null, se usa el
  /// default del tenant (mod_certificates_template.is_default = true).
  /// Sin @relation cross-module: es UUID lógico.
  certificateTemplateId String?      @map("certificate_template_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at")
