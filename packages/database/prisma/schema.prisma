  group ModGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId], name: "mod_group_member_unique", map: "mod_group_member_unique")
  @@index([tenantId, userId])
  @@map("mod_group_member")
}

// ============================================================================
// MOD.EVENTS — UC-013 (alpha.89)
// Eventos y sesiones en directo. Sin FK cross-módulo.
// ============================================================================

model ModEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String
