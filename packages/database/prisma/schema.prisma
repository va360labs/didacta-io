// ============================================================================
// Didacta — Schema Prisma v1 (Core)
// ----------------------------------------------------------------------------
// Reglas clave:
// - Toda tabla con datos de negocio incluye `tenantId` + política RLS (ver rls.sql)
// - Sin FKs cross-module (los módulos usan IDs lógicos)
// - Append-only en AuditLog (triggers en rls.sql)
// - Soft delete preferido (deletedAt)
// Referencia: docs/PRD.md §9.1, docs/ARQUITECTURA-MODULAR.md §4.1
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // pgvector se añade en Fase 1.C cuando se active mod.ai-tutor (embeddings + RAG).
  // Para activarlo en Postgres de Easypanel, cambiar la imagen del servicio
  // a pgvector/pgvector:pg16 y volver a añadir `vector` aquí.
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto]
}

// ============================================================================
// TENANTS & MODULE REGISTRY
// ============================================================================

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  config    Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users            User[]
  sessions         Session[]
  apiKeys          ApiKey[]
  tenantModules    TenantModule[]
  auditLogs        AuditLog[]
  evidenceEntries  EvidenceVaultEntry[]
  outboxEvents     OutboxEvent[]
  webhooks         Webhook[]
  notifTemplates   NotificationTemplate[]
  tenantSettings   TenantSetting[]
  domains          TenantDomain[]

  @@index([slug])
  @@index([status])
  @@map("tenant")
}

// ============================================================================
// TENANT DOMAINS — mapeo Host → tenant para login transparente.
// Cada tenant puede tener múltiples dominios (subdominio default + custom).
// El middleware de tenancy lee el Host header del request, busca aquí, y
// resuelve el tenant correspondiente. Esto permite que el alumno NO escriba
// el slug en signin/signup — la URL le dice todo.
// Ver HU-SA-001 + LMS-110 (Notion).
// ============================================================================
model TenantDomain {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Host completo en lowercase, sin puerto ni path.
  /// Ejemplos: "aprende.va360labs.com", "didacta.local", "localhost".
  hostname   String   @unique @db.VarChar(253)
  /// El primary identifica el dominio canónico para emails y enlaces.
  /// Solo uno por tenant tiene `isPrimary=true`.
  isPrimary  Boolean  @default(false) @map("is_primary")
  /// Para custom domains de clientes: requiere validación DNS antes de activar.
  /// `localhost` y dominios default del seed nacen verified=true.
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domain")
}

// ============================================================================
// TENANT SETTINGS — config persistente per-tenant con encryption at-rest.
// Reemplaza el stub in-memory anterior. Los valores marcados con is_secret se
// cifran con AES-256-GCM usando TENANT_SETTINGS_ENC_KEY del env. Los no
// secretos viajan en value_json plano. Cada admin de tenant configura desde
// /admin/configuracion sus credenciales SMTP, Zoom, etc.
// ============================================================================

model TenantSetting {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Namespace lógico: "notifications", "zoom", "ai-tutor", "storage", etc.
  moduleName   String   @map("module_name") @db.VarChar(100)
  /// Clave dentro del namespace (ej. "smtp", "default-locale").
  key          String   @db.VarChar(200)
  /// Si true, el valor es sensible y se cifra (passwords, API keys).
  isSecret     Boolean  @default(false) @map("is_secret")
  /// Valor en claro cuando isSecret=false (cualquier JSON).
  valueJson    Json?    @map("value_json")
  /// AES-256-GCM ciphertext + IV (12B) + auth tag (16B) cuando isSecret=true.
  valueCipher  Bytes?   @map("value_cipher")
  valueIv      Bytes?   @map("value_iv")
  valueTag     Bytes?   @map("value_tag")
  /// Quién hizo el último cambio (sin FK cross-module a IAM).
  updatedById  String?  @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleName, key])
  @@index([tenantId, moduleName])
  @@map("tenant_setting")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Module {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  version           String
  displayName       String   @map("display_name")
  description       String?
  enabledByDefault  Boolean  @default(false) @map("enabled_by_default")
  manifest          Json
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenantModules TenantModule[]

  @@map("module")
}

model TenantModule {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  enabledAt DateTime @default(now()) @map("enabled_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@id([tenantId, moduleId])
  @@index([tenantId, enabled])
  @@map("tenant_module")
}

// ============================================================================
// IAM
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  name          String?
  passwordHash  String?   @map("password_hash")
  mfaSecret     String?   @map("mfa_secret")
  mfaEnabled    Boolean   @default(false) @map("mfa_enabled")
  mfaRecoveryCodes String[] @default([]) @map("mfa_recovery_codes")
  status        UserStatus @default(ACTIVE)
  locale        String    @default("es-ES")
  /// IANA timezone, ej. "America/Argentina/Buenos_Aires" o "Europe/Madrid".
  /// Usado para mostrar timestamps localmente. Default UTC.
  timezone      String    @default("UTC") @map("timezone")
  /// URL pública (S3/CDN) del avatar del usuario. Null = usar iniciales.
  avatarUrl     String?   @map("avatar_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  lastLoginAt   DateTime? @map("last_login_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  sessions Session[]
  apiKeys  ApiKey[]
  roles    UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("user")
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  moduleName  String?  @map("module_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([moduleName])
  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String
  tokenHash    String    @unique @map("token_hash")
  scopes       String[]
  expiresAt    DateTime? @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("api_key")
}

// ============================================================================
// AUDIT LOG (append-only, triggers en rls.sql)
// ============================================================================

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  metadata     Json     @default("{}")
  ip           String?
  userAgent    String?  @map("user_agent")
  timestamp    DateTime @default(now())
  prevHash     String?  @map("prev_hash")
  hash         String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, timestamp])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

// ============================================================================
// EVIDENCE VAULT
// ============================================================================

model EvidenceVaultEntry {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  storageKey   String   @map("storage_key")
  hash         String
  size         BigInt
  contentType  String?  @map("content_type")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, resourceType, resourceId])
  @@index([hash])
  @@map("evidence_vault_entry")
}

// ============================================================================
// EVENT BUS (outbox pattern) + WEBHOOKS
// ============================================================================

model OutboxEvent {
  id              BigInt   @id @default(autoincrement())
  tenantId        String   @map("tenant_id") @db.Uuid
  eventName       String   @map("event_name")
  payloadVersion  Int      @default(1) @map("payload_version")
  payload         Json
  metadata        Json     @default("{}")
  idempotencyKey  String   @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at")
  processedAt     DateTime? @map("processed_at")
  processingAttempts Int   @default(0) @map("processing_attempts")
  lastError       String?  @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([processedAt])
  @@index([tenantId, eventName])
  @@map("outbox_event")
}

model Webhook {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  url         String
  events      String[]
  secretHash  String    @map("secret_hash")
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastDeliveryAt DateTime? @map("last_delivery_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, enabled])
  @@map("webhook")
}

// ============================================================================
// NOTIFICATION TEMPLATES
// ============================================================================

model NotificationTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  key        String
  channel    NotificationChannel
  locale     String   @default("es-ES")
  subject    String?
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key, channel, locale])
  @@map("notification_template")
}

enum NotificationChannel {
  EMAIL
  IN_APP
  WEBHOOK
}

/// Cada notificación que el NotificationHub envía o intenta enviar.
/// El channel IN_APP siempre se persiste y es leído por el alumno desde
/// /notificaciones. Los demás canales también persisten para auditoría:
/// el campo `sentAt`/`failedAt` registra el resultado del adapter.
// ============================================================================
// mod.community — Posts, comentarios y reacciones
// ============================================================================

model ModCommunityPost {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  /// ID lógico del autor (sin FK cross-module a IAM).
  authorId  String    @map("author_id") @db.Uuid
  /// ID lógico del curso al que está vinculado el post (null = post global).
  courseId  String?   @map("course_id") @db.Uuid
  title     String
  body      String
  /// Tags libres (#general, #ayuda, #anuncios, etc.). Vacío = sin tags.
  tags      String[]  @default([])
  /// Snapshot del nombre del autor al crear el post (denormalizado para
  /// listados rápidos sin necesidad de join cross-module a IAM).
  authorDisplayName String? @map("author_display_name")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  comments  ModCommunityComment[]
  reactions ModCommunityReaction[]

  @@index([tenantId, courseId, createdAt])
  @@index([tenantId, authorId])
  @@map("mod_community_post")
}

model ModCommunityComment {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String
  authorDisplayName String? @map("author_display_name")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  post      ModCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reactions ModCommunityReaction[]

  @@index([tenantId, postId, createdAt])
  @@map("mod_community_comment")
}

model ModCommunityReaction {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Solo uno de postId o commentId está poblado.
  postId    String?  @map("post_id") @db.Uuid
  commentId String?  @map("comment_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  /// Emoji corto: "👍", "❤️", "🎉", etc. Limitado a 8 caracteres.
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  post    ModCommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment ModCommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([authorId, postId, emoji])
  @@unique([authorId, commentId, emoji])
  @@index([tenantId, postId])
  @@index([tenantId, commentId])
  @@map("mod_community_reaction")
}

model Notification {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  channel         NotificationChannel
  templateKey     String              @map("template_key")
  subject         String?
  body            String
  metadata        Json                @default("{}")
  /// Timestamp de lectura por el destinatario (solo aplica a IN_APP).
  readAt          DateTime?           @map("read_at")
  /// Timestamp de despacho del adapter (SMTP enviado, webhook OK, etc.).
  /// Para IN_APP se rellena al persistir, ya que entregar = persistir.
  sentAt          DateTime?           @map("sent_at")
  /// Si el adapter falló (SMTP rebote, webhook 5xx), la razón queda aquí.
  failedAt        DateTime?           @map("failed_at")
  failureReason   String?             @map("failure_reason")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([tenantId, userId, readAt])
  @@index([tenantId, channel, sentAt])
  @@map("notification")
}

// ============================================================================
// mod.courses — Catálogo de cursos, módulos y lecciones
// ============================================================================

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  HTML
  PDF
  TEXT
  QUIZ
  SCORM
}

model ModCoursesCourse {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  slug             String
  title            String
  description      String?
  thumbnailUrl     String?      @map("thumbnail_url")
  language         String       @default("es-ES")
  estimatedMinutes Int?         @map("estimated_minutes")
  status           CourseStatus @default(DRAFT)
  category         String?
  createdById      String?      @map("created_by_id") @db.Uuid
  /// Template de certificado preferido para este curso. Si null, se usa el
  /// default del tenant (mod_certificates_template.is_default = true).
  /// Sin @relation cross-module: es UUID lógico.
  certificateTemplateId String? @map("certificate_template_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  publishedAt      DateTime?    @map("published_at")
  deletedAt        DateTime?    @map("deleted_at")

  modules ModCoursesModule[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([certificateTemplateId])
  @@map("mod_courses_course")
}

model ModCoursesModule {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  title       String
  description String?
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  course  ModCoursesCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons ModCoursesLesson[]

  @@unique([courseId, position])
  @@index([tenantId, courseId])
  @@map("mod_courses_module")
}

model ModCoursesLesson {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  moduleId        String     @map("module_id") @db.Uuid
  type            LessonType
  title           String
  position        Int
  /// Contenido por tipo: { videoUrl, html, pdfUrl, text, quizId } según LessonType
  content         Json       @default("{}")
  durationMinutes Int?       @map("duration_minutes")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  module ModCoursesModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position])
  @@index([tenantId, moduleId])
  @@map("mod_courses_lesson")
}

// ============================================================================
// mod.learning — Matriculación, progreso, finalización
// ============================================================================

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentSource {
  ADMIN
  CODE
  INVITATION_LINK
  PURCHASE
  IMPORT
}

model ModLearningEnrollment {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  /// ID lógico del curso (sin FK cross-module)
  courseId              String           @map("course_id") @db.Uuid
  status                EnrollmentStatus @default(ACTIVE)
  source                EnrollmentSource @default(ADMIN)
  completionThreshold   Int              @default(75) @map("completion_threshold")
  /// Porcentaje de finalización (0-100)
  progressPercent       Int              @default(0) @map("progress_percent")
  enrolledAt            DateTime         @default(now()) @map("enrolled_at")
  startedAt             DateTime?        @map("started_at")
  completedAt           DateTime?        @map("completed_at")
  cancelledAt           DateTime?        @map("cancelled_at")

  progress ModLearningProgress[]

  @@unique([tenantId, userId, courseId])
  @@index([tenantId, courseId, status])
  @@index([userId, status])
  @@map("mod_learning_enrollment")
}

model ModLearningProgress {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  enrollmentId      String                @map("enrollment_id") @db.Uuid
  /// ID lógico de la lección (sin FK cross-module)
  lessonId          String                @map("lesson_id") @db.Uuid
  /// Tiempo total visto/leído en segundos
  watchedSeconds    Int                   @default(0) @map("watched_seconds")
  /// Posición exacta para reanudación (segundo dentro del vídeo, scroll en HTML, etc.)
  resumePositionSec Int                   @default(0) @map("resume_position_sec")
  completed         Boolean               @default(false)
  firstAccessedAt   DateTime              @default(now()) @map("first_accessed_at")
  lastAccessedAt    DateTime              @updatedAt @map("last_accessed_at")
  completedAt       DateTime?             @map("completed_at")

  enrollment ModLearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([tenantId, lessonId])
  @@map("mod_learning_progress")
}

model ModLearningInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  courseId    String           @map("course_id") @db.Uuid
  /// Código corto para canje manual ("ABCD-1234")
  code        String
  /// Token de URL para enlace único compartible
  token       String           @unique
  /// Cantidad máxima de matriculaciones que puede crear esta invitación (null = ilimitado)
  maxUses     Int?             @map("max_uses")
  usedCount   Int              @default(0) @map("used_count")
  expiresAt   DateTime?        @map("expires_at")
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  revokedAt   DateTime?        @map("revoked_at")

  @@unique([tenantId, code])
  @@index([tenantId, courseId])
  @@map("mod_learning_invitation")
}

/// HU-FOR-002 — Paquete SCORM importado para una lección de tipo SCORM.
/// Sin FK cross-module: lessonId es UUID lógico de mod_courses_lesson.
/// El paquete se descomprime al subir y los assets se guardan en storage
/// bajo `scorm/{tenantId}/{packageId}/`. `entryPath` es la ruta relativa
/// dentro del paquete que sirve como entry del iframe (típicamente
/// "index.html" o lo que indique el imsmanifest.xml).
model ModLearningScormPackage {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  lessonId      String   @unique @map("lesson_id") @db.Uuid
  /// "1.2" | "2004" — derivado del schemaversion del manifest.
  version       String
  /// Path relativo al asset que se carga primero en el player.
  entryPath     String   @map("entry_path")
  /// Prefijo del storage donde están los assets (ej. "scorm/{tenantId}/{packageId}/").
  storagePrefix String   @map("storage_prefix")
  /// Manifest parseado (organizations, resources, items) para diagnóstico.
  manifest      Json     @default("{}")
  /// Tamaño total descomprimido en bytes.
  size          Int
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  uploadedById  String?  @map("uploaded_by_id") @db.Uuid

  @@index([tenantId])
  @@map("mod_learning_scorm_package")
}

// ============================================================================
// mod.certificates — Plantillas y emisión de certificados PDF
// ============================================================================

model ModCertificatesTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// Nombre legible: "Default", "VA360 oficial", etc.
  name          String
  /// Si true, esta plantilla se usa cuando no hay otra explícita asociada
  isDefault     Boolean  @default(false) @map("is_default")
  /// Texto del cuerpo. Soporta {{alumno}}, {{curso}}, {{fecha}}, {{numero}}
  body          String
  /// Color principal en hex (#RRGGBB) usado en bordes y títulos
  primaryColor  String   @default("#0f172a") @map("primary_color")
  /// URL absoluta del logo del tenant (opcional)
  logoUrl       String?  @map("logo_url")
  /// Nombre del firmante (queda en el PDF)
  signerName    String?  @map("signer_name")
  signerTitle   String?  @map("signer_title")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
  @@map("mod_certificates_template")
}

model ModCertificatesIssued {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  /// IDs lógicos sin FK cross-module
  courseId      String   @map("course_id") @db.Uuid
  enrollmentId  String   @map("enrollment_id") @db.Uuid
  templateId    String?  @map("template_id") @db.Uuid
  /// Número correlativo único por tenant
  number        String
  /// Hash SHA-256 del PDF generado (para verificación)
  hash          String
  /// Datos congelados al momento de emisión (alumno, curso, fecha, etc.)
  snapshot      Json     @default("{}")
  /// Path en el storage del PDF generado
  storageKey    String   @map("storage_key")
  /// Tamaño del PDF en bytes
  size          Int
  issuedAt      DateTime @default(now()) @map("issued_at")
  revokedAt     DateTime? @map("revoked_at")
  revokeReason  String?  @map("revoke_reason")

  @@unique([tenantId, number])
  @@unique([tenantId, enrollmentId])
  @@index([userId])
  @@index([courseId])
  @@map("mod_certificates_issued")
}

// ============================================================================
// mod.assessments — Quizzes con auto-corrección de tipos objetivos
// ============================================================================

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_BLANK
  SHORT_ANSWER
  LONG_ANSWER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  /// El alumno envió las respuestas pero el quiz tiene preguntas abiertas
  /// (SHORT_ANSWER / LONG_ANSWER) que requieren corrección manual del formador
  /// antes de poder declarar pasa/no pasa.
  PENDING_REVIEW
  /// Estado final tras corrección manual: scoreEarned/scorePercent/passed
  /// reflejan los puntos asignados por el formador.
  GRADED
  EXPIRED
  ABANDONED
}

model ModAssessmentsQuiz {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  /// ID lógico de la lección a la que pertenece el quiz (sin FK cross-module).
  /// Null mientras se redacta y aún no se ha asociado a ninguna lección.
  lessonId          String?    @map("lesson_id") @db.Uuid
  title             String
  description       String?
  status            QuizStatus @default(DRAFT)
  /// Umbral de aprobación en porcentaje (0-100). Default 60 %.
  passThreshold     Int        @default(60) @map("pass_threshold")
  /// Máximo de intentos por alumno (null = ilimitado).
  maxAttempts       Int?       @map("max_attempts")
  /// Límite de tiempo en minutos (null = sin límite).
  timeLimitMinutes  Int?       @map("time_limit_minutes")
  /// Si true, el orden de preguntas y opciones se barajará al iniciar el intento.
  shuffleQuestions  Boolean    @default(false) @map("shuffle_questions")
  /// Si true, al terminar el alumno ve la corrección por pregunta.
  showFeedback      Boolean    @default(true) @map("show_feedback")
  createdById       String?    @map("created_by_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  publishedAt       DateTime?  @map("published_at")
  deletedAt         DateTime?  @map("deleted_at")

  questions ModAssessmentsQuestion[]
  attempts  ModAssessmentsAttempt[]

  @@index([tenantId, status])
  @@index([tenantId, lessonId])
  @@map("mod_assessments_quiz")
}

model ModAssessmentsQuestion {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  quizId    String       @map("quiz_id") @db.Uuid
  type      QuestionType
  prompt    String
  /// Texto de feedback opcional que se muestra tras corregir.
  feedback  String?
  position  Int
  /// Puntos que vale la pregunta (default 1).
  points    Int          @default(1)
  /// Lista de respuestas aceptadas para FILL_IN_BLANK. Se compara
  /// case-insensitive y trimmed contra la respuesta del alumno. Vacío
  /// para todos los demás tipos.
  acceptedAnswers String[] @default([]) @map("accepted_answers")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  quiz    ModAssessmentsQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options ModAssessmentsOption[]

  @@unique([quizId, position])
  @@index([tenantId, quizId])
  @@map("mod_assessments_question")
}

model ModAssessmentsOption {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  label      String
  /// True si esta opción cuenta como respuesta correcta.
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question ModAssessmentsQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@index([tenantId, questionId])
  @@map("mod_assessments_option")
}

model ModAssessmentsAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  quizId        String        @map("quiz_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  /// IDs lógicos del contexto (sin FK cross-module): la matriculación y la lección
  /// desde las que el alumno está realizando el intento.
  enrollmentId  String?       @map("enrollment_id") @db.Uuid
  lessonId      String?       @map("lesson_id") @db.Uuid
  status        AttemptStatus @default(IN_PROGRESS)
  /// Snapshot inmutable del intento al enviarlo: puntos obtenidos, máximos, % y pasa/no pasa.
  scoreEarned   Int?          @map("score_earned")
  scoreMax      Int?          @map("score_max")
  scorePercent  Int?          @map("score_percent")
  passed        Boolean?
  startedAt     DateTime      @default(now()) @map("started_at")
  /// Vencimiento del intento si el quiz tenía time limit (start + timeLimit).
  expiresAt     DateTime?     @map("expires_at")
  submittedAt   DateTime?     @map("submitted_at")
  /// Quién (formador / tenant_admin) corrigió las respuestas abiertas y cuándo.
  /// Null mientras el attempt está en PENDING_REVIEW.
  gradedAt      DateTime?     @map("graded_at")
  gradedById    String?       @map("graded_by_id") @db.Uuid

  quiz    ModAssessmentsQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers ModAssessmentsAnswer[]

  @@index([tenantId, quizId, userId])
  @@index([userId, status])
  @@map("mod_assessments_attempt")
}

model ModAssessmentsAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  /// IDs de las opciones marcadas por el alumno (vacío si no respondió).
  /// Solo aplica a SINGLE_CHOICE / MULTIPLE_CHOICE / TRUE_FALSE.
  selectedOptionIds String[] @default([]) @map("selected_option_ids") @db.Uuid
  /// Texto que escribió el alumno. Aplica a FILL_IN_BLANK / SHORT_ANSWER /
  /// LONG_ANSWER.
  textAnswer        String?  @map("text_answer")
  /// Resultado del scoring (rellenado al submit). Para SHORT/LONG_ANSWER
  /// queda en false hasta la corrección manual.
  isCorrect         Boolean  @default(false) @map("is_correct")
  scoreEarned       Int      @default(0) @map("score_earned")
  /// Comentario opcional del formador al corregir (visible al alumno tras
  /// el GRADED).
  gradedFeedback    String?  @map("graded_feedback")
  createdAt         DateTime @default(now()) @map("created_at")

  attempt ModAssessmentsAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([tenantId, attemptId])
  @@map("mod_assessments_answer")
}

// ============================================================================
// MOD.THEMING — branding y personalización visual per-tenant.
// Un único registro por tenant. Override de tokens de design (hue/saturation),
// logo, favicon, fuentes y custom CSS sanitizado. Consumido en SSR por el
// layout root para inyectar variables CSS y propagar a todos los componentes.
// Ver docs/diseño/PANTALLAS-DOGFOODING.md §10 (mod.theming).
// ============================================================================
model ModThemingTenantTheme {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @unique @map("tenant_id") @db.Uuid

  /// URL pública (S3) del logo principal del tenant. Usado en header y emails.
  logoUrl             String?  @map("logo_url")
  /// URL del favicon (suele ser cuadrado, 32x32 o 512x512 para PWA).
  faviconUrl          String?  @map("favicon_url")

  /// Hue HSL del color primario (0-360). Default 213 (azul confianza Didacta).
  brandHue            Int      @default(213) @map("brand_hue")
  /// Saturation del color primario (0-100). Default 70.
  brandSaturation     Int      @default(70) @map("brand_saturation")

  /// Familia tipográfica display (titulares). Whitelist ['Sora','Inter','Manrope','Space Grotesk','DM Sans','Plus Jakarta Sans'].
  displayFontFamily   String   @default("Sora") @map("display_font_family")
  /// Familia tipográfica body. Whitelist ['Inter','Manrope','DM Sans','IBM Plex Sans','Source Sans 3','Plus Jakarta Sans'].
  bodyFontFamily      String   @default("Inter") @map("body_font_family")

  /// CSS adicional sanitizado (solo CSS variables y selectores seguros).
  /// Limitado a 16 KB. Se inyecta tras los tokens base.
  customCss           String?  @map("custom_css")

  /// HTML del footer custom (sanitizado). Solo etiquetas básicas: a, p, span, br.
  footerHtml          String?  @map("footer_html")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("mod_theming_tenant_theme")
}

// ============================================================================
// PASSWORD RESET TOKENS — flujo de "olvidé mi contraseña" para self-service.
// El token raw viaja solo en email; la DB guarda SHA-256 (no se puede recuperar
// el original aunque se filtre el dump). TTL 1h. Single-use (usedAt).
// ============================================================================
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  /// SHA-256 hex del token raw. El token raw solo se conoce en el momento de
  /// crearlo y se entrega por email — nunca se persiste en claro.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  /// Vencimiento absoluto (default +1h). Más allá se rechaza con un error
  /// específico para que la UI pida regenerar.
  expiresAt DateTime  @map("expires_at")
  /// Marca de uso (single-use). Al consumirse se invalida.
  usedAt    DateTime? @map("used_at")
  /// IP + UA al solicitar para audit log (si llega rate-limit / ataque).
  requestIp String?   @map("request_ip")
  requestUa String?   @map("request_ua")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}
