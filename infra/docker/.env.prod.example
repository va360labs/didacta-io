# ============================================================================
# .env de PRODUCCIÓN — aula.va360.academy  (server 135.181.150.202)
# ----------------------------------------------------------------------------
# Copia este archivo a /opt/didacta-prod/.env y rellena los valores CHANGE_ME.
# NUNCA se versiona el .env real (solo este .example). Los secrets los pone
# Valen: el agente NO escribe credenciales en el host (hard rail).
#
# Generar secrets:
#   AUTH_SECRET            → openssl rand -hex 32
#   TENANT_SETTINGS_ENC_KEY→ openssl rand -hex 32   (OBLIGATORIA en producción)
#   POSTGRES_PASSWORD      → openssl rand -hex 24
# ============================================================================

NODE_ENV=production

# ---------- PostgreSQL dedicado de prod (servicio `postgres` del compose) ----
POSTGRES_USER=didacta
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=didacta
# DATABASE_URL la arma docker-compose.prod.yml a partir de las 3 vars de arriba
# (apunta al servicio `postgres` en la red interna). No hace falta definirla aquí.

# ---------- Secrets de la app ----------
# Clave de firma de sesiones/JWT/tickets (Telegram). 32 bytes hex.
AUTH_SECRET=CHANGE_ME_auth_secret_openssl_rand_hex_32
# Clave maestra AES-256-GCM para settings cifrados per-tenant (SMTP, Zoom…).
# OBLIGATORIA en producción. Si se pierde, los settings cifrados son ilegibles.
TENANT_SETTINGS_ENC_KEY=CHANGE_ME_enc_key_openssl_rand_hex_32

# ---------- SMTP real de producción (emails de OTP / aprobación / bienvenida) ----
# Sin SMTP válido, los emails del flujo de inscripción no salen.
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=VA360 Academy <noreply@va360.academy>

# ---------- Inscripción de miembros (gate Telegram) ----------
# Bot de Telegram. Puede ser el mismo @va360access_bot que dev (recordá hacer
# /setdomain → aula.va360.academy en @BotFather) o uno dedicado de prod.
TELEGRAM_BOT_TOKEN=CHANGE_ME_telegram_bot_token
TELEGRAM_BOT_USERNAME=va360access_bot
TELEGRAM_GROUP_ID=CHANGE_ME_group_id
# Email del aprobador que recibe las solicitudes (1 click).
MEMBER_APPROVAL_EMAIL=valen@va360labs.com
MEMBER_PURGE_CRON=0 3 * * *
MEMBER_RETENTION_DAYS=90

# ---------- Bootstrap / seed del tenant de prod ----------
# Usados por `docker compose run --rm app seed`. Crean el tenant VA360, el
# super_admin y siembran el dominio aula.va360.academy (verificado) para que
# el login y la ruta pública de inscripción resuelvan por Host.
BOOTSTRAP_TENANT_SLUG=va360
BOOTSTRAP_TENANT_NAME=VA360 LABS
BOOTSTRAP_EMAIL=valen@va360labs.com
BOOTSTRAP_NAME=Valentín Ayesa
BOOTSTRAP_PASSWORD=CHANGE_ME_super_admin_password_min_12
BOOTSTRAP_DOMAINS=aula.va360.academy

# ---------- Opcionales (activar si se usan) ----------
# IA (tutor/grader/content)
ANTHROPIC_API_KEY=
# Zoom (aula virtual)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Stripe (billing / subscriptions) — si no se setean, esos módulos quedan en 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Versión de imagen/núcleo (informativa).
DIDACTA_CORE_VERSION=0.0.1-alpha.88
