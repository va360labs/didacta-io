# ============================================================================
# .npmrc — configuración de pnpm para Didacta Community
# ----------------------------------------------------------------------------
# `shamefully-hoist=true`: hace que pnpm hoiste TODAS las deps al
# `node_modules/` raíz (estilo npm/yarn flat), no solo las directas.
#
# Necesario en este monorepo porque algunos workspace packages (p.ej.
# `@didacta/license-sdk`) declaran `@nestjs/common` como peerDependency
# *opcional*. En dev pnpm hoistea agresivamente y todo funciona; con
# `pnpm install --prod` las peers opcionales no se instalan y los packages
# fallan con `MODULE_NOT_FOUND` al cargarse desde `apps/api`.
#
# Activar el hoist resuelve ese gap sin tener que añadir cada nestjs/* como
# `dependencies` duplicada en cada package. La contrapartida (deps fantasma
# accesibles que no declaras) es aceptable para una imagen de runtime.
# ============================================================================
shamefully-hoist=true
