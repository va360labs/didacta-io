# ============================================================================
# LearnShip — Variables de entorno (dev local)
# Copiá este archivo a .env (cp env.example .env) y ajustá los valores.
# El .env real no se sube al repo.
# ============================================================================

# ---------- Entorno ----------
NODE_ENV=development

# ---------- PostgreSQL ----------
POSTGRES_USER=learnship
POSTGRES_PASSWORD=learnship_dev
POSTGRES_DB=learnship
POSTGRES_PORT=5432
DATABASE_URL=postgresql://learnship:learnship_dev@localhost:5432/learnship

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- MinIO (S3-compatible local) ----------
MINIO_ROOT_USER=learnship
MINIO_ROOT_PASSWORD=learnship_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=learnship-dev
S3_ACCESS_KEY=learnship
S3_SECRET_KEY=learnship_dev

# ---------- MailPit (capturador de emails en dev) ----------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@learnship.local

# ---------- API ----------
API_PORT=4000
API_URL=http://localhost:4000

# ---------- Web ----------
WEB_PORT=3000
WEB_URL=http://localhost:3000

# ---------- Tenant Settings (encryption at-rest) ----------
# Clave maestra AES-256-GCM (32 bytes hex). Cifra los settings per-tenant
# marcados como secretos (SMTP, Zoom, etc.). Generala con:
#   openssl rand -hex 32
# Si la perdés, los settings cifrados son ilegibles. Backup obligatorio.
# En NODE_ENV=production es OBLIGATORIA; en dev podés dejarla vacía y se usa
# una clave determinística de fallback que NUNCA debe usarse en prod.
TENANT_SETTINGS_ENC_KEY=

# ---------- Anthropic (activar en Fase 1.C) ----------
ANTHROPIC_API_KEY=

# ---------- Zoom (activar en Fase 1.B) ----------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
