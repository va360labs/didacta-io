# ============================================================================
# LearnShip — Variables de entorno (dev local)
# Copiá este archivo a .env (cp env.example .env) y ajustá los valores.
# El .env real no se sube al repo.
# ============================================================================

# ---------- Entorno ----------
NODE_ENV=development

# ---------- PostgreSQL ----------
POSTGRES_USER=didacta
POSTGRES_PASSWORD=didacta_dev
POSTGRES_DB=didacta
POSTGRES_PORT=5432
DATABASE_URL=postgresql://didacta:didacta_dev@localhost:5432/didacta

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- Storage (driver: local | s3) ----------
# 'local' usa disco bajo STORAGE_ROOT (default ./data/storage). 's3' usa
# MinIO/S3-compatible con las S3_* de abajo. Si dejás esta var vacía y las
# S3_* están completas, se infiere 's3' automáticamente.
STORAGE_DRIVER=local

# ---------- MinIO (S3-compatible local) ----------
MINIO_ROOT_USER=didacta
MINIO_ROOT_PASSWORD=didacta_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=didacta-dev
S3_ACCESS_KEY=didacta
S3_SECRET_KEY=didacta_dev
# MinIO requiere true. AWS S3 nativo puede usar false para virtual-hosted-style.
S3_FORCE_PATH_STYLE=true
# TTL por defecto para presigned URLs en segundos (default 900 = 15 min)
S3_PRESIGNED_TTL_SECONDS=900

# ---------- MailPit (capturador de emails en dev) ----------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@didacta.local

# ---------- API ----------
API_PORT=4000
API_URL=http://localhost:4000

# ---------- Web ----------
WEB_PORT=3000
WEB_URL=http://localhost:3000

# ---------- Tenant Settings (encryption at-rest) ----------
# Clave maestra AES-256-GCM (32 bytes hex). Cifra los settings per-tenant
# marcados como secretos (SMTP, Zoom, etc.). Generala con:
#   openssl rand -hex 32
# Si la perdés, los settings cifrados son ilegibles. Backup obligatorio.
# En NODE_ENV=production es OBLIGATORIA; en dev podés dejarla vacía y se usa
# una clave determinística de fallback que NUNCA debe usarse en prod.
TENANT_SETTINGS_ENC_KEY=

# ---------- Anthropic (activar en Fase 1.C) ----------
ANTHROPIC_API_KEY=

# ---------- Zoom (mod.zoom-live) ----------
# Las credenciales S2S OAuth NO van por env: se configuran per-tenant en
# /admin/configuracion → "Aula virtual" (cifradas con TENANT_SETTINGS_ENC_KEY).
# Estas tres quedan como legacy/documentación — el código no las lee.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Secret Token del webhook de la app S2S de Zoom (Features → Event
# Subscriptions). REQUERIDO para que POST /api/v1/webhooks/zoom acepte
# eventos (started/ended/recording.completed); sin él responde 401.
ZOOM_WEBHOOK_SECRET=

# ---------- URLs públicas ----------
# URL base pública de la web (sin slash final). Se usa para construir enlaces
# absolutos en emails (p.ej. el enlace /clase/<id> de la confirmación de
# inscripción) y en el branding de correos. En prod: https://aula.va360.academy
WEB_PUBLIC_URL=

# ---------- Inscripción de miembros (gate Telegram → Didacta) ----------
# Bot de Telegram "VA360 Access" usado para verificar pertenencia al grupo.
# REQUERIDO para la feature. Sin él, /api/v1/inscripcion/telegram/verify -> 503.
TELEGRAM_BOT_TOKEN=
# ID numérico del grupo/supergrupo (incluye el prefijo -100... en supergrupos).
TELEGRAM_GROUP_ID=
# Email del aprobador que recibe las solicitudes (1 click). Nunca hardcodeado
# en código (regla #3). Ej: valen@va360labs.com
MEMBER_APPROVAL_EMAIL=
# (Opcional) Cron de la purga GDPR de inscripciones sin resolver. Default 03:00 UTC.
MEMBER_PURGE_CRON=0 3 * * *
# (Opcional) Días de retención antes de purgar PENDING/DEACTIVATED. Default 90.
MEMBER_RETENTION_DAYS=90
