# ============================================================================
# Didacta — variables para desarrollo local (apps nativas + infra Docker)
# ----------------------------------------------------------------------------
# Copia a .env:  cp .env.local.example .env   (o Copy-Item en PowerShell)
#
# First-time setup:
#   1. pnpm infra:up                               → levanta postgres + redis + mailpit
#   2. pnpm db:migrate                             → aplica migraciones + genera cliente
#   3. pnpm db:rls                                 → aplica políticas RLS (opcional dev)
#   4. pnpm dev                                    → api en :4000, web en :3000
#
# Coolify: subir solo cuando el usuario pida. Ver .github/workflows/dev-deploy.yml.
# ============================================================================

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# localhost (no el nombre del servicio Docker) porque las apps corren nativas
DATABASE_URL=postgresql://didacta:didacta_dev@localhost:5432/didacta?schema=public
REDIS_URL=redis://localhost:6379

# Cualquier string aleatorio de 32+ chars. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=dev-secret-change-this-to-any-random-32-chars-long!

# ─── Apps ────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Activa todas las capabilities Enterprise en local sin licencia real.
# JAMÁS poner true en producción.
DIDACTA_DEV_BYPASS=true

# ─── Email — Mailpit (UI: http://localhost:8025) ──────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Didacta Dev <noreply@didacta.local>

# ─── Storage S3 (opcional) ───────────────────────────────────────────────────
# Solo necesario si vas a probar uploads. Levantar MinIO aparte:
#   docker compose up minio minio-init -d
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=didacta-dev
# S3_ACCESS_KEY=didacta
# S3_SECRET_KEY=didacta_dev
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# ─── docker-compose.infra.yml (leídas por Docker, no por las apps) ───────────
POSTGRES_USER=didacta
POSTGRES_PASSWORD=didacta_dev
POSTGRES_DB=didacta
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
