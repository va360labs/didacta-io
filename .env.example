# ============================================================================
# Didacta Community — variables de entorno de ejemplo
# ----------------------------------------------------------------------------
# Copia este archivo a `.env` (`cp .env.example .env`) y rellena los valores.
# Las opciones marcadas como REQUIRED son imprescindibles para arrancar.
# Las marcadas como OPTIONAL tienen valores razonables por defecto.
# ============================================================================

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Conexión de ADMINISTRACIÓN (superuser/owner del cluster Postgres). El
# entrypoint la usa SOLO para aplicar migraciones + políticas RLS + grants —
# nunca para servir tráfico de la app (formato: postgresql://user:pass@host:port/db).
# Para docker-compose alpha local, usar:
#   ADMIN_DATABASE_URL=postgresql://didacta:didacta_dev@postgres:5432/didacta?schema=public
ADMIN_DATABASE_URL=

# Redis connection string. Para docker-compose:
#   REDIS_URL=redis://redis:6379
REDIS_URL=

# ─── RLS en runtime — aislamiento real entre tenants ─────────────────────────
# La app NUNCA conecta con ADMIN_DATABASE_URL: en su lugar, el entrypoint
# deriva automáticamente una DATABASE_URL de runtime que conecta como el rol
# `didacta_app` (NOSUPERUSER NOBYPASSRLS, creado por grants.sql) al mismo
# host/puerto/base que ADMIN_DATABASE_URL. Ese rol es el que hace que RLS
# aísle de verdad: una query sin contexto de tenant devuelve 0 filas.
#
# La contraseña de didacta_app es POSTGRES_APP_PASSWORD si la fijás abajo, o
# se autogenera y persiste en el volumen de datos (/app/data) la primera vez
# que arranca el contenedor — no hace falta que la sepas.
#
# Solo dejá DATABASE_URL vacía (el caso normal). Si la fijás explícitamente
# aquí, el entrypoint la respeta tal cual y NO deriva nada — usalo solo para
# apuntar a un usuario/BD distintos a propósito (y perdés el aislamiento RLS
# real si ese usuario no es didacta_app).
DATABASE_URL=

# POSTGRES_APP_PASSWORD: opcional. Fijala solo si querés controlar vos la
# contraseña del rol didacta_app (p.ej. desde tu secrets manager) en vez de
# dejar que el entrypoint la autogenere y persista en /app/data.
POSTGRES_APP_PASSWORD=

# off | warn | on (default). En warn/on, cada query con contexto de tenant
# viaja a Postgres con set_config('app.current_tenant_id') y las queries SIN
# contexto se loguean como huecos (warn: nivel warn; on: nivel error).
RLS_ENFORCEMENT=on

# Secret usado para firmar sesiones / cookies. Cualquier string aleatoria
# de 32+ caracteres vale. Opciones:
#   - Generador online de contraseñas (longitud 40+).
#   - Tu gestor de contraseñas (1Password, Bitwarden) → "Generar contraseña" 40 chars.
#   - openssl rand -base64 32
#   - node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Registro público (POST /auth/signup + página /signup). CERRADO por defecto:
# las altas reales entran por inscripción, API de inscripción o invitación de
# admin. Solo ponerlo a true en stacks de dev/E2E que fabrican usuarios de
# prueba por signup.
# AUTH_SIGNUP_ENABLED=true

NODE_ENV=production
API_PORT=4000
WEB_PORT=3000

# Clave AES-256 (hex 32 bytes) para cifrar secretos at-rest en DB.
#
# SOLO ES NECESARIA si vas a configurar alguna de estas features que cifran:
#   - SSO OIDC (clientSecret del IdP)
#   - SCIM admin token
#   - SMTP custom por tenant
#   - Stripe (mod.billing, mod.subscriptions) — clave secreta + webhook secret
#   - Zoom S2S secret
#
# Si la dejás vacía: Didacta genera una clave efímera al boot. OK para
# Community puro. Pero si LUEGO configuras una de esas features, los
# secretos cifrados SE PERDERÁN al reiniciar el contenedor.
#
# Setea esto ANTES de configurar esas features. Generar:
#   openssl rand -hex 32
# JAMÁS rotar sin plan de re-cifrado: perderías acceso a los secretos cifrados.
TENANT_SETTINGS_ENC_KEY=

# ─── License (Enterprise capabilities) ───────────────────────────────────────
# Si tienes una licencia Enterprise activa, pegarla aquí (JWT firmado por
# Didacta). Si no, déjalo vacío y arrancarás en modo Community.
DIDACTA_LICENSE_KEY=

# Solo desarrollo: bypass de licencia (todas las capabilities EE activas).
# JAMÁS poner true en producción.
DIDACTA_DEV_BYPASS=false

# ─── Telemetría anónima (latido diario) ──────────────────────────────────────
# Toda instalación envía un latido diario ANÓNIMO a registry.didacta.io para
# contar instalaciones vivas: id de instancia aleatorio + versión + edición +
# node/SO. Sin PII, sin datos de negocio, sin bloquear nada si no hay red.
# Detalle completo en README § Telemetría. Para desactivarlo:
# DIDACTA_TELEMETRY_DISABLED=true
#
# Endpoint alternativo del latido (tests, entornos corporativos):
# DIDACTA_TELEMETRY_URL=

# ─── Registro opt-in con Cloud god ───────────────────────────────────────────
# Nivel IDENTIFICADO y voluntario (email + organización a cambio de canal
# directo con el equipo). Distinto del latido anónimo de arriba. Cuando el
# receptor esté operativo, descomentar:
# DIDACTA_REGISTRY_URL=https://registry.didacta.io/registry

# ─── Storage S3-compatible (MinIO local en docker-compose) ───────────────────
# Para docker-compose alpha:
#   S3_ENDPOINT=http://minio:9000
#   S3_BUCKET=didacta-dev
#   S3_ACCESS_KEY=didacta
#   S3_SECRET_KEY=didacta_dev
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ─── Email (Mailpit local en docker-compose) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Didacta <noreply@didacta.local>

# ─── Observability ───────────────────────────────────────────────────────────
# Bearer token opcional para /metrics endpoint. Si está set, se exige.
METRICS_TOKEN=

# ─── Stripe (mod.billing) ────────────────────────────────────────────────────
# Si configuras ambos, mod.billing se activa y los endpoints
# /modules/billing/* funcionan. Si faltan, el módulo no arranca y los
# endpoints devuelven 503 (StripeConfigMissingError) — el resto de la app
# sigue operativa.
#
# Genera el webhook secret en https://dashboard.stripe.com/test/webhooks
# (endpoint: {API_URL}/api/v1/modules/billing/webhook). Eventos suscritos:
#   - checkout.session.completed
#   - checkout.session.expired
#   - checkout.session.async_payment_failed
#   - charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL base para success/cancel. Default: AUTH_URL/cursos. Sobreescribir si
# el web vive en otro dominio que el API.
BILLING_SUCCESS_URL_BASE=
BILLING_CANCEL_URL_BASE=

# ─── Stripe (mod.subscriptions — suscripciones recurrentes) ──────────────────
#
# mod.subscriptions reusa STRIPE_SECRET_KEY (un solo Stripe account por
# instancia). El webhook secret puede ser distinto al de mod.billing si
# configuras un endpoint dedicado en Stripe (recomendado para separar audit).
# Si SUBSCRIPTIONS_WEBHOOK_SECRET no está set, mod.subscriptions cae al
# STRIPE_WEBHOOK_SECRET de mod.billing.
#
# Endpoint en Stripe: {API_URL}/api/v1/modules/subscriptions/webhook
# Eventos suscritos:
#   - checkout.session.completed   (membresía /unete: alta del comprador)
#   - customer.subscription.created
#   - customer.subscription.updated
#   - customer.subscription.deleted
#   - invoice.paid
#   - invoice.payment_failed
SUBSCRIPTIONS_WEBHOOK_SECRET=
# URLs base para success/cancel del checkout (mode=subscription).
# Default: AUTH_URL/cuenta/suscripciones.
SUBSCRIPTIONS_SUCCESS_URL_BASE=
SUBSCRIPTIONS_CANCEL_URL_BASE=
# Días desde el primer fallo de cobro hasta marcar la sub como UNPAID
# (y pausar el enrollment). Default 3.
SUBSCRIPTIONS_GRACE_PERIOD_DAYS=3

# ─── Inscripción de miembros (verificadores componibles) ─────────────────────
# La config VIVE POR TENANT en /admin/configuracion (pestaña Registro):
# verificadores exigidos (Telegram y/u OTP por email, o registro libre), bot de
# Telegram (token cifrado at-rest) y email del aprobador. Estas variables son
# SOLO el fallback global legacy para despliegues mono-tenant ya configurados
# así; en instalaciones nuevas déjalas vacías y configura desde el panel.
# Sin bot (ni setting ni env) el verificador de Telegram queda inoperativo y,
# si un tenant lo exige, su flujo de inscripción responde 503 (fail-closed).
TELEGRAM_BOT_TOKEN=
# ID numérico del grupo/supergrupo (incluye el prefijo -100... en supergrupos).
TELEGRAM_GROUP_ID=
# Username del bot (sin @), para el Telegram Login Widget del formulario de
# inscripción. Sin él, el widget no se muestra (botUsername: null en config).
TELEGRAM_BOT_USERNAME=
# Fallback global del email del aprobador que recibe las solicitudes (1 click).
# Preferir el setting por tenant. Nunca hardcodeado en código (regla #3).
MEMBER_APPROVAL_EMAIL=
# OPTIONAL: cron de la purga GDPR (default 03:00 UTC) y días de retención (90).
MEMBER_PURGE_CRON=0 3 * * *
MEMBER_RETENTION_DAYS=90

# ─── docker-compose alpha (no usar en runtime de la app) ─────────────────────
# Estos solo los lee docker-compose.alpha.yml para configurar los contenedores.
POSTGRES_USER=didacta
POSTGRES_PASSWORD=didacta_dev
POSTGRES_DB=didacta
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=didacta
MINIO_ROOT_PASSWORD=didacta_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Tag de la imagen didactaio/community. Sin definir, el compose usa el tag
# recomendado de esta versión del repo. Descomenta solo para fijar otro.
# DIDACTA_IMAGE_TAG=0.0.1-alpha.95
