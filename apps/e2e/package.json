{
  "name": "@didacta/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Tests E2E con Playwright (golden path completo del alumno)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "scripts": {
    "test": "node -e \"console.log('e2e: skipped en CI principal — usar workflow e2e.yml o pnpm test:e2e')\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "install-browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf test-results playwright-report .turbo"
  },
  "dependencies": {
    "@playwright/test": "^1.49.0",
    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
