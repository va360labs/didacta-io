    "@didacta/mod-member-registration": "workspace:*",
    "@didacta/mod-messaging": "workspace:*",
    "@didacta/mod-payment-connections": "workspace:*",
    "@didacta/mod-referrals": "workspace:*",
    "@didacta/mod-resources": "workspace:*",
    "@didacta/mod-subscriptions": "workspace:*",
    "@didacta/mod-surveys": "workspace:*",
    "@didacta/mod-theming": "workspace:*",
