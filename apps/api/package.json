{
  "name": "@didacta/api",
  "version": "0.0.1-alpha.88",
  "private": true,
  "description": "Backend NestJS de Didacta",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:license": "node scripts/run-integration-license.mjs",
    "test:integration:license:run": "node ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "post-deploy:check": "ts-node --transpile-only scripts/post-deploy-check.ts",
    "clean": "rm -rf dist .turbo",
    "backfill:sanitize-html": "tsx scripts/backfill-sanitize-html.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@didacta/core-kernel": "workspace:*",
    "@didacta/core-registry": "workspace:*",
    "@didacta/database": "workspace:*",
    "@didacta/license-sdk": "workspace:*",
    "@didacta/mod-access-groups": "workspace:*",
    "@didacta/mod-ai-content": "workspace:*",
    "@didacta/mod-ai-grader": "workspace:*",
