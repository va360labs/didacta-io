      "deletedAt": null,
      "lessons": [
        {
          "id": "1d2e05a0-6e8e-41f5-aa2d-58e42086f03f",
          "tenantId": "cd06aee4-88cd-49be-be16-3b02c14cac1e",
          "moduleId": "3ce698f6-e54e-4f08-9073-bc10893761d7",
          "type": "HTML",
          "title": "Stacks y lenguajes de programación más comunes",
          "position": 11663,
          "content": {
            "html": "\n<div style=\"position:relative;padding-top:56.25%;\"><iframe src=\"https://iframe.mediadelivery.net/embed/376431/435d6ca9-bba2-4f0e-a0b6-5cd66e4e89d9?autoplay=false&#038;loop=false&#038;muted=false&#038;preload=true&#038;responsive=true\" loading=\"lazy\" style=\"border:0;position:absolute;top:0;height:100%;width:100%;\" allow=\"accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;\" allowfullscreen=\"true\"></iframe></div>\n\n\n\n<h2 class=\"wp-block-heading\">Prompt de la clase:</h2>\n\n\n\n<pre class=\"wp-block-preformatted\">Crea una aplicación en React que permita al usuario dibujar en una pizarra (canvas) como si fuera Paint, pudiendo<br>seleccionar diferentes colores y tamaños de pincel.<br><br><br>La aplicación debe usar una arquitectura hexagonal, aplicando los principios SOLID de forma clara.<br><br>El diseño debe ser muy elegante, profesional y moderno, utilizando Tailwind CSS como framework de estilos.<br><br><br>La estructura del proyecto debe estar bien organizada con:<br><br>core/ → lógica de dominio (entidades, casos de uso, interfaces)<br><br>adapters/ → implementación de entrada (UI React) y salida (almacenamiento, si aplica)<br><br>infrastructure/ → frameworks y detalles técnicos (canvas API, etc.)<br><br><br>El código debe estar separado en archivos, bien comentado y preparado para escalar.<br><br>Además, incluye:<br><br>Selector de color<br><br>Selector de grosor de línea<br><br>Botón para limpiar el lienzo<br><br>Responsive en dispositivos móviles</pre>\n\n\n\n<h2 class=\"wp-block-heading\">Presentación</h2>\n\n\n\n<div data-wp-interactive=\"core/file\" class=\"wp-block-file\"><object data-wp-bind--hidden=\"!state.hasPdfPreview\" hidden class=\"wp-block-file__embed\" data=\"https://va360.academy/wp-content/uploads/2025/08/Curso-de-VibeCoding.pdf\" type=\"application/pdf\" style=\"width:100%;height:600px\" aria-label=\"Incrustado de Curso de VibeCoding.\"></object><a id=\"wp-block-file--media-bf4b0c8e-2a93-4c89-8a2f-924c264ec681\" href=\"https://va360.academy/wp-content/uploads/2025/08/Curso-de-VibeCoding.pdf\">Curso de VibeCoding</a><a href=\"https://va360.academy/wp-content/uploads/2025/08/Curso-de-VibeCoding.pdf\" class=\"wp-block-file__button wp-element-button\" download aria-describedby=\"wp-block-file--media-bf4b0c8e-2a93-4c89-8a2f-924c264ec681\">Descarga</a></div>\n\n\n<p>[ld_kb_page id=&#8221;12202&#8243;]</p>\n"
          },
