        {
          "id": "3dfdcef0-50e0-4e08-9e98-d6e9a366b8e5",
          "tenantId": "cd06aee4-88cd-49be-be16-3b02c14cac1e",
          "moduleId": "25eaf537-0bdc-461d-96a3-5f57474767ed",
          "type": "HTML",
          "title": "Instalaciones recomendadas",
          "position": 5874,
          "content": {
            "html": "\n<p class=\"wp-block-paragraph\">Para este curso de iniciación al desarrollo de aplicaciones móviles con Flutter, recomiendo usar los siguientes componentes para que, ante todo, te familiarices con un entorno de programación profesional que podrás encontrar en cualquier empresa:</p>\n\n\n\n<ol class=\"wp-block-list\" start=\"1\">\n<li><a href=\"https://code.visualstudio.com/\">VSCode &#8211; Visual Studio Code</a></li>\n\n\n\n<li><a href=\"https://developer.android.com/studio\">Android Studio</a></li>\n\n\n\n<li><a href=\"https://docs.flutter.dev/get-started/install\">Flutter SDK</a></li>\n\n\n\n<li><a href=\"https://nodejs.org/en/\">NodeJS</a></li>\n</ol>\n\n\n\n<h2 class=\"wp-block-heading\"><a href=\"https://gist.github.com/Klerith/2917b2a21ea9c4bfa5d1070c89a89ec7#extensiones-de-vscode\"></a>Extensiones de VSCode</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Mi IDE favorito y probablemente el que más uso es <strong>Visual Studio Code</strong>. Por eso, te recomiendo las extensiones que yo utilizo en mi día a día para programar:</p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://marketplace.visualstudio.com/items?itemName=Gruntfuggly.activitusbar\">Activitus Bar</a></li>\n\n\n\n<li><a href=\"https://marketplace.visualstudio.com/items?itemName=usernamehw.errorlens\">Error Lens</a></li>\n\n\n\n<li><a href=\"https://marketplace.visualstudio.com/items?itemName=aaron-bond.better-comments\">Better Comments</a></li>\n\n\n\n<li><a href=\"https://marketplace.visualstudio.com/items?itemName=formulahendry.terminal\">Terminal</a></li>\n\n\n\n<li><a href=\"https://marketplace.visualstudio.com/items?itemName=Nash.awesome-flutter-snippets\">Awesome Flutter Snippets</a></li>\n\n\n\n<li><a href=\"https://marketplace.visualstudio.com/items?itemName=Dart-Code.dart-code\">Dart Language</a></li>\n\n\n\n<li><a href=\"https://marketplace.visualstudio.com/items?itemName=Dart-Code.flutter\">Flutter Support</a></li>\n\n\n\n<li><a href=\"https://marketplace.visualstudio.com/items?itemName=jeroen-meijer.pubspec-assist\">Pubspec Assist</a></li>\n</ul>\n"
          },
