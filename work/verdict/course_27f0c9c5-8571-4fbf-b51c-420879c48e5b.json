        {
          "id": "cd89ed4d-a5bb-465f-a746-ffd62d368960",
          "tenantId": "cd06aee4-88cd-49be-be16-3b02c14cac1e",
          "moduleId": "9547c34c-0d1c-4533-b16a-a76fc0b24cde",
          "type": "HTML",
          "title": "Clonamos la página de perfil de Instagram en FlutterFlow",
          "position": 5768,
          "content": {
            "html": "\n<p class=\"wp-block-paragraph\">Usamos FlutterFlow para crear la página de perfil de la aplicación Instagram. Como verás en el vídeo, poniendo un poco de ojo analítico podemos conseguir resultados profesionales, adaptables y muy similares a aplicaciones profesionales con millones de descargas.</p>\n\n\n\n<p class=\"wp-block-paragraph\">¡Quiero ver esos resultados en <a href=\"https://discord.gg/WpjhCuqjJj\" data-type=\"link\" data-id=\"https://discord.gg/WpjhCuqjJj\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Discord</strong></a>! Envía tus ejercicios al canal.</p>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-4-3 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<iframe title=\"CURSO INICIACIÓN FLUTTERFLOW - Clonamos la página de perfil de Instagram en FlutterFlow\" width=\"640\" height=\"360\" src=\"https://www.youtube.com/embed/4VJAEhLPDYA?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>\n</div></figure>\n"
          },
