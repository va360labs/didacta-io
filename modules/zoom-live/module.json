{
  "name": "zoom-live",
  "version": "0.4.0",
  "edition": "community",
  "coreVersionRequired": "^0.1.0",
  "displayName": "Aula virtual síncrona Zoom",
  "category": "live",
  "tablePrefix": "mod_zoom_live_",
  "permissions": ["zoom.session.read", "zoom.session.write"],
  "events": [
    {
      "name": "zoom.session.created"
    },
    {
      "name": "zoom.session.updated"
    },
    {
      "name": "zoom.session.cancelled"
    },
    {
      "name": "zoom.session.started"
    },
    {
      "name": "zoom.session.ended"
    },
    {
      "name": "zoom.session.recording_ready"
    },
    {
      "name": "zoom.session.registration.created"
    },
    {
      "name": "zoom.session.registration.cancelled"
    },
    {
      "name": "zoom.session.attendance_synced"
    }
  ],
  "apiNamespace": "/modules/zoom-live",
  "surfaces": ["admin", "formador"]
}
