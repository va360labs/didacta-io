{
  "name": "billing",
  "version": "1.0.0",
  "edition": "community",
  "coreVersionRequired": "^0.0.1",
  "displayName": "Stripe Checkout (pago único de cursos)",
  "category": "core",
  "tablePrefix": "mod_billing_",
  "permissions": [
    "billing.product.read",
    "billing.product.write",
    "billing.order.read",
    "billing.checkout.create"
  ],
  "events": [
    {
      "name": "billing.order.created"
