{
  "name": "certificates",
  "version": "1.0.0",
  "edition": "community",
  "coreVersionRequired": "^0.0.1",
  "displayName": "Plantillas y emisión PDF de certificados",
  "category": "core",
  "tablePrefix": "mod_certificates_",
  "permissions": [
    "certificates.template.read",
    "certificates.template.write",
