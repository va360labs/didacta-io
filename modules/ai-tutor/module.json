{
  "name": "ai-tutor",
  "version": "0.1.0",
  "edition": "community",
  "coreVersionRequired": "^0.1.0",
  "displayName": "Tutor conversacional con RAG",
  "category": "ai",
  "tablePrefix": "mod_ai_tutor_",
  "permissions": [
    "ai-tutor.chat.read",
    "ai-tutor.chat.write",
    "ai-tutor.index.write",
    "ai-tutor.config.write",
    "ai-tutor.review.read",
    "ai-tutor.review.write"
  ],
  "events": [
    {
      "name": "ai-tutor.course.indexed"
    },
    {
      "name": "ai-tutor.course.index-failed"
    },
    {
      "name": "ai-tutor.chat.message-sent"
    },
    {
      "name": "ai-tutor.chat.message-received"
    },
    {
      "name": "ai-tutor.answer.reviewed"
    },
    {
      "name": "ai-tutor.answer.corrected"
    }
  ],
  "hooks": [
    {
      "event": "courses.course.published"
    }
  ],
  "apiNamespace": "/modules/ai-tutor",
  "surfaces": ["alumno", "formador", "admin"]
}
