{
  "name": "community",
  "version": "0.1.0",
  "edition": "community",
  "coreVersionRequired": "^0.1.0",
  "displayName": "Comunidad — posts, hilos, reacciones, menciones",
  "category": "engagement",
  "tablePrefix": "mod_community_",
  "permissions": [
    "community.post.read",
    "community.post.write",
    "community.comment.read",
    "community.comment.write",
    "community.reaction.write"
  ],
  "events": [
    {
      "name": "community.post.created"
    },
    {
      "name": "community.comment.created"
    },
    {
      "name": "community.reaction.added"
    }
  ],
  "apiNamespace": "/modules/community",
  "surfaces": ["alumno", "formador", "admin"]
}
